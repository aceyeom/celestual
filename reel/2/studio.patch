@@ -0,0 +1,421 @@
+#!/usr/bin/env node
+// reel2-sounds.mjs: the second reel's sounds, effects only, for a song of
+// someone's own to be laid over them.
+//
+// Made against the second reel's clock (app/src/studio/parts/reel2-time.js)
+// from the same recordings and the same hall as the first reel's
+// (studio-sounds.mjs, whose parts this shares; scripts/sounds/NOTICE.md says
+// where each recording is from), and the phone's keys made here. Nothing
+// musical, nothing under the typing, all of it on B:
+//   0      the hook: a soft drum and a low gong, as the letter is there
+//   3.4    the wall waking: a bowed cymbal; each flick of the scroll a tick
+//          and a breath of cymbal drawn in to where it lands
+//  10.6    the heart pressed: the key and a soft drum, felt
+//  12.5    the thread comes up: a cymbal drawn in; sam's reply typed
+//  15      the cut to the dark: the drum and a darker gong; the guess
+//          typed, sent, and the phone going out drawn in to its point
+//  18.75   the week: the ocean drum, low, as the days go; noor's note, a
+//          soft drum; the two touch: a swell landing on the drum and the
+//          gong, and a bowed cymbal over the telling
+//  23.75   the wrong guess: almost nothing, and its light drawn in, reversed
+//  26.25   the wall again under a bowed cymbal; the name, a soft drum and a
+//          soft gong, left ringing
+//
+//   node scripts/reel2-sounds.mjs [out.wav]     48 kHz, 16 bit, stereo
+import { spawnSync } from 'node:child_process'
+import { writeFileSync, readFileSync, mkdirSync, rmSync, mkdtempSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { tmpdir } from 'node:os'
+import { fileURLToPath } from 'node:url'
