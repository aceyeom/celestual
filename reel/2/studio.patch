+.r2-cam { position: absolute; inset: 0; }
+
+/* the wall in WebGL, and the same frame drawn again along a flick */
+.r2-wall { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; z-index: 1; }
+.r2-wall.is-src { visibility: hidden; }
+/* a letter of the wall laid over with the product's own screen */
+.r2-over { position: absolute; left: 0; top: 0; width: 1000px; transform-origin: 0 0; z-index: 3; backface-visibility: hidden; }
+.r2-over.is-sam { z-index: 4; }
+
+/* what is drawn over the frame; the panel; the point a screen goes to */
+.r2-fx { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; z-index: 30; pointer-events: none; }
+.r2-panel { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; z-index: 0; }
+.r2-held { position: absolute; z-index: 5; transform-origin: 50% 50%; }
+.r2-dot {
+  position: absolute; width: 14px; height: 14px; z-index: 31; pointer-events: none;
+  background: #FFFFFF; box-shadow: 0 0 14px 5px rgba(205, 228, 255, 0.75), 0 0 40px 14px rgba(160, 200, 240, 0.3);
+}
+.r2-lock { position: absolute; z-index: 21; }
+
+/* under the words, over the picture */
+.r2-shade {
+  position: absolute; inset: 0; z-index: 39; pointer-events: none;
+  background: linear-gradient(180deg, rgba(0, 0, 0, 0.86) 0%, rgba(0, 0, 0, 0.8) 22%, rgba(0, 0, 0, 0.42) 32%, rgba(0, 0, 0, 0) 44%);
+}
+
+/* the thread under the letter: the phone's dark glass, its grip, and the
+   reply in the letter's colour */
+.r2-sheet {
+  position: absolute; z-index: 20; border-radius: 34px 34px 0 0;
+  background: linear-gradient(180deg, #16151C 0%, #0D0C12 60%);
+  box-shadow: 0 -1px 0 rgba(244, 241, 234, 0.12), 0 -30px 80px rgba(0, 0, 0, 0.6);
+}
+.r2-sheet .rl-line { z-index: 2; }
+.r2-grip { position: absolute; left: 50%; top: 14px; width: 64px; height: 6px; margin-left: -32px; border-radius: 3px; background: rgba(244, 241, 234, 0.22); }
+.r2-reply {
+  position: absolute; left: 32px; right: 32px; top: 96px; height: 150px; border-radius: 6px;
+  background: var(--r-lit);
+  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 0 40px color-mix(in srgb, var(--r-glow) 45%, transparent);
+}
+.r2-cur { position: absolute; top: 112px; width: 5px; height: 52px; }
+
+/* the dark gathered behind the last words, over the wall */
+.r2-hush {
+  position: absolute; inset: 0; z-index: 38; pointer-events: none;
+  background: radial-gradient(60% 22% at 50% 52%, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 55%, rgba(0, 0, 0, 0) 100%);
+}
diff --git a/app/src/studio/parts/reel2.jsx b/app/src/studio/parts/reel2.jsx
