+++ b/scripts/reel2-render.mjs
@@ -0,0 +1,85 @@
+#!/usr/bin/env node
+// reel2-render.mjs: the second reel, photographed in parallel and finished,
+// as studio-reel.mjs does the first: a few photographers at once
+// (studio-film.mjs `--frames`), each on its own run of the film at sixty
+// frames a second; the sounds (reel2-sounds.mjs) laid under them; and the
+// first reel's finish (studio-finish.mjs), the thirty mixed from the sixty.
+//
+// The hooks: the film is one, and only its first four seconds are told
+// another way (reel2-time.js `HOOKS`), so for each other hook only those
+// frames are photographed again, and the rest are the first cut's.
+//
+//   node scripts/reel2-render.mjs [--jobs 2] [--hooks a,b,c] [--keep] [--resume]
+//
+// Writes reel/2/celestual-reel-2.mp4, -b.mp4 and -c.mp4 (the thirty), and
+// reel/2/assets/sound.wav.
+import { spawn, spawnSync } from 'node:child_process'
+import { mkdirSync, rmSync, existsSync, readdirSync, symlinkSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { MS } from '../app/src/studio/parts/reel2-time.js'
+import { finish } from './studio-finish.mjs'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+const args = process.argv.slice(2)
+const opt = (k, d) => { const i = args.indexOf(`--${k}`); return i >= 0 ? args[i + 1] : d }
+const jobs = Number(opt('jobs', 2))
+const hooks = opt('hooks', 'a,b,c').split(',')
+const fps = 60
+const total = Math.round((MS / 1000) * fps)
+// the frames a hook changes: its words and their shade gone by four seconds
+const HOOK_FRAMES = Math.round(4.0 * fps)
+const outDir = process.env.OUT || join(root, 'reel/2')
+const scratch = process.env.FRAMES || join(root, '.studio-frames', 'celestual-reel-2')
+const wav = join(outDir, 'assets/sound.wav')
+
+const run = (cmd, a) => new Promise((ok, no) => {
+  const p = spawn(cmd, a, { stdio: ['ignore', 'pipe', 'inherit'], cwd: root })
+  p.stdout.on('data', (d) => process.stdout.write(String(d)))
+  p.on('close', (c) => (c === 0 ? ok() : no(new Error(`${cmd} ${c}`))))
+})
+
+// photograph frames [a, z] of a film into `dir`, shared among the jobs, a
+// share already whole not taken again
+async function shoot(id, dir, a, z) {
+  mkdirSync(dir, { recursive: true })
+  const have = new Set(readdirSync(dir))
+  const n = z - a + 1
+  const shares = []
+  for (let k = 0; k < jobs; k++) {
+    const s0 = a + Math.floor((k * n) / jobs)
+    const s1 = a + Math.floor(((k + 1) * n) / jobs) - 1
+    let todo = s0
+    while (todo <= s1 && have.has(`f${String(todo).padStart(5, '0')}.jpg`)) todo++
+    if (todo <= s1) shares.push([todo, s1])
+  }
+  console.log(`${id}: frames ${a} to ${z} in ${shares.length} shares`)
+  await Promise.all(shares.map(([s0, s1], k) => new Promise((r) => setTimeout(r, k * 6000))
+    .then(() => run('node', ['scripts/studio-film.mjs', id, '--fps', String(fps), '--frames', dir, '--first', String(s0), '--last', String(s1)]))))
+}
+
+mkdirSync(join(outDir, 'assets'), { recursive: true })
+await run('node', ['scripts/reel2-sounds.mjs', wav])
+if (!args.includes('--resume') && existsSync(scratch)) rmSync(scratch, { recursive: true })
+const main = join(scratch, 'a')
+await shoot('celestual-reel-2', main, 0, total - 1)
+
+const enc = ['-c:v', 'libx264', '-preset', 'slow', '-tune', 'film', '-pix_fmt', 'yuv420p', '-profile:v', 'high', '-c:a', 'aac', '-b:a', '256k', '-shortest', '-movflags', '+faststart']
+function encode(dir, file) {
+  const graph = finish({ fps: 30, s: total / fps, pre: 'tmix=frames=2,select=mod(n\\,2),setpts=N/(30*TB),' })
+  const r = spawnSync('ffmpeg', ['-v', 'error', '-y', '-framerate', String(fps), '-i', join(dir, 'f%05d.jpg'), '-i', wav, '-filter_complex', graph, '-map', '[v]', '-map', '1:a', '-r', '30', '-crf', '20', '-maxrate', '16M', '-bufsize', '32M', ...enc, file], { stdio: 'inherit' })
+  if (r.status !== 0) throw new Error(`ffmpeg ${file}`)
+  console.log(file.replace(`${root}/`, ''))
+}
+if (hooks.includes('a')) encode(main, join(outDir, 'celestual-reel-2.mp4'))
+for (const h of hooks.filter((x) => x !== 'a')) {
+  const dir = join(scratch, h)
+  await shoot(`celestual-reel-2-${h}`, dir, 0, HOOK_FRAMES - 1)
+  // the rest of the film is the first cut's own frames
+  for (let i = HOOK_FRAMES; i < total; i++) {
+    const f = `f${String(i).padStart(5, '0')}.jpg`
+    if (!existsSync(join(dir, f))) symlinkSync(join(main, f), join(dir, f))
+  }
+  encode(dir, join(outDir, `celestual-reel-2-${h}.mp4`))
+}
+if (!args.includes('--keep')) rmSync(scratch, { recursive: true })
