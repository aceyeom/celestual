@@ -0,0 +1,726 @@
+// ── the second reel: you might be on here ───────────────────────────────────
+//
+// Thirty seconds on the first reel's beat (reel2-time.js), drawn from `t`
+// and nothing else, in the first reel's world and finish: the words cut
+// into the phone's own cells (reel.jsx `CellLine`), the wall of letters in
+// WebGL (wall-gl.js) with the product's own screens laid over the ones the
+// camera lands on, and the dark a screen's panel of cells lit by what is on
+// it. The first reel is told by the one who writes; this one by the one
+// written to.
+//
+//   0      sam's letter, held to us, already whole: `you sit by the window
+//          in the 9am...`. `you might be on here / and not know it.`
+//   3.75   the scroll: up the wall a letter at a time, each flick landing a
+//          little past and settling, the backlights waking as it goes.
+//          `letters to people / who don't know yet.` and down again to sam's
+//   8.75   held on sam's letter. `nobody knows / who wrote it.` the heart
+//          pressed, and filled
+//  12.5    the letter steps up and the thread comes up under it: sam's
+//          reply typed, lit in the letter's colour and marked `recipient`.
+//          `you can write back, / and they'll know it / reached you.`
+//  15      the composer, to a guess: `it was you, wasn't it.` `think you
+//          know / who wrote it?` `tell them / privately.` sent: the phone
+//          goes out behind its envelope
+//  18.75   the week along the foot of the panel; on the thursday a note
+//          comes in from the other side; at nine on the saturday the two
+//          find each other, and the phone tells it. `if you're right, / and
+//          they sent one too,` `you both find out.`
+//  23.75   the guess that was wrong, alone, out to a line and a point. `if
+//          you're wrong, / nobody ever knows / you guessed.`
+//  26.25   the wall, far, waking. `read the wall.` the name lit a cell at a
+//          time from its star, and the address
+
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react'
+import gsap from 'gsap'
+import { CustomEase } from 'gsap/CustomEase'
+import { Board, Phone, PixelStory, useHold, hexRgb, mix, Lockup, LOCKUP, MARK, filmOf, readyFilm, skinOf } from '../kit.jsx'
+import { cellsOf, wordCells } from '../../wall/brand.js'
+import { typeCells } from '../../wall/pixtype.js'
+import { CellLine, drawEnvelope, drawDot, crtOn, crtOff, at, easeOf, on, shake, tone, X0, Y0, C } from './reel.jsx'
+import { MS, S, SAM, REPLY, GUESS, NOOR, HOOKS, typedReply, typedGuess, typedUrl, URL } from './reel2-time.js'
+import { WallGL, wallOf, cameraOf, boxOnto, v3, UNIT } from './wall-gl.js'
+import { ATLAS, LETTERS, cellOf, cellTint, heartsOf } from './wall-letters.js'
+import { NoteScreen, PW } from './note-screen.jsx'
+import atlasUrl from '../assets/wall-atlas.jpg'
+import './reel2.css'
+
+export { MS }
+
+gsap.registerPlugin(CustomEase)
+// a thumb's flick: away fast, a little past, and back
+CustomEase.create('r2.flick', 'M0,0 C0.1,0.55 0.2,1.07 0.42,1.035 0.62,1.005 0.8,0.998 1,1')
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+const u = (t, a, b) => clamp((t - a) / (b - a))
+const lerp = (a, b, k) => a + (b - a) * k
+const smooth01 = (k) => k * k * (3 - 2 * k)
+const rnd = (n) => ((Math.sin(n * 127.1 + 311.7) * 43758.5453) % 1 + 1) % 1
+const CHALK = '#F4F1EA'
+
+// ── the grid ────────────────────────────────────────────────────────────────
+// the first reel's: its margin, its line, and the panel's cells on it
+const LINE = 16 * C
+const Y1 = Y0 + LINE
+const Y2 = Y1 + LINE
+const GX = X0 % C
+const GY = Y0 % C
+const RIGHT = 1000
+// the objects: a phone, this wide, its middle here
+const OBJ = { x: 540, y: 1090, w: 640 }
+// a letter on the wall is its atlas cell's shape
+const BOX = { w: PW, h: (PW * ATLAS.h) / ATLAS.w }
+
+// ── the words, scene by scene ───────────────────────────────────────────────
+const WORDS = {
+  scroll: [
+    { text: 'letters to people', from: S.sLines[0], to: S.sOut },
+    { text: 'who don’t know yet.', from: S.sLines[1], to: S.sOut + 40, y: Y1 },
+  ],
+  heart: [
+    { text: 'nobody knows', from: S.kLines[0], to: S.kOut },
+    { text: 'who wrote it.', from: S.kLines[1], to: S.kOut + 40, y: Y1 },
+  ],
+  reply: [
+    { text: 'you can write back,', from: S.rLines[0], to: S.rOut },
+    { text: 'and they’ll know it', from: S.rLines[1], to: S.rOut + 40, y: Y1 },
+    { text: 'reached you.', from: S.rLines[1] + 380, to: S.rOut + 80, y: Y2 },
+  ],
+  guess: [
+    { text: 'think you know', from: S.gLines[0], to: S.gLines[1] - 260 },
+    { text: 'who wrote it?', from: S.gLines[0] + 313, to: S.gLines[1] - 220, y: Y1 },
+    { text: 'tell them', from: S.gLines[1], to: S.gOut },
+    { text: 'privately.', from: S.gLines[1] + 313, to: S.gOut + 40, y: Y1, c: 2 * C },
+  ],
+  week: [
+    { text: 'if you’re right,', from: S.wLines[0], to: S.touch[0] - 120 },
+    { text: 'and they sent one too', from: S.wLines[1], to: S.touch[0] - 80, y: Y1 },
+    { text: 'you both', from: S.both, to: S.wOut, x: 540, align: 'center' },
+    { text: 'find out.', from: S.both + 160, to: S.wOut + 40, x: 540, y: Y1, c: 2 * C, align: 'center' },
+  ],
+  wrong: [
+    { text: 'if you’re wrong,', from: S.fLines[0], to: S.fOut, x: RIGHT, align: 'right' },
+    { text: 'nobody ever knows', from: S.fLines[1], to: S.fOut + 40, x: RIGHT, y: Y1, align: 'right' },
+    { text: 'you guessed.', from: S.fLines[2], to: S.fOut + 80, x: RIGHT, y: Y2, align: 'right' },
+  ],
+  end: [
+    { text: 'read', from: S.eLine, to: S.eOut, x: 540, y: GY + 112 * C, c: 2 * C, align: 'center' },
+    { text: 'the wall.', from: S.eLine + 313, to: S.eOut + 40, x: 540, y: GY + 138 * C, c: 2 * C, align: 'center' },
+  ],
+}
+const hookWords = (hook) => (HOOKS[hook] ? [
+  { text: HOOKS[hook][0], from: S.hLines[0], to: S.hOut },
+  { text: HOOKS[hook][1], from: S.hLines[1], to: S.hOut + 40, y: Y1 },
+] : [])
+const Words = ({ t, of }) => of.map((l) => <CellLine key={l.text} t={t} {...l} />)
+// the dark kept under a band of words at the top, where the picture is busy
+const Shade = ({ o }) => (o > 0.003 ? <div className="r2-shade" style={{ opacity: o.toFixed(3) }} /> : null)
+const upOf = (of, t) => (of.length ? Math.max(...of.map((l) => u(t, l.from - 150, l.from + 200) * (1 - u(t, l.to + 150, l.to + 500)))) : 0)
+
+// ── the wall ────────────────────────────────────────────────────────────────
+// the letters the scroll lands on, pinned where it lands, and laid over
+// with the product's own screen as it settles; and sam's in the middle,
+// in a rose letter's cell of the sheet, so a frame too quick to read shows
+// a rose letter there and never another's
+const PINS = { '0,2': cellOf('theo'), '-1,5': cellOf('maya'), '1,8': cellOf('jules'), '-1,-1': cellOf('mei'), '1,1': cellOf('tomas') }
+const HOME_CELL = cellOf('charlie')
+const PAPER = new Set(['teal', 'acid', 'violet-yellow', 'xerox'])
+// the scroll: where the camera is aimed, letter by letter
+const focalOf = (fov) => 960 / Math.tan((fov * Math.PI) / 360)
+const FOV = 34
+const F = focalOf(FOV)
+// how far from a letter the camera stands so it is `w` wide on the frame
+const distFor = (w) => (F * UNIT.w) / w
+
+// The camera at `t`, before the hand: a letter (by its place on the wall)
+// it is on, how near, and where on the frame that letter sits
+function shotAt(t, find) {
+  const stops = S.stops
+  // which flick it is in, and how far through
+  let k = 0
+  while (k + 1 < stops.length && t >= stops[k + 1][0]) k++
+  const [t0, from] = stops[k]
+  const next = stops[k + 1]
+  let p = find(from)
+  let speed = 0
+  if (k > 0) {
+    const [, prev] = stops[k - 1]
+    const e = easeOf('r2.flick')(u(t, t0, t0 + 520))
+    const a = find(prev)
+    p = v3.lerp(a, find(from), e)
+    speed = Math.abs(easeOf('r2.flick')(u(t + 8, t0, t0 + 520)) - easeOf('r2.flick')(u(t - 8, t0, t0 + 520))) * Math.hypot(...v3.sub(find(from), a))
+  }
+  void next
+  // how near: sam's letter the objects' width; in the scroll, a step back so
+  // the letters round it are in the frame; the reply's step back again
+  const wide = smooth01(u(t, S.scroll[0], S.scroll[0] + 300)) * (1 - smooth01(u(t, S.stops[4][0], S.stops[4][0] + 900)))
+  const push = 1 + 0.035 * easeOf('sine.inOut')(u(t, 0, S.scroll[0])) + 0.03 * easeOf('sine.inOut')(u(t, S.heart[0], S.reply[0]))
+  const rise = easeOf('power3.inOut')(u(t, S.rise[0], S.rise[1]))
+  const w = (OBJ.w * push * lerp(1, 0.66, wide)) * lerp(1, 0.66, rise)
+  const y = lerp(OBJ.y, 812, rise)
+  return { p, w, y, speed }
+}
+function camAt(t, find) {
+  const s = shotAt(t, find)
+  const d = distFor(s.w)
+  // aimed a little over the letter, so it sits at `y` on the frame
+  const off = ((s.y - 960) / F) * d
+  const target = [s.p[0], s.p[1] + off, s.p[2]]
+  let eye = [s.p[0], s.p[1] + off, s.p[2] + d]
+  const hand = 0.0035 * d
+  eye = v3.add(eye, [shake(t, 1) * hand, shake(t, 7) * hand, 0])
+  return { cam: cameraOf({ eye, target, roll: shake(t, 11) * 0.004, fov: FOV }), d, speed: s.speed, w: s.w }
+}
+
+// The wall's light: in the hook only the near letters, low, sam's the one
+// lit; from the scroll every backlight waking outward from sam's; down
+// again as the heart is pressed and the thread comes up
+function lightOf(l, t) {
+  if (t >= S.end[0]) {
+    const k = on(t, S.end[0] + 120 + l.dist * 55 + l.seed * 260, 220)
+    return k * (0.25 + 0.35 * l.seed) * (1 - easeOf('sine.inOut')(u(t, S.eOut - 150, S.eOut + 450)))
+  }
+  const near = Math.exp(-l.dist / 2.2)
+  const hook = 0.24 * near * (0.6 + 0.4 * l.seed) * (1 - 0.5 * easeOf('sine.inOut')(u(t, S.heart[0] + 400, S.press)))
+  const wake = on(t, S.scroll[0] - 330 + l.dist * 40 + l.seed * 150, 160) * (0.5 + 0.5 * l.seed)
+  const down = 1 - 0.7 * easeOf('sine.inOut')(u(t, S.heart[0] + 400, S.press))
+  return Math.max(hook, wake * down) * (1 - 0.6 * easeOf('sine.inOut')(u(t, S.reply[0], S.rise[1])))
+}
+
+// a letter of the wall laid over with the product's screen, as the atlas
+// photographed it, at the size the frame shows it
+function LetterOver({ q, name, text, tint, seed, hearts, replies, top, keys, o = 1, filter }) {
+  if (!q || o <= 0.003) return null
+  return (
+    <div className="r2-over" style={{ transform: boxOnto(BOX.w, BOX.h, q), opacity: o < 1 ? o.toFixed(3) : undefined, filter }}>
+      <Phone w={PW} tint={tint} seed={seed} mode="letter" square name={name} stamp={top?.stamp || '10/06/26'} hearts={hearts} replies={replies} text={text} cursor={false} keys={keys} quiet={false} />
+    </div>
+  )
+}
+
+// the heart's key: sam's press, a light under the thumb, and the heart
+// filled from its foot, a row at a time, with a few of its pixels lifting
+function drawPress(g, t, r) {
+  if (!r || t < S.press - 200) return
+  const cx = r.x + r.w / 2
+  const cy = r.y + r.h / 2
+  // the light under the thumb, coming and going with it
+  const p = at([[S.press - 160, 0], [S.press, 1, 'power2.out'], [S.press + 260, 0.55], [S.press + 1600, 0, 'sine.inOut']], t)
+  if (p > 0.003) {
+    const R = r.h * 4.2
+    const grad = g.createRadialGradient(cx, cy, 0, cx, cy, R)
+    grad.addColorStop(0, tone(skinOf(SAM.tint).glow, 0.55 * p))
+    grad.addColorStop(0.35, tone(skinOf(SAM.tint).glow, 0.16 * p))
+    grad.addColorStop(1, 'rgba(0,0,0,0)')
+    g.fillStyle = grad
+    g.fillRect(cx - R, cy - R, R * 2, R * 2)
+  }
+  // a few of the heart's pixels lifting off it and going out, as a screen's
+  // pixels go
+  const cell = r.h / 6
+  for (let n = 0; n < 9; n++) {
+    const t0 = S.press + 40 + n * 26
+    const k = u(t, t0, t0 + 900 + rnd(n) * 300)
+    if (k <= 0 || k >= 1) continue
+    const ang = -Math.PI / 2 + (rnd(n * 3 + 1) - 0.5) * 1.6
+    const dist = easeOf('power2.out')(k) * cell * (5 + rnd(n * 5 + 2) * 7)
+    const x = cx + Math.cos(ang) * dist
+    const y = cy + Math.sin(ang) * dist
+    const s = cell * (1 - 0.5 * k)
+    g.globalAlpha = (1 - k) ** 1.4
+    g.fillStyle = mix(skinOf(SAM.tint).lit, '#FFFFFF', 0.5)
+    g.fillRect(x - s / 2, y - s / 2, s, s)
+  }
+  g.globalAlpha = 1
+}
+
+// the thread, come up under the letter: a sheet of the phone's own dark
+// glass, its grip, and sam's reply lit in the letter's colour and marked as
+// the one it was to
+const SHEET = { x: 540 - 330, y: 1150, w: 660, h: 420 }
+const REPLY_TIMES = typedReply()
+function Sheet({ t }) {
+  const k = easeOf('power3.out')(u(t, S.rise[0] + 120, S.rise[1] + 200))
+  const out = easeOf('power2.in')(u(t, S.rOut + 100, S.reply[1]))
+  if (k <= 0) return null
+  const y = lerp(1920, SHEET.y, k) + out * 40
+  const lit = skinOf(SAM.tint)
+  const n = REPLY_TIMES.filter((x) => x <= t).length
+  const cur = t >= S.typed - 300 && Math.floor((t - (n ? REPLY_TIMES[n - 1] : S.typed)) / 530) % 2 === 0
+  return (
+    <div className="r2-sheet" style={{ left: SHEET.x, top: y, width: SHEET.w, height: SHEET.h, opacity: (1 - out).toFixed(3) }}>
+      <span className="r2-grip" />
+      <CellLine t={t} text="replies" from={S.rise[0] + 300} x={36} y={34} c={4} color="#9C978E" />
+      <div className="r2-reply" style={{ '--r-lit': lit.mid, '--r-glow': lit.glow, opacity: on(t, S.typed - 180, 140).toFixed(3) }}>
+        <CellLine t={t} text="recipient" from={S.typed - 150} x={28} y={20} c={3} color={lit.ink} />
+        <CellLine t={t} text={REPLY} times={REPLY_TIMES} unit="char" x={28} y={62} c={4} color={lit.ink} />
+        {cur && n < REPLY.length + 1 ? <span className="r2-cur" style={{ left: 28 + 14 + typeCells(REPLY.slice(0, n)).w * 4 + 4, background: lit.ink }} /> : null}
+      </div>
+    </div>
+  )
+}
+
+let ATLAS_IMG = null
+function WallScene({ t }) {
+  const glc = useRef(null)
+  const blur = useRef(null)
+  const fx = useRef(null)
+  const sam = useRef(null)
+  const gl = useRef(null)
+  const [heartBox, setHeartBox] = useState(null)
+  const letters = useMemo(() => {
+    const ls = wallOf((cell) => hexRgb(skinOf(cellTint(cell)).glow).map((x) => (x / 255) * (PAPER.has(cellTint(cell)) ? 0.45 : 1)), PINS)
+    const home = ls.find((l) => l.home)
+    home.cell = HOME_CELL
+    home.halo = hexRgb(skinOf(SAM.tint).glow).map((x) => x / 255)
+    return ls
+  }, [])
+  const byIJ = useMemo(() => new Map(letters.map((l) => [`${l.i},${l.j}`, l])), [letters])
+  const find = (ij) => byIJ.get(`${ij[0]},${ij[1]}`).pos
+  const lit = useMemo(() => new Float32Array(letters.length), [letters])
+  const glow = useMemo(() => new Float32Array(letters.length), [letters])
+  const end = t >= S.end[0]
+  // the end's wide: the hall from across it, drifting up
+  const view = end
+    ? (() => {
+      const k = u(t, S.end[0], S.eOut)
+      const eye = [0.4 + shake(t, 3) * 0.02, lerp(-1, 1.4, k), 19]
+      return { cam: cameraOf({ eye, target: [0, lerp(1.6, 3.2, k), 0], roll: shake(t, 9) * 0.004, fov: 50 }), d: 19, speed: 0 }
+    })()
+    : camAt(t, find)
+  const { cam, d, speed } = view
+  for (let n = 0; n < letters.length; n++) {
+    const l = letters[n]
+    if (l.dead) { lit[n] = 0; glow[n] = 0; continue }
+    lit[n] = l.home && !end ? 1 : lightOf(l, t)
+    glow[n] = l.home && !end ? 0.45 * (1 - 0.5 * u(t, S.reply[0], S.rise[1])) : lit[n] * 0.3
+  }
+  // the focus: on the letter it is aimed at, shallow in the hook so the
+  // letters round sam's are only light; deeper in the scroll
+  const scroll = smooth01(u(t, S.scroll[0], S.scroll[0] + 400)) * (1 - smooth01(u(t, S.stops[4][0] + 300, S.heart[0] + 300)))
+  const aperture = end ? 2.4 : lerp(2.6, 1.15, scroll)
+  useLayoutEffect(() => {
+    if (!glc.current || !ATLAS_IMG) return
+    if (!gl.current) gl.current = new WallGL(glc.current, ATLAS_IMG, letters)
+    gl.current.draw(cam, lit, glow, { focus: end ? 7 : d, aperture, fogStart: 20, fog: 0.04, spread: 2.1, time: t / 1000, dust: end ? 0.4 : 0.25 + 0.25 * scroll, bokeh: 0.016 })
+    // a flick seen as a shutter sees it: the frame drawn again along the way
+    // it moves, fainter each time
+    const b = blur.current.getContext('2d')
+    b.globalAlpha = 1
+    b.globalCompositeOperation = 'source-over'
+    b.drawImage(glc.current, 0, 0)
+    const px = (speed * F) / d
+    if (px > 2) {
+      const span = Math.min(240, px * 6)
+      const N = 24
+      b.globalAlpha = 1.5 / N
+      for (let i = 1; i < N; i++) b.drawImage(glc.current, 0, ((i / (N - 1)) - 0.5) * span)
+      b.globalAlpha = 1
+    }
+  })
+  // the letters it lands on, and sam's, where the wall's camera has them
+  const quadOf = (l) => {
+    const c = [l.pos, l.right, l.up]
+    const pts = [[-1, 1], [1, 1], [1, -1], [-1, -1]].map(([x, y]) => cam.project(v3.add(c[0], v3.add(v3.scale(c[1], x), v3.scale(c[2], y * (BOX.h / BOX.w) / UNIT.h)))))
+    return pts.every(Boolean) ? pts : null
+  }
+  const still = 1 - smooth01(clamp((((speed * F) / d) - 1.5) / 6))
+  const pinned = Object.entries(PINS).map(([ij, cell]) => {
+    const l = byIJ.get(ij)
+    const [name, text] = LETTERS[cell - 1]
+    return { l, name, text, tint: cellTint(cell), cell }
+  })
+  const pressed = t >= S.press
+  const samKeys = { l: { label: 'options' }, r: [{ glyph: pressed ? 'heart' : 'heartO', label: pressed ? '1' : '0', cls: 'is-heart' }, { glyph: 'bubbleO', label: t >= S.typed + 1200 ? '1' : '0', cls: 'is-thread' }] }
+  // where the heart's key is on the frame, read off the phone once it is on
+  useLayoutEffect(() => {
+    if (!sam.current || t < S.heart[0] || t > S.reply[0]) return
+    const k = sam.current.querySelector('.is-heart')
+    const b0 = sam.current.closest('.st-board')
+    if (!k || !b0) return
+    const r = k.getBoundingClientRect()
+    const o = b0.getBoundingClientRect()
+    const box = { x: r.left - o.left, y: r.top - o.top, w: r.width, h: r.height }
+    if (!heartBox || Math.abs(box.x - heartBox.x) > 0.5 || Math.abs(box.y - heartBox.y) > 0.5) setHeartBox(box)
+  }, [t, heartBox])
+  useLayoutEffect(() => {
+    const g = fx.current.getContext('2d')
+    g.clearRect(0, 0, 1080, 1920)
+    if (t >= S.heart[0] && t < S.reply[0]) drawPress(g, t, heartBox)
+  })
+  const home = byIJ.get('0,0')
+  const qHome = end ? null : quadOf(home)
+  const samDim = 1 - 0.25 * easeOf('sine.inOut')(u(t, S.rOut, S.reply[1]))
+  const shade = Math.max(upOf(WORDS.scroll, t), upOf(WORDS.heart, t), upOf(WORDS.reply, t))
+  return (
+    <div className="r2-cam">
+      <canvas ref={glc} className="r2-wall is-src" width="1080" height="1920" />
+      <canvas ref={blur} className="r2-wall" width="1080" height="1920" />
+      {!end ? pinned.map((p) => (
+        <LetterOver key={p.name} q={quadOf(p.l)} name={p.name} text={p.text} tint={p.tint} seed={`atlas-${p.name}`} hearts={heartsOf(p.cell - 1)} o={still * lightOf(p.l, t) * 1.15} />
+      )) : null}
+      {qHome ? (
+        <div ref={sam} className="r2-over is-sam" style={{ transform: boxOnto(BOX.w, BOX.h, qHome), filter: [samDim < 1 ? `brightness(${samDim.toFixed(3)})` : '', still < 0.98 ? `blur(${((1 - still) * 9).toFixed(2)}px)` : ''].join(' ').trim() || undefined }}>
+          <Phone w={PW} tint={SAM.tint} seed={SAM.seed} mode="letter" square name={SAM.to} stamp={SAM.stamp} text={SAM.text} cursor={false} keys={samKeys} quiet={false} />
+        </div>
+      ) : null}
+      <canvas ref={fx} className="r2-fx" width="1080" height="1920" />
+      <Sheet t={t} />
+      {end ? <span className="r2-hush" style={{ opacity: (upOf(WORDS.end, t) * 0.9).toFixed(3) }} /> : null}
+      <Shade o={shade} />
+    </div>
+  )
+}
+function useAtlas() {
+  const [ok, setOk] = useState(!!ATLAS_IMG)
+  useEffect(() => {
+    if (ATLAS_IMG) return
+    const i = new Image()
+    i.src = atlasUrl
+    i.decode().then(() => { ATLAS_IMG = i; setOk(true) })
+  }, [])
+  return ok
+}
+
+// ── the panel ───────────────────────────────────────────────────────────────
+// The dark from the guess on: a screen's panel of cells on the words' grid,
+// each cell lit only by the light of what is on it, the light falling off
+// softly round each note and a few of the cells catching more of it, as
+// the first reel's stars do. Drawn a cell a pixel, then up to the frame
+// with the gaps between cells cut back in.
+const PW_CELLS = Math.ceil((1080 - GX) / C) + 1
+const PH_CELLS = Math.ceil((1920 - GY) / C) + 1
+const STARS = Array.from({ length: 900 }, (_, n) => ({ i: Math.floor(rnd(n * 3 + 1) * PW_CELLS), j: Math.floor(rnd(n * 3 + 2) * PH_CELLS), k: 0.5 + rnd(n * 3 + 3) * 1.6, ph: rnd(n * 7 + 1) * 6.28, sp: 0.6 + rnd(n * 7 + 2) * 1.4 }))
+let GAPS = null
+function gapsOf() {
+  if (GAPS) return GAPS
+  const cv = document.createElement('canvas')
+  cv.width = 1080
+  cv.height = 1920
+  const g = cv.getContext('2d')
+  g.fillStyle = '#000'
+  for (let x = GX; x < 1080; x += C) g.fillRect(x - 0.5, 0, 1.5, 1920)
+  for (let y = GY; y < 1920; y += C) g.fillRect(0, y - 0.5, 1080, 1.5)
+  GAPS = cv
+  return cv
+}
+// the lights on the panel at `t`: [x, y, radius, [r, g, b] 0 to 1, strength]
+function Panel({ t, lights }) {
+  const ref = useRef(null)
+  const small = useRef(null)
+  useLayoutEffect(() => {
+    if (!small.current) { small.current = document.createElement('canvas'); small.current.width = PW_CELLS; small.current.height = PH_CELLS }
+    const s = small.current.getContext('2d')
+    const img = s.createImageData(PW_CELLS, PH_CELLS)
+    const d = img.data
+    const L = lights.filter((l) => l[4] > 0.002)
+    for (let j = 0; j < PH_CELLS; j++) {
+      const y = GY + (j + 0.5) * C
+      for (let i = 0; i < PW_CELLS; i++) {
+        const x = GX + (i + 0.5) * C
+        let r = 0.012
+        let gg = 0.012
+        let b = 0.016
+        for (const [lx, ly, R, col, k] of L) {
+          const q = ((x - lx) ** 2 + (y - ly) ** 2) / (R * R)
+          if (q > 9) continue
+          // a soft core and a long, low skirt, as light spreads in a panel
+          const e = k * (Math.exp(-q * 1.6) * 0.75 + 0.25 / (1 + q * 3))
+          r += col[0] * e
+          gg += col[1] * e
+          b += col[2] * e
+        }
+        const o = (j * PW_CELLS + i) * 4
+        d[o] = Math.min(255, r * 255)
+        d[o + 1] = Math.min(255, gg * 255)
+        d[o + 2] = Math.min(255, b * 255)
+        d[o + 3] = 255
+      }
+    }
+    // the stars: cells catching more of the light where there is light
+    for (const st of STARS) {
+      const o = (st.j * PW_CELLS + st.i) * 4
+      const tw = 0.6 + 0.4 * Math.sin(t / 1000 * st.sp * 3 + st.ph)
+      const k = 1 + st.k * tw
+      d[o] = Math.min(255, d[o] * k + 3 * tw)
+      d[o + 1] = Math.min(255, d[o + 1] * k + 3 * tw)
+      d[o + 2] = Math.min(255, d[o + 2] * k + 4 * tw)
+    }
+    s.putImageData(img, 0, 0)
+    const g = ref.current.getContext('2d')
+    g.imageSmoothingEnabled = false
+    g.fillStyle = '#000'
+    g.fillRect(0, 0, 1080, 1920)
+    g.drawImage(small.current, GX, GY, PW_CELLS * C, PH_CELLS * C)
+    // a little bloom of the same light, under the cells' edges
+    g.globalCompositeOperation = 'lighter'
+    g.globalAlpha = 0.35
+    g.imageSmoothingEnabled = true
+    g.filter = 'blur(10px)'
+    g.drawImage(small.current, GX, GY, PW_CELLS * C, PH_CELLS * C)
+    g.filter = 'none'
+    g.globalAlpha = 1
+    g.globalCompositeOperation = 'source-over'
+    g.drawImage(gapsOf(), 0, 0)
+  })
+  return <canvas ref={ref} className="r2-panel" width="1080" height="1920" />
+}
+const lin = (hex, k = 1) => hexRgb(hex).map((x) => (x / 255) ** 1.6 * k)
+
+// ── 15 to 18.75: the guess ──────────────────────────────────────────────────
+// The composer, held to us on the dark: `dear noor`, and the guess typed,
+// `it was you,` quickly, a breath, the rest. Sent: the words go into the
+// envelope, sealed it lights, the phone goes out behind it to a line and a
+// point, and it is left on the dark, lit, waiting
+const G_TIMES = typedGuess()
+const WAIT = [380, 1060]
+function guessEnv(t) {
+  // on the glass, then lifted away to its place to wait
+  const k = easeOf('expo.inOut')(u(t, S.gCrt + 380, S.gCrt + 1150))
+  return { x: lerp(OBJ.x, WAIT[0], k), y: lerp(OBJ.y - 60, WAIT[1], k), cell: lerp(30, 7.5, easeOf('power2.out')(k)) }
+}
+function GuessScene({ t }) {
+  const ref = useRef(null)
+  const sealed = t >= S.gPress + 120
+  const off = crtOff(t, S.gCrt, 1.45)
+  const shown = !off.gone
+  const scale = OBJ.w / PW
+  const phoneH = 1100 * scale
+  useLayoutEffect(() => {
+    const g = ref.current.getContext('2d')
+    g.clearRect(0, 0, 1080, 1920)
+    if (off.dot > 0) drawDot(g, OBJ.x, OBJ.y, 12, off.dot)
+    if (!sealed) return
+    const e = guessEnv(t)
+    const lit = on(t, S.gPress + 160, 140)
+    const shine = lerp(-4, 19, u(t, S.gPress + 200, S.gPress + 520))
+    drawEnvelope(g, { x: e.x, y: e.y, cell: e.cell, ink: lit < 1 ? skinOf(GUESS.tint).ink : null, a: on(t, S.gPress + 120, 60) * (1 - lit) })
+    drawEnvelope(g, { x: e.x, y: e.y, cell: e.cell, tint: 'white', a: lit, white: 0.15, shine, glow: lit })
+  })
+  const lights = [
+    [OBJ.x, OBJ.y, 520, lin('#E8ECF2'), 0.55 * (shown ? off.sy * (1 + off.white) : 0) * on(t, S.guess[0], 200)],
+  ]
+  if (sealed) { const e = guessEnv(t); lights.push([e.x, e.y, 120 + e.cell * 8, lin('#EEF3FF'), 0.5 * on(t, S.gPress + 160, 200)]) }
+  return (
+    <div className="r2-cam">
+      <Panel t={t} lights={lights} />
+      {shown ? (
+        <div className="r2-held" style={{ left: OBJ.x - OBJ.w / 2, top: OBJ.y - phoneH / 2, width: OBJ.w, transform: `translate(${(shake(t, 21) * 1.6).toFixed(2)}px, ${(shake(t, 27) * 1.9).toFixed(2)}px) scale(${off.sx.toFixed(4)}, ${off.sy.toFixed(4)})`, filter: off.white > 0 ? `brightness(${(1 + off.white * 2.2).toFixed(3)})` : sealed ? 'brightness(0.55)' : undefined }}>
+          <div style={{ width: PW, transform: `scale(${scale})`, transformOrigin: '0 0' }}>
+            <NoteScreen who={GUESS} t={t} times={G_TIMES} sendAt={S.gPress} fs={14} quiet={false} fx hide={sealed} />
+          </div>
+        </div>
+      ) : null}
+      <canvas ref={ref} className="r2-fx" width="1080" height="1920" />
+      <Shade o={upOf(WORDS.guess, t) * 0.6} />
+    </div>
+  )
+}
+
+// ── 18.75 to 23.75: the week ────────────────────────────────────────────────
+// sam's guess waiting on the dark; the week along the foot of the panel, a
+// day lit at a time; on the thursday, noor's note to sam coming on from the
+// other side; on saturday at nine the two find each other, wait a moment
+// apart, and touch, and the light of the two goes over the panel; out of
+// it, the phone, telling the mutual as the product tells it
+const DAYS = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat']
+const STRIP = { y: GY + 214 * C, x0: 150, x1: 870 }
+const N_AT = [760, 960]
+const MEET = [540, 1010]
+const dayAt = (t) => easeOf('power2.inOut')(u(t, S.lapse[0], S.lapse[1])) * 5.88
+function pair(t) {
+  const k = easeOf('sine.inOut')(u(t, S.lapse[1] - 300, S.touch[0] + 200))
+  const kn = easeOf('sine.inOut')(u(t, S.lapse[1] - 450, S.touch[0] + 120))
+  const space = lerp(14, -2, easeOf('power2.in')(u(t, S.touch[0], S.touch[1])))
+  const half = (11 * C * 1.1 + space) / 2
+  return {
+    sam: [lerp(WAIT[0], MEET[0] - half, k), lerp(WAIT[1], MEET[1], k) - Math.sin(Math.PI * k) * 18],
+    noor: [lerp(N_AT[0], MEET[0] + half, kn) + Math.sin(Math.PI * kn) * 14, lerp(N_AT[1], MEET[1], kn)],
+  }
+}
+let FILM = null
+function WeekScene({ t }) {
+  const ref = useRef(null)
+  const p = pair(t)
+  const burst = t >= S.touch[1] ? 1 - u(t, S.touch[1], S.touch[1] + 1600) ** 0.6 : 0
+  const breath = Math.sin(((t - S.week[0]) / 1700) * Math.PI * 2 - Math.PI / 2) * 0.5 + 0.5
+  const tell = t >= S.tell
+  useLayoutEffect(() => {
+    const g = ref.current.getContext('2d')
+    g.clearRect(0, 0, 1080, 1920)
+    // the week, along the foot: each day lit as the clock passes it, the
+    // saturday held lit, and at nine the time under it
+    const d = dayAt(t)
+    const up = on(t, S.lapse[0] - 200, 220) * (1 - u(t, S.tell, S.tell + 300))
+    if (up > 0) {
+      DAYS.forEach((name, i) => {
+        const x = lerp(STRIP.x0, STRIP.x1, i / 5)
+        const here = clamp(1 - Math.abs(d - i) * 1.3)
+        const past = i < d ? 0.38 : 0.2
+        const L = typeCells(name)
+        const c = 4
+        g.globalAlpha = up * Math.max(past, here)
+        g.fillStyle = i === 5 && d > 4.6 ? mix(CHALK, skinOf(NOOR.tint).lit, 0.3) : CHALK
+        for (const [cx, cy] of L.cells) g.fillRect(Math.round(x - (L.w * c) / 2) + cx * c, STRIP.y + (cy + 10) * c, c, c)
+      })
+      // a point travelling the strip, as a phone's progress does
+      const x = lerp(STRIP.x0, STRIP.x1, d / 5)
+      g.globalAlpha = up * (1 - u(t, S.lapse[1], S.lapse[1] + 300))
+      g.fillStyle = '#FFFFFF'
+      g.fillRect(Math.round(x) - 4, STRIP.y + 104, 8, 8)
+      g.globalAlpha = 1
+    }
+    if (tell) return
+    // noor's, from the thursday: a screen coming on
+    if (t >= S.noorIn) {
+      const c = crtOn(t, S.noorIn, 1.3)
+      if (!c.lit) drawDot(g, ...p.noor, 7, c.dot, NOOR.tint)
+      else drawEnvelope(g, { x: p.noor[0], y: p.noor[1], cell: 7.7, tint: NOOR.tint, sx: c.sx, sy: c.sy, white: Math.max(c.white, burst * 0.9) })
+    }
+    drawEnvelope(g, { x: p.sam[0], y: p.sam[1], cell: 7.5, tint: 'white', white: Math.max(0.12 * breath, burst * 0.9), glow: 0.85 + 0.45 * breath })
+  })
+  // the panel's light: the two, and at the touch their light together over
+  // all of it, the acid and the white wound into each other
+  const lights = [
+    [p.sam[0], p.sam[1], 140 + 30 * breath, lin('#EEF3FF'), tell ? 0 : 0.42],
+    [p.noor[0], p.noor[1], 140, lin(skinOf(NOOR.tint).glow), tell || t < S.noorIn + 100 ? 0 : 0.5 * on(t, S.noorIn + 100, 300)],
+    [MEET[0] - 40, MEET[1], lerp(80, 900, easeOf('expo.out')(u(t, S.touch[1], S.touch[1] + 1400))), lin(skinOf(NOOR.tint).glow), t < S.touch[1] ? 0 : 0.62 * (1 - 0.55 * u(t, S.touch[1] + 500, S.wOut))],
+    [MEET[0] + 60, MEET[1] + 40, lerp(60, 700, easeOf('expo.out')(u(t, S.touch[1] + 80, S.touch[1] + 1500))), lin('#EAF0FF'), t < S.touch[1] ? 0 : 0.45 * (1 - 0.55 * u(t, S.touch[1] + 500, S.wOut))],
+  ]
+  // the phone telling it: the mutual's own film, from the two of them
+  // running in to `it's mutual.` typed under the mark, at its own pace and
+  // a little quicker, held there to the cut
+  let at0 = null
+  if (tell && FILM) {
+    const T = FILM.times
+    const a = T.catch - 250
+    const z = T.said + 200
+    at0 = lerp(a, z, u(t, S.tell, S.wOut - 300))
+  }
+  const c = crtOn(t, S.tell, 1.6)
+  const fw = 600
+  return (
+    <div className="r2-cam">
+      <Panel t={t} lights={lights} />
+      <canvas ref={ref} className="r2-fx" width="1080" height="1920" />
+      <CellLine t={t} text="9:00 pm" times={[S.lapse[1] - 120, S.lapse[1] + 40]} to={S.tell - 200} x={STRIP.x1 + 50} y={STRIP.y + 128} c={5} align="right" />
+      {tell && FILM && c.lit ? (
+        <div className="r2-held" style={{ left: OBJ.x - fw / 2, top: OBJ.y + 30 - fw / 2, width: fw, transform: `translate(${(shake(t, 21) * 1.4).toFixed(2)}px, ${(shake(t, 27) * 1.7).toFixed(2)}px) scale(${c.sx.toFixed(4)}, ${c.sy.toFixed(4)})`, filter: c.white > 0 ? `brightness(${(1 + c.white * 1.6).toFixed(3)})` : undefined }}>
+          <Phone w={fw} tint={NOOR.tint} seed="r2-film" mode="bare" square className="is-story"><PixelStory story={FILM} at={at0} /></Phone>
+        </div>
+      ) : null}
+      {c.dot > 0 && !c.lit ? <span className="r2-dot" style={{ left: OBJ.x - 7, top: OBJ.y + 23, opacity: c.dot.toFixed(3) }} /> : null}
+      <Shade o={upOf(WORDS.week, t) * 0.55} />
+    </div>
+  )
+}
+
+// ── 23.75 to 26.25: the guess that was wrong ────────────────────────────────
+// the same envelope alone on the dark, waiting; at its time it goes out as
+// a screen does, to a line and a point, and the point goes
+const ALONE = [380, 1060]
+function WrongScene({ t }) {
+  const ref = useRef(null)
+  const o = crtOff(t, S.fOff, 1.6)
+  const breath = Math.sin(((t - S.wrong[0]) / 1700) * Math.PI * 2 - Math.PI / 2) * 0.5 + 0.5
+  useLayoutEffect(() => {
+    const g = ref.current.getContext('2d')
+    g.clearRect(0, 0, 1080, 1920)
+    if (t < S.fOff) drawEnvelope(g, { x: ALONE[0], y: ALONE[1], cell: 7.5, tint: 'white', white: 0.12 * breath, glow: 0.85 + 0.4 * breath })
+    else if (!o.gone) drawEnvelope(g, { x: ALONE[0], y: ALONE[1], cell: 7.5, tint: 'white', sx: o.sx, sy: o.sy, white: o.white, glow: 0.8 * o.sy })
+    else drawDot(g, ALONE[0], ALONE[1], 6, o.dot * 0.9)
+  })
+  const k = t < S.fOff ? 1 : o.gone ? 0.25 * o.dot : o.sy
+  const lights = [[ALONE[0], ALONE[1], 150 + 30 * breath, lin('#EEF3FF'), 0.42 * k * on(t, S.wrong[0], 120)]]
+  return (
+    <div className="r2-cam">
+      <Panel t={t} lights={lights} />
+      <canvas ref={ref} className="r2-fx" width="1080" height="1920" />
+      <Shade o={upOf(WORDS.wrong, t) * 0.5} />
+    </div>
+  )
+}
+
+// ── 26.25 to 30: the wall again, and the name ───────────────────────────────
+// the lockup in the middle, a cell at a time from the middle of its star,
+// and the address typed under it
+const LOCK = { x: GX + Math.round((540 - (LOCKUP.w * C) / 2 - GX) / C) * C, y: GY + 128 * C }
+const STAR = { x: LOCK.x + Math.round((LOCKUP.mark.w * C) / 2), y: LOCK.y + Math.round((LOCKUP.mark.h * C) / 2) }
+let LIT = null
+function lockCells() {
+  if (LIT) return LIT
+  const word = wordCells()
+  const cells = [...cellsOf(MARK), ...word.cells.map(([x, y]) => [x + LOCKUP.word.x, y])].map(([x, y]) => [LOCK.x + x * C, LOCK.y + y * C])
+  const span = Math.max(...cells.map(([x, y]) => Math.hypot(x - STAR.x, y - STAR.y)))
+  LIT = cells.map(([x, y], i) => ({ x, y, on: S.lock[0] + (Math.hypot(x + C / 2 - STAR.x, y + C / 2 - STAR.y) / span) * (S.lock[1] - S.lock[0] - 320) + rnd(i * 7 + 3) * 80 }))
+  return LIT
+}
+const URL_TIMES = typedUrl()
+function NameScene({ t }) {
+  const ref = useRef(null)
+  const cells = useMemo(lockCells, [])
+  useLayoutEffect(() => {
+    const g = ref.current.getContext('2d')
+    g.clearRect(0, 0, 1080, 1920)
+    if (t >= S.lock[0] - 50 && t < S.lock[1] + 60) {
+      g.fillStyle = CHALK
+      for (const p of cells) {
+        const k = on(t, p.on, 110)
+        if (k <= 0) continue
+        g.globalAlpha = k
+        g.fillRect(p.x, p.y, C, C)
+      }
+      g.globalAlpha = 1
+    }
+  })
+  // the star's light, gathered under it
+  const lights = [[STAR.x, STAR.y, 260, lin('#F2EEF8'), 0.3 * on(t, S.lock[0], 600)]]
+  return (
+    <div className="r2-cam">
+      <Panel t={t} lights={lights} />
+      <canvas ref={ref} className="r2-fx" width="1080" height="1920" />
+      {t >= S.lock[1] ? <Lockup cell={C} className="r2-lock" style={{ left: LOCK.x, top: LOCK.y }} /> : null}
+      <CellLine t={t} text={URL} times={URL_TIMES} unit="char" c={4} x={540} y={LOCK.y + LOCKUP.h * C + 56} align="center" />
+    </div>
+  )
+}
+
+// ── the reel ────────────────────────────────────────────────────────────────
+const FACES = ['400 40px "Jersey 10"']
+export function Reel2({ t, hook = 'a' }) {
+  const [ok, setOk] = useState(false)
+  const atlas = useAtlas()
+  useEffect(() => {
+    Promise.all(FACES.map((f) => document.fonts.load(f)))
+      .then(() => readyFilm('sam', 'noor'))
+      .then(() => { FILM = filmOf('sam', 'noor', NOOR.tint); setOk(true) })
+  }, [])
+  useHold(ok && atlas)
+  const hw = useMemo(() => hookWords(hook), [hook])
+  const wall = t < S.guess[0] || (t >= S.end[0] && t < S.eOut + 500)
+  return (
+    <Board w={1080} h={1920} grain={0} className="r2-board">
+      <div className="r2-stage">
+        {/* each scene owns exactly its own frames, and they cut */}
+        {ok && atlas && wall ? <WallScene t={t} /> : null}
+        {ok && t >= S.guess[0] && t < S.week[0] ? <GuessScene t={t} /> : null}
+        {ok && t >= S.week[0] && t < S.wrong[0] ? <WeekScene t={t} /> : null}
+        {ok && t >= S.wrong[0] && t < S.end[0] ? <WrongScene t={t} /> : null}
+        {ok && t >= S.eOut + 500 ? <NameScene t={t} /> : null}
+        {ok ? (
+          <>
+            <Shade o={upOf(hw, t) * 0.75} />
+            <Words t={t} of={hw} />
+            <Words t={t} of={WORDS.scroll} />
+            <Words t={t} of={WORDS.heart} />
+            <Words t={t} of={WORDS.reply} />
+            <Words t={t} of={WORDS.guess} />
+            <Words t={t} of={WORDS.week} />
+            <Words t={t} of={WORDS.wrong} />
+            <Words t={t} of={WORDS.end} />
+          </>
+        ) : null}
+      </div>
+      <span className="st-vignette" style={{ opacity: 0.55 }} aria-hidden="true" />
+    </Board>
+  )
+}
