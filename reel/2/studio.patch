+// ── the second reel's clock ─────────────────────────────────────────────────
+//
+// Thirty seconds at the first reel's 96 beats a minute (reel-time.js): a
+// beat is 625ms, a bar 2.5s, twelve bars, and every word and every sound on
+// a beat. The picture (reel2.jsx) and the sounds (scripts/reel2-sounds.mjs)
+// both read this file. Plain script, so node reads it as the page does.
+//
+// The first reel is the one who writes. This one is the one written to: sam
+// finds a letter on the wall that can only be about sam; the wall is
+// letters to people who don't know yet; nobody knows who wrote it; sam
+// writes back, and is marked as the one it was to; then sam guesses, and
+// tells the guess privately. If the guess is right and they sent one too,
+// both find out. If it is wrong, nobody ever knows sam guessed.
+
+export const MS = 30000
+export const BPM = 96
+export const BEAT = 60000 / BPM
+export const beat = (n) => n * BEAT
+
+// sam's letter, on the wall: to sam, by somebody, lit rose
+export const SAM = { to: 'sam', tint: 'rose', seed: 'sam-2', stamp: '10/09/26', text: 'you sit by the window in the 9am and hum when you’re thinking. i’ve never said a word.' }
+// sam's reply, under it, marked as the one it was to
+export const REPLY = 'was it the library?'
+// sam's guess, sent privately, and the note that was already on its way
+export const GUESS = { name: 'sam', to: 'noor', tint: 'white', seed: 'sam-guess', text: 'it was you, wasn’t it.' }
+export const NOOR = { tint: 'acid' }
+
+// the hooks: the same film, its first bar and a half told three ways
+export const HOOKS = {
+  a: ['you might be on here', 'and not know it.'],
+  b: ['is this one', 'about you?'],
+  c: null,
+}
+
+// ── the scenes, in ms ───────────────────────────────────────────────────────
+export const S = {
+  // the hook: sam's letter held to us, already whole, the caption over it
+  // on the first beats
+  hook: [0, 3750], hLines: [40, 420], hOut: 3420,
+  // the scroll: up the wall a letter at a time, flicked as a thumb flicks,
+  // each landing a little past and settling; and down again to sam's
+  scroll: [3750, 8750], sLines: [5000, 5625], sOut: 8300,
+  // [ms the flick starts, the letter it lands on (i, j)], each flick 520ms
+  stops: [[3750, [0, 0]], [3900, [0, 2]], [4900, [-1, 5]], [5950, [1, 8]], [7300, [0, 0]]],
+  // the heart: held on sam's letter; a press, and it fills
+  heart: [8750, 12500], kLines: [9375, 10000], press: 10625, kOut: 12150,
+  // the reply: the letter steps up, the thread comes up under it, and sam's
+  // reply typed into it, marked
+  reply: [12500, 15000], rise: [12500, 13050], typed: 13150, rLines: [12813, 13438], rOut: 14750,
+  // the guess: the composer, a note to a guess, typed, sent; the phone goes
+  // out behind its envelope, which is left lit on the dark
+  guess: [15000, 18750], gLines: [15313, 16875], gType: 15360, gPress: 17188, gCrt: 17320, gOut: 18450,
+  // the week: the guess waits; on the thursday a note comes in from the
+  // other side; at nine on the saturday the two find each other and touch,
+  // and the phone tells it
+  week: [18750, 23750], wLines: [18938, 19375], lapse: [19375, 20900], noorIn: 20000, touch: [20900, 21330], tell: 21330, both: 22500, wOut: 23450,
+  // the guess that was wrong: alone, and out, to a line and a point
+  wrong: [23750, 26250], fLines: [24063, 24688, 25000], fOff: 25450, fOut: 26000,
+  // the wall again, far, and the line; then the name from its star
+  end: [26250, 30000], eLine: 26563, eOut: 27650, lock: [27650, 28650], url: 28650,
+}
+
+// A hand's rhythm, as the first reel's: a beat a letter, a longer one after
+// a space and after a stop, a little unevenness off the letter itself
+export function rhythm(text, from, step, stop = 2.5) {
+  const out = []
+  let t = from
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i]
+    const prev = text[i - 1] || ''
+    const wobble = ((Math.sin((i + 1) * 12.9898 + c.charCodeAt(0) * 78.233) * 43758.5453) % 1 + 1) % 1
+    t += step * (0.7 + wobble * 0.6) + (prev === ' ' ? step * 0.4 : 0) + (/[.?,]/.test(prev) ? step * stop : 0)
+    out.push(t)
+  }
+  return out
+}
+export const typedReply = () => rhythm(REPLY, S.typed, 52, 2)
+// the guess: `it was you,` quickly, a held breath, then the rest slower
+export function typedGuess() {
+  const t = rhythm(GUESS.text, S.gType, 52, 3)
+  const i = GUESS.text.indexOf('wasn')
+  for (let k = i; k < t.length; k++) t[k] += 160
+  return t
+}
+export const URL = 'celestual.us'
+export const typedUrl = () => rhythm(URL, S.url - 18, 40, 1.4)
