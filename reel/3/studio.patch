+// ── reel 3 · sat ────────────────────────────────────────────────────────────
+//
+// 6 · 8:59 (1040 to 1200). The vault's title strip as the whole screen
+// (You.jsx 296-331 `RevealStrip`, reel3-ui.js `strip`): `reveals in`, the
+// count at 2C, the one bright thing, and `sat · 9pm pt`; its Seal is left
+// out, being an envelope (reel3-TREATMENT.md shot 6, reel3-CONTRACT.md
+// 11.8).
+//
+//   1040  the cut on `keep it`'s press lands here: 00:00:02. On the last day
+//         the strip has its seconds, and ticks on the product's floor maths
+//         a moment after each whole second (pings.js `countdown`)
+//   1080  00:00:01, and 1140 00:00:00: each change the film's only LCD
+//         redraw (reel3-cells.js `redraw`): the cells that change cross over
+//         two frames, the new ones overshoot for two, and every cell beside
+//         one going out dips, the overdrive's ring
+//   1200  nine: the count rolls over in frame, by the same redraw (nine.js
+//         carries the strip on from here)
+//
+// Nothing else on the screen moves. Between the ticks it is a second of a
+// phone waiting, and the dark round the count is the only thing alive: the
+// light the digits throw spreading out into it from the cut and never quite
+// stopping, the flow's currents, the stars. Each second lands in that
+// light: at each tick, and at the roll over, a drop of the count's white
+// from the digits' middle pushed out from them, so the second opens into
+// the dark in the panel's spiral veins, two of its pushes down into the
+// empty lower half, so each tick blooms there, white over the eye's knee,
+// and is gone before the next lands, each second winding the other way to
+// the last; and between, the digits keep putting a little of it in
+// (FLOW.satTick, FLOW.feed.sat)
+
+import { SCENES, S, COL, FLOW, fr, ms, cellX, cellY, countAt } from '../reel3-time.js'
+import { lin } from '../reel3-cells.js'
+import * as ui from '../reel3-ui.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.sat
+
+const T = S.sat
+// how far a drop of ink has spread `dt` seconds after it fell (reel-aura.js
+// `drop`, which a scene may not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+
+// The count's light on the dark (11.8: R 260, a 0.18, white glow), from the
+// middle of the digits as they now stand (they are worked out by the strip
+// as it draws them), spreading to its reach slowly from the cut: the strip
+// is all there at once, its light takes the shot's first second to open
+// (its veins turning round the digits half a radian each second, so the
+// wait is alive: nine carries these same numbers on, nine.js COUNT_GLOW)
+const GLOW = { R0: 120, R: 140, tau: 0.6, a: 0.3, crest: 0.25, body: 1, flow: 0.2, turn: -0.5, seed: 1.7 }
+// Each second landing: a bloom of the count's white opening under the
+// digits, each a step further down into the empty lower half of the
+// screen than the last (`below`, and `fall` more each second: the seconds
+// sinking into the dark toward nine), quick and then slower, going over
+// its `life`, and the ink it leaves winding on there after it
+// (FLOW.satTick, `tickAt`): each tick a new light in the dark, gone before
+// the next lands, and its ink winding the other way to the last's. (At
+// R 480 and 0.6 the white was dim enough for the eye's grey for dim light:
+// three grey puffs of cloud, one with two dark holes that read as a face;
+// at R 260 and 0.9 it stays over the knee, white light)
+const TICK = { below: 160, fall: 260, R0: 60, R: 260, tau: 0.5, a: 0.9, life: 1.0, crest: 0.35, body: 0.9, flow: 0.4, seed: 3.9 }
+const tickAt = (at, n) => ({ x: at.x + (n % 2 ? -1 : 1) * 60, y: at.y + TICK.below + TICK.fall * n })
+const centreOf = (r) => ({ x: (cellX(r[0]) + cellX(r[2]) + 6) / 2, y: (cellY(r[1]) + cellY(r[3]) + 6) / 2 })
+
+// once, before the first frame: the count's every rect cut, with the face in
+export function prime() {
+  for (const [, x] of T.count) ui.stripDigits(x)
+}
+
+// the frame: the strip, the count by its redraw
+export function paint(t, buf) {
+  const f = fr(t)
+  ui.strip(buf, f)
+}
+
+// The flow: each second's drop from the digits' middle, for its steps,
+// with four pushes out from it; and the steady feed between
+const TICKS = [...T.ticks, S.nine.roll]
+export function flow(fl, t) {
+  const f = Math.round(fr(t))
+  const F = FLOW.feed.sat
+  const at = () => centreOf(ui.stripDigits(countAt(f)))
+  if (f >= F.from && f < F.to) { const c = at(); fl.ink(c.x, c.y, lin(COL[F.tint].glow).map((v) => v * F.a), F.r) }
+  const K = FLOW.satTick
+  const tick = TICKS.find((g) => f >= g && f < g + K.steps)
+  if (tick == null) return
+  const n = TICKS.indexOf(tick)
+  const c = tickAt(at(), n)
+  fl.ink(c.x, c.y, lin(COL[K.tint].glow).map((v) => v * K.a), K.r)
+  const v = K.push * K.pushStep
+  // two of its four pushes up and either side, two down into the empty
+  // lower half, `down` either side of straight down (y is down the frame),
+  // each turned a little round the drop (`twist`), so it opens in a
+  // spiral and never in spokes; each second the other way round to the
+  // last, so no two seconds are the same device
+  const twist = K.twist * (n % 2 ? -1 : 1)
+  const ths = [-Math.PI / 2 - 0.9, -Math.PI / 2 + 0.9, Math.PI / 2 - K.down, Math.PI / 2 + K.down]
+  for (const th of ths) {
+    const dx = Math.cos(th)
+    const dy = Math.sin(th)
+    const ux = Math.cos(th + twist)
+    const uy = Math.sin(th + twist)
+    fl.push(c.x + 40 * dx, c.y + 40 * dy, v * ux, v * uy, K.pushR)
+  }
+}
+
+// the light placed: the count's, from the digits' middle; and each tick's
+// bloom under it, while it lasts
+export function light(t, L) {
+  const s = t / 1000
+  const dt = (t - ms(T.from)) / 1000
+  const at = centreOf(ui.stripDigits(countAt(fr(t))))
+  L.source({
+    x: at.x, y: at.y, R: GLOW.R0 + GLOW.R * drop(dt, GLOW.tau), a: GLOW.a, col: lin(COL.white.glow),
+    seed: GLOW.seed, crest: GLOW.crest, body: GLOW.body, flow: GLOW.flow * s, turn: GLOW.turn * s, time: s,
+  })
+  tickLight(t, L, at)
+}
+// where each second's white went into the flow (px), for nine to take it
+// down as the limbo develops
+export function tickPoints() {
+  return TICKS.map((g, n) => tickAt(centreOf(ui.stripDigits(countAt(g))), n))
+}
+// the blooms of the ticks before `t` that are still going, from under the
+// digits' middle `at` (nine carries the roll over's on with its own)
+export function tickLight(t, L, at) {
+  const f = fr(t)
+  TICKS.forEach((g, n) => {
+    const kt = (f - g) / 60
+    if (!(kt >= 0 && kt < TICK.life)) return
+    const c = tickAt(at, n)
+    L.source({
+      x: c.x, y: c.y, R: TICK.R0 + TICK.R * drop(kt, TICK.tau), a: TICK.a * (1 - kt / TICK.life) ** 1.5, col: lin(COL.white.glow),
+      seed: TICK.seed + 2.3 * n, crest: TICK.crest, body: TICK.body, flow: TICK.flow * kt, time: kt,
+    })
+  })
+}
+
