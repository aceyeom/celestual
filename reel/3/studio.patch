+#!/usr/bin/env node
+// reel3-render.mjs: the third reel, photographed in parallel and finished,
+// as reel2-render.mjs does the second: the sounds first (reel3-sounds.mjs),
+// then a few photographers at once (studio-film.mjs `--frames`), each on its
+// own run of the film at sixty frames a second, and the first reel's finish
+// (studio-finish.mjs), the thirty mixed from the sixty.
+//
+// The panel's flow is the one thing in the film with a history: a frame
+// asked for after a later one re-simulates it from the first frame
+// (reel3-panel.js `stepTo`). So every share is strictly forward: it runs up
+// to its first frame as the film comes to it and goes on a frame at a time,
+// and a share taken up again (`--resume`) goes on from its first missing
+// frame, never back. The shares start six seconds apart, so the two pages
+// are not both stepping the flow up to their first frames at once.
+//
+// Hook B (reel3-time.js HOOKS) is the ghost's eighty frames and then all of
+// A: B's frame n + 80 is A's frame n to the bit (reel3-check.mjs --md5), so
+// only its first eighty are photographed, and the rest are A's own frames.
+//
+//   node scripts/reel3-render.mjs [--jobs 2] [--hooks a,b] [--keep] [--resume]
+//
+// Writes, in OUT (reel/3 unless it says): celestual-reel-3.mp4,
+// celestual-reel-3-b.mp4 (1080 × 1920, the thirty), and assets/sound.wav;
+// the frames are kept in FRAMES (.studio-frames/celestual-reel-3) with
+// `--keep`, and taken up again from there with `--resume`.
+import { spawn, spawnSync } from 'node:child_process'
+import { mkdirSync, rmSync, existsSync, readdirSync, symlinkSync, lstatSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { MS, HOOKS } from '../app/src/studio/parts/reel3-time.js'
+import { finish } from './studio-finish.mjs'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+const args = process.argv.slice(2)
+const opt = (k, d) => { const i = args.indexOf(`--${k}`); return i >= 0 ? args[i + 1] : d }
+const jobs = Math.max(1, Number(opt('jobs', 2)))
+const hooks = opt('hooks', 'a,b').split(',')
+const resume = args.includes('--resume')
+const keep = args.includes('--keep')
+const fps = 60
+const total = Math.round((MS / 1000) * fps)
+const B = HOOKS.b.offset
+const outDir = process.env.OUT || join(root, 'reel/3')
+const scratch = process.env.FRAMES || join(root, '.studio-frames', 'celestual-reel-3')
+const wav = join(outDir, 'assets/sound.wav')
+const wavB = join(scratch, 'sound-b.wav')
+const name = (i) => `f${String(i).padStart(5, '0')}.jpg`
+
+const run = (cmd, a) => new Promise((ok, no) => {
+  const p = spawn(cmd, a, { stdio: ['ignore', 'pipe', 'inherit'], cwd: root })
+  p.stdout.on('data', (d) => process.stdout.write(String(d)))
+  p.on('close', (c) => (c === 0 ? ok() : no(new Error(`${cmd} ${a.slice(0, 2).join(' ')}: ${c}`))))
+})
+
+// Photograph frames [a, z] of a film into `dir`, shared among the jobs. A
+// share already whole is not taken again; one begun goes on from its first
+// missing frame (forward, so the flow is never sent back)
+async function shoot(id, dir, a, z) {
+  mkdirSync(dir, { recursive: true })
+  const have = new Set(readdirSync(dir))
+  const n = z - a + 1
+  const shares = []
+  for (let k = 0; k < jobs; k++) {
+    const s0 = a + Math.floor((k * n) / jobs)
+    const s1 = a + Math.floor(((k + 1) * n) / jobs) - 1
+    let todo = s0
+    while (todo <= s1 && have.has(name(todo))) todo++
+    if (todo <= s1) shares.push([todo, s1])
+  }
+  console.log(`${id}: frames ${a} to ${z}, ${shares.length ? shares.map(([p, q]) => `${p}-${q}`).join(', ') : 'all there'}`)
+  const t0 = Date.now()
+  await Promise.all(shares.map(([s0, s1], k) => new Promise((r) => setTimeout(r, k * 6000))
+    .then(() => run('node', ['scripts/studio-film.mjs', id, '--fps', String(fps), '--frames', dir, '--first', String(s0), '--last', String(s1)]))))
+  const done = shares.reduce((s, [p, q]) => s + q - p + 1, 0)
+  if (done) console.log(`${id}: ${done} frames in ${((Date.now() - t0) / 1000).toFixed(0)} s, ${((Date.now() - t0) / done / 1000 * jobs).toFixed(2)} s a frame a page`)
+  const missing = []
+  for (let i = a; i <= z; i++) if (!existsSync(join(dir, name(i)))) missing.push(i)
+  if (missing.length) throw new Error(`${id}: ${missing.length} frames missing, the first ${missing[0]}`)
+}
+
+// the frames at sixty, mixed two to one into the thirty (the delivered frame
+// k is 2k and 2k + 1 together, which is why stepped motion moves on even
+// frames), finished as the first reel is, with the sound under them
+const enc = ['-c:v', 'libx264', '-preset', 'slow', '-tune', 'film', '-pix_fmt', 'yuv420p', '-profile:v', 'high', '-c:a', 'aac', '-b:a', '256k', '-shortest', '-movflags', '+faststart']
+function encode(dir, frames, sound, file) {
+  const graph = finish({ fps: 30, s: frames / fps, pre: 'tmix=frames=2,select=mod(n\\,2),setpts=N/(30*TB),' })
+  const r = spawnSync('ffmpeg', ['-v', 'error', '-y', '-framerate', String(fps), '-i', join(dir, 'f%05d.jpg'), '-i', sound, '-filter_complex', graph, '-map', '[v]', '-map', '1:a', '-r', '30', '-crf', '20', '-maxrate', '16M', '-bufsize', '32M', ...enc, file], { stdio: 'inherit' })
+  if (r.status !== 0) throw new Error(`ffmpeg ${file}`)
+  console.log(file.replace(`${root}/`, ''))
+}
+
+mkdirSync(join(outDir, 'assets'), { recursive: true })
+if (!resume && existsSync(scratch)) rmSync(scratch, { recursive: true })
+mkdirSync(scratch, { recursive: true })
+// the sounds first: a minute's work at most, and a film without its sound
+// is not finished
+await run('node', ['scripts/reel3-sounds.mjs', wav])
+if (hooks.includes('b')) await run('node', ['scripts/reel3-sounds.mjs', wavB, '--offset', String(B)])
+
+const main = join(scratch, 'a')
+await shoot('celestual-reel-3', main, 0, total - 1)
+if (hooks.includes('a')) encode(main, total, wav, join(outDir, 'celestual-reel-3.mp4'))
+
+if (hooks.includes('b')) {
+  const dir = join(scratch, 'b')
+  await shoot('celestual-reel-3-b', dir, 0, B - 1)
+  // the rest of B is A's own frames, eighty later
+  for (let i = B; i < total + B; i++) {
+    const f = join(dir, name(i))
+    if (existsSync(f) || (() => { try { return lstatSync(f).isSymbolicLink() } catch { return false } })()) continue
+    symlinkSync(join(main, name(i - B)), f)
+  }
+  encode(dir, total + B, wavB, join(outDir, 'celestual-reel-3-b.mp4'))
+}
+if (!keep) rmSync(scratch, { recursive: true })
