+  // The panel as the camera sees it: every pixel of the frame to its cell,
+  // and where in its cell. The cell is fixed to the frame; only where the
+  // panel's own light is read (`p`, the cell's middle) moves with the hand.
+  //
+  // A cell shows, from the back: its unlit square; the dark's own light,
+  // the first reel's (a star waiting for light with its own need of it and
+  // its own slow twinkle, the haze of the light round it, the light placed
+  // this frame as the cell's round point, cool and grey when it is dim),
+  // as much of it as the scene's cell leaves showing; the scene's cell in
+  // its own light, drawn as its square or as one of the stars' shapes; and
+  // as much of the dark's own light as the scene lets through it, as the
+  // dark draws it (its stars and round points, not squares). The captions are drawn after the bloom and the tone (TitleEffect,
+  // below), but their cells hide the dark behind them here.
+  display: `
+    uniform sampler2D uDye;
+    uniform sampler2D uLight;
+    uniform highp sampler2D uScene;
+    uniform highp sampler2D uAux;
+    uniform highp sampler2D uTitle;
+    uniform vec2 uCells;
+    uniform vec2 uMargin;
+    uniform vec2 uOrigin;
+    uniform float uCell;
+    uniform vec2 uRes;
+    uniform vec2 uView;
+    uniform vec3 uAuxScale;
+    uniform vec3 uInk;
+    uniform float uGrid;
+    uniform float uGain;
+    uniform float uStar;
+    uniform float uHaze;
+    uniform float uTint;
+    uniform float uTime;
+    uniform float uLightGain;
+    uniform float uLightHaze;
+    uniform float uPassGain;
+    const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
+    float hash (vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+    // a run of the cell's own pixels, [a, b), its edges a pixel's
+    float run (float v, float a, float b) { return smoothstep(a - 0.5, a + 0.5, v) * (1.0 - smoothstep(b - 0.5, b + 0.5, v)); }
+    // the first reel's star at a size, in the cell's pixels, its middle on
+    // the pixel (3, 3) of q: a point; a cross three pixels across; and five;
+    // and the sparkle's corners
+    float starOf (vec2 q, float size) {
+      float s = run(q.x, 3.0, 4.0) * run(q.y, 3.0, 4.0);
+      if (size >= 2.0) s = max(s, 0.55 * max(run(q.x, 2.0, 5.0) * run(q.y, 3.0, 4.0), run(q.x, 3.0, 4.0) * run(q.y, 2.0, 5.0)));
+      if (size >= 3.0) s = max(s, 0.3 * max(run(q.x, 1.0, 6.0) * run(q.y, 3.0, 4.0), run(q.x, 3.0, 4.0) * run(q.y, 1.0, 6.0)));
+      if (size >= 4.0) s = max(s, 0.26 * (run(q.x, 2.0, 3.0) + run(q.x, 4.0, 5.0)) * (run(q.y, 2.0, 3.0) + run(q.y, 4.0, 5.0)));
+      return s;
+    }
+    // how a scene cell's light is drawn: 0 its square, 1 a point, 2 the
+    // cross, 3 the sparkle, 4 a round point as the placed light's are
+    // (0.42 of the cell across its middle, nine's wash front: light
+    // arriving, never a flat square)
+    float shapeOf (float k, vec2 q) {
+      if (k < 0.5) return run(q.x, 0.0, 6.0) * run(q.y, 0.0, 6.0);
+      if (k > 3.5) return 1.0 - smoothstep(2.5, 3.3, length(q - 3.0));
+      return starOf(q, k < 1.5 ? 1.0 : k < 2.5 ? 3.0 : 4.0);
+    }
+    void main () {
+      vec2 frag = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y);
+      vec2 g = (frag - uOrigin) / uCell;
+      vec2 id = floor(g);
+      vec2 f = g - id;
+      vec2 q = frag - uOrigin - id * uCell;
+      float sq = run(q.x, 0.0, 6.0) * run(q.y, 0.0, 6.0);
+      ivec2 ci = clamp(ivec2(id + uMargin), ivec2(0), ivec2(uCells) - 1);
+      vec4 S = texelFetch(uScene, ci, 0);
+      vec4 X = texelFetch(uAux, ci, 0);
+      float T = texelFetch(uTitle, ci, 0).a;
+      float shape = floor(X.r * uAuxScale.x + 0.5);
+      float pass = max(X.g * uAuxScale.y, 0.0);
+      float byLight = clamp(X.b, 0.0, 1.0);
+      float gate = max(X.a * uAuxScale.z, 0.0);
+
+      // the panel's light at the cell's middle, held
+      vec2 p = (id + 0.5) * uCell + uOrigin + uView;
+      vec2 tex = ((p - uOrigin) / uCell + uMargin) / uCells;
+      vec3 dye = max(texture2D(uDye, vec2(tex.x, 1.0 - tex.y)).rgb, 0.0) * uGain;
+      float I = dot(dye, LUMA);
+      // its star (the first reel's, of the screen's own cell). Every cell
+      // has its pinprick, as every cell of the first reel's panel has (its
+      // point is drawn whatever the light, panel-fluid.js: dim, at its
+      // bright floor), and the light it needs grows it from there to a
+      // cross, a longer cross and a sparkle; so the dark is a starfield in
+      // nearly every cell and never the bare grid
+      float need = hash(id + 13.0) < 0.62 ? 0.012 + 1.1 * pow(hash(id), 1.6) : 1e9;
+      float over = I - need;
+      vec2 at = vec2(2.0 + floor(3.0 * hash(id + 3.1)), 2.0 + floor(3.0 * hash(id + 5.3)));
+      float tw = 0.5 + 0.5 * sin(uTime * (0.7 + 1.9 * hash(id + 41.3)) + 6.2832 * hash(id + 7.7));
+      float size = over <= 0.0 ? 0.0 : 1.0 + floor(clamp(over / (0.1 + need) * (0.75 + 0.5 * tw), 0.0, 3.99));
+      vec2 qs = q - at + 3.0;
+      float star = starOf(qs, max(size, 1.0));
+      float bright = (0.4 + 0.6 * clamp(over * 2.5, 0.0, 1.0)) * (0.72 + 0.28 * tw);
+      vec3 hue = dye / max(1e-4, max(dye.r, max(dye.g, dye.b)));
+      vec3 tint = mix(vec3(1.0, 0.97, 0.93), hue, uTint);
+      // the haze of it, smooth across the cells as a nebula is
+      vec2 smooth2 = ((frag + uView - uOrigin) / uCell + uMargin) / uCells;
+      vec3 neb = max(texture2D(uDye, vec2(smooth2.x, 1.0 - smooth2.y)).rgb, 0.0) * uGain;
+      float nI = dot(neb, LUMA);
+      neb = mix(neb, vec3(nI), 0.45);
+      vec3 stars = tint * star * bright * uStar;
+      vec3 sky = neb / (1.0 + 1.5 * nI) * uHaze + stars;
+      // the light placed this frame: the cell's round point of it with its
+      // own shimmer, dim light cool and grey and bright light its colour;
+      // the brightest catch a cross; and between the points, a low haze
+      vec3 L = max(texture2D(uLight, vec2(tex.x, 1.0 - tex.y)).rgb, 0.0) * uLightGain;
+      L *= 0.88 + 0.24 * (0.5 + 0.5 * sin(uTime * (0.9 + 1.7 * hash(id + 17.1)) + 6.2832 * hash(id + 23.9)));
+      float Ly = dot(L, LUMA);
+      float warm = clamp((L.r - L.b) / max(1e-4, max(L.r, max(L.g, L.b))), 0.0, 1.0);
+      float sat = smoothstep(0.01, 0.12 + 0.45 * warm, Ly) * 1.2;
+      vec3 cool = Ly * mix(vec3(0.82, 0.92, 1.18), vec3(1.0, 0.98, 0.96), warm);
+      L = cool + (L - Ly) * sat + (Ly - cool) * min(1.0, sat);
+      float rr = length(f - 0.5);
+      float edge = max(0.06, 1.0 / uCell);
+      float pt = 1.0 - smoothstep(0.42 - edge, 0.42 + edge * 0.5, rr);
+      float arm = smoothstep(0.55, 1.1, Ly) * 0.5 * max(run(qs.x, 1.0, 6.0) * run(qs.y, 3.0, 4.0), run(qs.x, 3.0, 4.0) * run(qs.y, 1.0, 6.0));
+      vec3 Lh = max(texture2D(uLight, vec2(smooth2.x, 1.0 - smooth2.y)).rgb, 0.0) * uLightGain;
+      float Lhy = dot(Lh, LUMA);
+      Lh = mix(Lh, Lhy * vec3(0.86, 0.94, 1.1), 0.45);
+      sky += L * pt * 1.3 + mix(L, vec3(Ly), 0.5) * arm + Lh * uLightHaze;
+
+      // the phone's own cell over it, and the panel's light through it; a
+      // cell that is there only where the panel's light is is as much there
+      // as that light is, all of it: its own light, what it lets through
+      // and what it hides. A cell with a gate is always there, and goes
+      // dark where the ink in the flow at it is over its gate (the flow's
+      // own dye, never the light placed this frame, which is wide enough to
+      // be everywhere), byLight of the way to the unlit cell: a silhouette
+      // coming up only where the ink has reached, and with its veins
+      float there = gate > 0.0 ? 1.0 : mix(1.0, smoothstep(0.01, 0.07, I + Ly), byLight);
+      float m = shapeOf(shape, q);
+      vec3 own = max(S.rgb, 0.0) * m * there;
+      // what a window lets through is the panel as it is drawn there (the
+      // first reel's passthrough, 'behind = col - cell ink grid'): its
+      // stars, its round points of the placed light and its haze, in their
+      // own shapes, never the raw ink and light as a filled square (that
+      // was a lit smoke of squares wherever a page or a sky was a window)
+      // (its pinpricks as they are, at most: a window's gain is for the
+      // light's round points, which are smaller than the square it fills)
+      vec3 lit = (pass * uPassGain * (sky - stars) + min(pass * uPassGain, 1.0) * stars) * there;
+      float hide = clamp(max(S.a * there, T), 0.0, 1.0);
+      vec3 col = sq * uInk * uGrid + sky * (1.0 - hide) + own + lit;
+      if (gate > 0.0) {
+        col = mix(col, sq * uInk * uGrid, byLight * smoothstep(gate, 2.0 * gate + 0.002, I));
+      }
+      gl_FragColor = vec4(col, 1.0);
+    }`,
+}
+
+// the pixels in flight (panel-fluid.js): points of light in the panel's px
+const POINT_VERT = /* glsl */ `
+  attribute vec3 tint;
+  uniform vec2 uLo;
+  uniform vec2 uSpan;
+  varying vec3 vTint;
+  void main () {
+    vec2 uv = (position.xy - uLo) / uSpan;
+    gl_Position = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);
+    gl_PointSize = 2.0;
+    vTint = tint;
+  }
+`
+const POINT_FRAG = /* glsl */ `
+  precision highp float;
+  varying vec3 vTint;
+  void main () {
+    vec2 d = abs(gl_PointCoord - 0.5) * 2.0;
+    gl_FragColor = vec4(vTint * max(0.0, 1.0 - d.x) * max(0.0, 1.0 - d.y), 1.0);
+  }
+`
+
+// ── the captions ────────────────────────────────────────────────────────────
+// The first reel's words were laid over its picture, crisp, with a little
+// warm light round them (reel.css `.rl-line`), and the bloom never touched
+// them. So here: drawn into their cells after the bloom and the tone, as the
+// page laid them over its canvas, so chalk is chalk; each lit cell its whole
+// seven pixels, as the first reel's CellLine filled its cells (`fillRect` c
+// by c), so a caption is solid pixel letters and never a dot matrix sign
+// (the phone's own words keep the panel's six pixel squares and their gaps,
+// which is how a caption and a screen word differ), and round them the two
+// drops of warm light worked out as the page worked them out, in the
+// screen's own colour space over the dark, and taken to light.
+const TITLE_FRAG = /* glsl */ `
+  uniform highp sampler2D uR3Title;
+  uniform highp sampler2D uR3TitleSoft;
+  uniform vec2 uR3Cells;
+  uniform vec2 uR3Margin;
+  uniform vec2 uR3Origin;
+  uniform float uR3Cell;
+  uniform vec3 uR3Warm;
+  uniform float uR3Glow;
+  uniform float uR3On;
+  float r3run (float v, float a, float b) { return smoothstep(a - 0.5, a + 0.5, v) * (1.0 - smoothstep(b - 0.5, b + 0.5, v)); }
+  vec3 r3lin (vec3 c) { return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, vec3(lessThanEqual(c, vec3(0.04045)))); }
+  void mainImage(const in vec4 inputColor, const in vec2 uv, out vec4 outputColor) {
+    if (uR3On < 0.5) { outputColor = inputColor; return; }
+    vec2 frag = vec2(gl_FragCoord.x, resolution.y - gl_FragCoord.y);
+    vec2 g = (frag - uR3Origin) / uR3Cell;
+    vec2 id = floor(g);
+    vec2 q = frag - uR3Origin - id * uR3Cell;
+    float sq = r3run(q.x, 0.0, 7.0) * r3run(q.y, 0.0, 7.0);
+    ivec2 ci = clamp(ivec2(id + uR3Margin), ivec2(0), ivec2(uR3Cells) - 1);
+    vec4 T = max(texelFetch(uR3Title, ci, 0), 0.0);
+    vec2 soft = texture2D(uR3TitleSoft, (g + uR3Margin) / uR3Cells).rg;
+    float a3 = 0.32 * clamp(soft.r, 0.0, 1.0);
+    float a12 = 0.12 * clamp(soft.g, 0.0, 1.0);
+    float a = a3 + a12 * (1.0 - a3);
+    // laid over the frame as the page laid its words: the light round them
+    // under them, and the cells over both
+    float over = sq * clamp(T.a, 0.0, 1.0);
+    outputColor = vec4((inputColor.rgb + r3lin(a * uR3Warm) * uR3Glow) * (1.0 - over) + sq * T.rgb, inputColor.a);
+  }
+`
+class TitleEffect extends Effect {
+  constructor(uniforms) {
+    super('R3TitleEffect', TITLE_FRAG, { blendFunction: BlendFunction.NORMAL, uniforms: new Map(Object.entries(uniforms).map(([k, v]) => [k, new THREE.Uniform(v)])) })
+  }
+}
+
+// ── the layers' textures ────────────────────────────────────────────────────
+// A layer a texel a cell, row 0 the panel's top row (flipY false): floats,
+// or if the card cannot take them halves, or bytes clamped to 0..1
+const toHalf = THREE.DataUtils.toHalfFloat
+const ZERO = new Float32Array(N * 4)
+function layerTex(kind, filter) {
+  const type = kind === 'float' ? THREE.FloatType : kind === 'half' ? THREE.HalfFloatType : THREE.UnsignedByteType
+  const data = kind === 'float' ? new Float32Array(N * 4) : kind === 'half' ? new Uint16Array(N * 4) : new Uint8Array(N * 4)
+  const t = new THREE.DataTexture(data, CELLS.cw, CELLS.ch, THREE.RGBAFormat, type)
+  t.minFilter = filter
+  t.magFilter = filter
+  t.flipY = false
+  t.generateMipmaps = false
+  t.colorSpace = THREE.NoColorSpace
+  t.needsUpdate = true
+  t.kind = kind
+  return t
+}
+function fill(tex, src) {
+  const d = tex.image.data
+  if (tex.kind === 'float') d.set(src)
+  else if (tex.kind === 'half') for (let i = 0; i < d.length; i++) d[i] = toHalf(src[i])
