+// ── reel 3 · the screens ────────────────────────────────────────────────────
+//
+// The phone's own screens, set again in the panel's cells: the hook's bar,
+// the group chat, the note sheet's done state, the lock screen and the
+// notification, the note in the vault and its ask, the reveal
+// strip's countdown, the slot, the keepsake's notes, the music player, and
+// the lockup. Each is the product's structure and the product's copy (the
+// words are reel3-time.js TEXT, never typed here), its colours its skin's
+// (looks.js `skinOf`), its glyphs the phone's (looks.js PIX), and each says
+// where in the product it was copied from. The chat, the lock screen and the
+// player are anybody's phone and carry no brand: nothing of the product is
+// on them.
+//
+// Every painter draws its screen whole and at full backlight, as the phone
+// shows it with nothing happening to it. What happens to it is the scene's:
+// the power-on, the relaxation, the retention, the wash, the three-step out
+// come in as a level (`k`) or are done to the buffer after
+// (reel3-CONTRACT.md 10). A level of nothing paints nothing, and what a
+// screen hides of the dark behind it goes with its light (`a = min(1, k)`),
+// so a screen coming up out of the black hides the stars as it comes, never
+// before.
+//
+// The glass, wherever a note is on one (`glass`), is the product's
+// (screen.css 84-96, 259-262): the panel the radial from the backlight's hot
+// spot, 80 % across and 66 % down, `hi` to `mid` at 52 % to `lo`, at the
+// backlight's level; the status band its two dark glasses `top` to `top2`
+// down its rows; the keys' band `bot`. The band's words and glyphs are in the
+// skin's `lit`, the body's in its `ink`. A glass's four corner cells are
+// left dark, the chamfer the product's bubbles and keys have, so a glass is
+// never a hard slab of cells. The product's screens are taller (1 : 1.16)
+// and set their words smaller; here a glass is as wide as the safe zone
+// lets it be (117 cells) and as tall as its words at C need, which is the
+// treatment's one stylisation of all of them (reel3-TREATMENT.md, the
+// changelog's `640 is declined`). films/reel3-ui-ref.jsx photographs the
+// product's own screens at these same rects, to be held beside the bench's
+// stills (frames 3100 on, `debug` below).
+
+import { TEXT, LAYOUT, S, DIM, hexOf, hookHead } from './reel3-time.js'
+import { lin, rect as fillRect, outline, type, say, glyph, lean, typeLayout, redraw, invert, on, stepsOut, hash, rowsOf } from './reel3-cells.js'
+import { skinOf } from '../../wall/looks.js'
+import { MARK, LOCKUP, wordCells } from '../../wall/brand.js'
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+
+// The words this module cuts that are not in TEXT, for the frame to warm
+// while the face is in (reel3.jsx `words`): the slot's `@`
+export const WORDS = ['@']
+
+// ── colours ─────────────────────────────────────────────────────────────────
+// A skin's hex, as the product's stylesheet mixes it: CSS gradients mix the
+// sRGB numbers, not the light (the legacy syntax every screen.css gradient
+// is in), so a stop between two hexes is mixed as numbers and then taken to
+// linear light, as the page would have shown it
+const SRGB = new Map()
+const srgbOf = (hex) => { let v = SRGB.get(hex); if (!v) { v = [1, 3, 5].map((n) => parseInt(hex.slice(n, n + 2), 16)); SRGB.set(hex, v) } return v }
+const lin1 = (c) => { const x = c / 255; return x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4 }
+const mixHex = (a, b, u) => { const A = srgbOf(a); const B = srgbOf(b); return [0, 1, 2].map((n) => lin1(A[n] + (B[n] - A[n]) * u)) }
+const skin = (tint) => skinOf(tint)
+// a role's light, ×k
+const times = (rgb, k) => [rgb[0] * k, rgb[1] * k, rgb[2] * k]
+
+// ── the glass ───────────────────────────────────────────────────────────────
+// A note's glass over `rect` (screen.jsx 620-675, screen.css 84-96 and
+// 259-262): its status band `band` = [j0, j1] in `top` to `top2` down its
+// rows, its keys' band `keys` = [j0, j1] in `bot`, and every other row the
+// panel's radial, `120% 95% at 80% 66%`, `hi` to `mid` at 52 % to `lo`. All
+// of it at the backlight `back` (0.5 linear for every lit glass in the film,
+// so it never blows out under the bloom), ×k. Each cell is written whole and
+// hides what is behind it; the four corners are left as they were. The
+// colours are worked out once a glass and kept
+const GLASS = new Map()
+function glassCells(r, tint, band, keys, lift = 0) {
+  const key = `${r}|${tint}|${band}|${keys}|${lift}`
+  let g = GLASS.get(key)
+  if (g) return g
+  const s = skin(tint)
+  const [i0, j0, i1, j1] = r
+  const W = i1 - i0 + 1
+  const H = j1 - j0 + 1
+  // the hot spot and the ellipse the stops are laid along, in cells
+  const cx = i0 + 0.8 * W
+  const cy = j0 + 0.66 * H
+  const rx = 1.2 * W
+  const ry = 0.95 * H
+  const out = []
+  for (let j = j0; j <= j1; j++) {
+    for (let i = i0; i <= i1; i++) {
+      if ((i === i0 || i === i1) && (j === j0 || j === j1)) continue
