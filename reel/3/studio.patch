+#!/usr/bin/env node
+// reel3-sounds.mjs: the third reel's sounds, effects only, for a song of
+// someone's own to be laid over them (reel3-TREATMENT.md B3, CUES in
+// app/src/studio/parts/reel3-time.js).
+//
+// Made against the third reel's clock from the same recordings and the same
+// hall as the first two reels' (studio-sounds.mjs, reel2-sounds.mjs, whose
+// parts this shares; scripts/sounds/NOTICE.md says where each recording is
+// from), and the phone's keys, its haptic and the room's hum made here. All
+// of it on B. The foley is dry, as a phone in a quiet room is: only the
+// organ under his run, the reversed cymbal the send lands on, the gong and
+// the bowed cymbal at nine go to the hall.
+//
+//   0      the night air, low; her arrival a piano's low B, the organ's B
+//          swelling under his run, and its end a piano's F sharp
+//   2.67   the room's hum; his line in, a buzz in the hand; the deletes, a
+//          key a press and heavier as the repeat jumps to words; the hum
+//          stops with the backlight
+//   6.67   the power-on click; the send's light drawn in, a cymbal
+//          backwards to where it lands; the side button's click
+//   10     the charger: glass, B then F sharp. Later Bee's line, a muted B
+//  13.33   two taps; the half press with nothing under it, heard as an
+//          absence; keep it, a tap and a soft drum
+//  18.67   the count's two ticks; at nine everything stops, the air too
+//  24.33   the slot's flicker in four tiny ticks, the press, the gong as the
+//          wash goes, a grain of it every step panned where the front is,
+//          and the bowed cymbal over it
+//  26.33   her six footfalls, a second apart, three under his note and
+//          three on the art; the player's stop at 51:00; the door's latch,
+//          and the air comes back under the name; the master out from 33.07
+//
+//   node scripts/reel3-sounds.mjs [out.wav] [--offset 80]     48 kHz, 16 bit
+//
+// `--offset 80` is hook B's: every sound eighty frames later, the film that
+// much longer, and the night air under its cold open from its first frame.
+// The whole is brought to -30 LUFS (EBU R128, ffmpeg's ebur128), with a
+// ceiling two decibels under full scale.
+import { spawnSync } from 'node:child_process'
+import { writeFileSync, readFileSync, mkdirSync, rmSync, mkdtempSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { tmpdir } from 'node:os'
+import { fileURLToPath } from 'node:url'
+import { MS, S, ms as msOf, GRID } from '../app/src/studio/parts/reel3-time.js'
+import { turnStep } from '../app/src/studio/parts/reel3-wash.js'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+const args = process.argv.slice(2)
+const oi = args.indexOf('--offset')
+const OFFSET_F = oi >= 0 ? Number(args[oi + 1]) : 0
+const out = args.filter((a, i) => !a.startsWith('--') && !(oi >= 0 && i === oi + 1))[0] || join(root, 'reel/3/assets/sound.wav')
+if (!Number.isInteger(OFFSET_F) || OFFSET_F < 0) { console.error('reel3-sounds: --offset is a whole number of frames'); process.exit(1) }
+
+const SR = 48000
+const TAIL = 3
+const LEN = MS + msOf(OFFSET_F)
+const N = Math.round((LEN / 1000 + TAIL) * SR)
+const TAU = Math.PI * 2
+const sec = (s) => Math.round(s * SR)
+// a frame of film A to its moment in this file's ms (hook B's offset in it)
+const F = (f) => msOf(f + OFFSET_F)
+const at = (ms) => Math.round((ms / 1000) * SR)
+const db = (d) => 10 ** (d / 20)
+const SEMI = 2 ** (1 / 12)
+const work = mkdtempSync(join(tmpdir(), 'celestual-sounds-'))
+const LUFS = -30
+
+// a seeded random, so the sounds are the same every time they are made
+let seed = 0x3c6ef372
+const rnd = () => { seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5; return ((seed >>> 0) / 4294967296) * 2 - 1 }
+const r01 = (n) => ((Math.sin(n * 127.1 + 311.7) * 43758.5453) % 1 + 1) % 1
+
+// ── where everything goes ───────────────────────────────────────────────────
+// two buses, the sound itself and what of it goes to the hall
+const DRY = { L: new Float32Array(N), R: new Float32Array(N) }
+const WET = { L: new Float32Array(N), R: new Float32Array(N) }
+function add(k, l, r, send) {
+  if (k < 0 || k >= N) return
+  DRY.L[k] += l; DRY.R[k] += r
+  if (send) { WET.L[k] += l * send; WET.R[k] += r * send }
+}
+const panOf = (pan) => { const a = ((pan + 1) * Math.PI) / 4; return [Math.cos(a) * Math.SQRT2, Math.sin(a) * Math.SQRT2] }
+
+function biquad(type, fc, q = 0.707) {
+  const w = (TAU * Math.min(fc, SR * 0.45)) / SR
+  const al = Math.sin(w) / (2 * q)
+  const c = Math.cos(w)
+  let b0; let b1; let b2
+  const a0 = 1 + al; const a1 = -2 * c; const a2 = 1 - al
+  if (type === 'hp') { b0 = (1 + c) / 2; b1 = -(1 + c); b2 = b0 }
+  if (type === 'lp') { b0 = (1 - c) / 2; b1 = 1 - c; b2 = b0 }
+  if (type === 'bp') { b0 = al; b1 = 0; b2 = -al }
+  const k = [b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0]
+  let x1 = 0; let x2 = 0; let y1 = 0; let y2 = 0
+  return (x) => { const y = k[0] * x + k[1] * x1 + k[2] * x2 - k[3] * y1 - k[4] * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; return y }
+}
+// a high pass and a low pass, either left out at 0 (each twice, so a 300 Hz
+// low pass on the air is a real one)
+function band(hp, lp, poles = 1) {
+  const f = []
+  for (let p = 0; p < poles; p++) {
+    if (hp) f.push(biquad('hp', hp))
+    if (lp) f.push(biquad('lp', lp))
+  }
+  return (x) => { for (const g of f) x = g(x); return x }
+}
+
+// ── the recordings ──────────────────────────────────────────────────────────
+// each as it was recorded, both its channels at the film's rate, brought to
+// one height (its loudest sample at full scale), so a gain below is a gain
+function recording(name) {
+  const r = spawnSync('ffmpeg', ['-v', 'error', '-i', join(root, 'scripts/sounds', `${name}.ogg`), '-ac', '2', '-ar', String(SR), '-f', 'f32le', '-'], { maxBuffer: 1 << 30 })
+  if (r.status !== 0) throw new Error(`reel3-sounds: the recording ${name}`)
+  const n = r.stdout.length / 8
+  const L = new Float32Array(n)
+  const R = new Float32Array(n)
+  let peak = 0
+  for (let i = 0; i < n; i++) {
+    L[i] = r.stdout.readFloatLE(i * 8)
+    R[i] = r.stdout.readFloatLE(i * 8 + 4)
+    peak = Math.max(peak, Math.abs(L[i]), Math.abs(R[i]))
+  }
+  for (let i = 0; i < n; i++) { L[i] /= peak; R[i] /= peak }
+  // and where it starts: the first sample a twentieth of its loudest, less
+  // a millisecond (the tap has 30 ms of nothing before it)
+  let on = 0
+  while (on < n && Math.max(Math.abs(L[on]), Math.abs(R[on])) < 0.05) on++
