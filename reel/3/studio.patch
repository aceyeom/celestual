+// ── the face ────────────────────────────────────────────────────────────────
+// Words are cut into cells by the product's own (pixtype.js `typeCells`):
+// Jersey 10 at its native pitch, one pixel of its grid a cell. In node,
+// where there is no canvas to cut a face from, the check script hands in a
+// cutter of its own (`cutWith`)
+let cut = typeCells
+export function cutWith(fn) { cut = fn || typeCells }
