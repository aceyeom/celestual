+// ── glyphs ──────────────────────────────────────────────────────────────────
+// The phone's glyphs (looks.js PIX: pen, check, ant, bata0…bata4, …) and
+// three of the film's own, drawn on the same grid: the bolt beside the
+// charge on wednesday (5 × 9, turned on itself half way round), and the
+// player's play and stop (5 × 5)
+export const GLYPHS = {
+  bolt: ['...XX', '..XX.', '..XX.', '.XX..', 'XXXXX', '..XX.', '.XX..', '.XX..', 'XX...'],
+  play: ['X....', 'XXX..', 'XXXXX', 'XXX..', 'X....'],
+  stop: ['XXXXX', 'XXXXX', 'XXXXX', 'XXXXX', 'XXXXX'],
