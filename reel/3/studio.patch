index 0000000..e96169b
--- /dev/null
+++ b/app/src/studio/parts/reel3-motion.js
@@ -0,0 +1,268 @@
+// ── reel 3 · motion ─────────────────────────────────────────────────────────
+//
+// The film's motion and its colour turns, as functions of the moment and
+// nothing else. Each library here has one job a pair of stills can show:
+//
+//   motion-dom   `spring`: the thread's scroll, the notification rising, the
+//                half press, her light leaning past the pin, and the art's
+//                live wallpaper kicked by each footfall. A real spring, read
+//                at a moment (`.next(ms).value`), never stepped
+//   gsap         the paused master timeline (`track`), CustomEase for the
+//                product's curves (`easeOf`), and MotionPathPlugin for the
+//                rose's way across the art (`routeAt`, `stepAt`)
+//   culori       OKLCH: the crystal's hue drifting as it relaxes, the
+//                bouquet's first rose, the rose page, a photograph's print
+//                tone (`oklchMix`, `relaxTint`, `roseRamp`, `printTone`)
+//
+// Nothing here keeps anything from one frame to the next but caches of pure
+// computations keyed by their inputs, and nothing touches the page, so node
+// reads it as the page does (scripts/reel3-check.mjs asserts the springs
+// against the treatment's numbers with it). Colours come in and go out as
+// linear light, [r, g, b], as the cells hold them (reel3-cells.js).
+
+import gsap from 'gsap'
+import { CustomEase } from 'gsap/CustomEase'
+import { MotionPathPlugin } from 'gsap/MotionPathPlugin'
+import { spring } from 'motion-dom'
+import { convertLrgbToOklab, convertOklabToLrgb } from 'culori'
+import { SPRINGS, EASES, ROUTE, ROUTE_AT, ROUTE_NINE, COL, LAYOUT, footWay, linOf, ms } from './reel3-time.js'
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+
+// a cache that forgets everything rather than grow without end: what it
+// keeps is only ever a pure function of its key, so forgetting is free
+function memo(fn, size = 4096) {
+  const m = new Map()
+  return (key, ...args) => {
+    let v = m.get(key)
+    if (v === undefined) {
+      if (m.size >= size) m.clear()
+      v = fn(...args)
+      m.set(key, v)
+    }
+    return v
+  }
+}
+
+// ── the springs (motion-dom) ────────────────────────────────────────────────
+// A spring is a generator of its own moment: `.next(ms)` answers where it is
+// that long after it was let go, worked out from the start each time, so a
+// frame asked out of order is the same frame. One generator for each set of
+// options, kept. The value it hands back is a state object it reuses, so it
+// is read at once.
+const GENS = new Map()
+function generatorOf(o) {
+  const velocity = o.velocity || 0
+  const mass = o.mass || 1
+  const key = `${o.from}|${o.to}|${velocity}|${o.stiffness}|${o.damping}|${mass}`
+  let g = GENS.get(key)
+  if (!g) {
+    g = spring({ keyframes: [o.from, o.to], velocity, stiffness: o.stiffness, damping: o.damping, mass, restDelta: 0.0005, restSpeed: 0.005 })
+    GENS.set(key, g)
+  }
+  return g
+}
+// where a spring `o = {from, to, velocity, stiffness, damping, mass}` is
+// `tMs` after its start; before it, where it starts
+export function springAt(o, tMs) {
+  if (!(tMs > 0)) return o.from
+  return generatorOf(o).next(tMs).value
+}
+
+// The film's springs by name (reel3-time.js SPRINGS), at frame `f` (a float
+// is fine). Before its `at`, its `from`. The parallax is one spring a
+// footfall, each with its own kick from its own frame, summed; the release
+// lets go of the press from wherever the press is when it is let go
+let releaseFrom = null
+const fromOf = (name, o) => {
+  if (o.from !== 'press') return o.from
+  if (releaseFrom == null) releaseFrom = springOf('press', SPRINGS[name].at)
+  return releaseFrom
+}
+export function springOf(name, f) {
+  const o = SPRINGS[name]
+  if (!o) throw new Error(`reel3-motion: no spring ${name}`)
+  const from = fromOf(name, o)
+  if (Array.isArray(o.at)) {
+    let v = from
+    o.at.forEach((at, k) => {
+      if (f > at) v += springAt({ ...o, from, velocity: o.velocity[k] }, ms(f - at)) - from
+    })
+    return v
+  }
+  if (!(f > o.at)) return from
+  return springAt({ ...o, from }, ms(f - o.at))
+}
+
+// ── the curves (gsap, CustomEase) ───────────────────────────────────────────
+// Registered once, on first use and not at load: the product's power-on
+// ramp, its two eases and its sweep (reel3-time.js EASES), beside every ease
+// gsap knows by name. The progress going in is held to 0..1: gsap's own
+// eases wrap past 1 (`sine.inOut` at 1.5 is 0.5), and a behaviour asked
+// before its start or after its end means its ends
+let plugged = false
+function plug() {
+  if (plugged) return
+  gsap.registerPlugin(CustomEase, MotionPathPlugin)
+  for (const [k, d] of Object.entries(EASES)) CustomEase.create(k, d)
+  plugged = true
+}
+const EASE = new Map()
+export function easeOf(name = 'power2.inOut') {
+  let e = EASE.get(name)
+  if (!e) {
+    plug()
+    const raw = gsap.parseEase(name)
+    if (typeof raw !== 'function') throw new Error(`reel3-motion: no ease ${name}`)
+    e = (k) => raw(clamp(Number.isFinite(k) ? k : k > 0 ? 1 : 0))
+    EASE.set(name, e)
+  }
+  return e
+}
+
+// ── the master timeline (gsap) ──────────────────────────────────────────────
+// `build(tl, o)` lays tweens on a paused timeline, at positions in seconds of
+// the film's A-time, on the plain object `o` (a copy of `init`); reading it
+// at a moment seeks the timeline there and hands back a copy. Run once to
+// its end and back when it is built, so every tween has read where it
+// starts in the timeline's own order, whatever moment is asked for first
+export function track(build, init = {}) {
+  plug()
+  const o = { ...init }
+  const tl = gsap.timeline({ paused: true })
+  build(tl, o)
+  tl.totalTime(tl.duration(), true)
+  tl.totalTime(0, true)
+  return (tMs) => {
+    const s = Number.isFinite(tMs) ? tMs / 1000 : 0
+    tl.totalTime(clamp(s, 0, tl.duration()), true)
+    return { ...o }
+  }
+}
+
+// ── her way (gsap, MotionPathPlugin) ────────────────────────────────────────
+// Her two ways, measured once (reel3-time.js ROUTE_NINE, ROUTE): up the
+// dark under his note at nine, and from her walker at the end of the
+// scrubber up across the art through its light to the gap between its sun
+// and the lockup's star; a point `u` of a way along it by length, in frame
+// px. `stepAt(n)` is ROUTE's n-th footfall point (ROUTE_AT), and `footAt(k)`
+// where footfall k of S.coda.steps falls, on whichever way it is on
+const RAW = new Map()
+function rawOf(path) {
+  let r = RAW.get(path)
+  if (!r) {
+    plug()
+    r = MotionPathPlugin.getRawPath(path)
+    MotionPathPlugin.cacheRawPathMeasurements(r)
+    RAW.set(path, r)
+  }
+  return r
+}
+const along = (path, u) => {
+  const p = MotionPathPlugin.getPositionOnPath(rawOf(path), clamp(Number.isFinite(u) ? u : 0))
+  return { x: p.x, y: p.y }
+}
+export const routeAt = (u) => along(ROUTE, u)
+export const nineAt = (u) => along(ROUTE_NINE, u)
+export const stepAt = (n) => routeAt(ROUTE_AT[n])
+export function footAt(k) {
+  const w = footWay(k)
+  if (w.u >= 1 && w.way === 'art') return { x: LAYOUT.name.last[0], y: LAYOUT.name.last[1] }
+  return w.way === 'nine' ? nineAt(w.u) : routeAt(w.u)
+}
+
+// ── the colours (culori, OKLCH) ─────────────────────────────────────────────
+// Linear light to OKLCH and back, through culori's own Oklab. A colour with
+// next to no chroma is grey and its hue means nothing, so it is left
+// without one, and a mix with it takes the other colour's: a grey turning
+// rose turns only in chroma and lightness, and never sweeps through a hue
+// that was rounding error. Hues mix the short way round
+const GREY = 1e-4
+const TAU = Math.PI * 2
+function lchOf(rgb) {
+  const o = convertLrgbToOklab({ r: rgb[0], g: rgb[1], b: rgb[2] })
+  const c = Math.hypot(o.a, o.b)
+  return { l: o.l, c, h: c < GREY ? null : Math.atan2(o.b, o.a) }
+}
+function rgbOfLch({ l, c, h }) {
+  const hh = h == null ? 0 : h
+  const o = convertOklabToLrgb({ l, a: c * Math.cos(hh), b: c * Math.sin(hh) })
+  // a mix may step a hair outside the screen's colours; light is never less
+  // than none
+  return [Math.max(0, o.r), Math.max(0, o.g), Math.max(0, o.b)]
+}
+const arc = (from, to) => ((((to - from + Math.PI) % TAU) + TAU) % TAU) - Math.PI
+function mixLch(A, B, k) {
+  const ha = A.h ?? B.h
+  const hb = B.h ?? A.h
+  return {
+    l: A.l + (B.l - A.l) * k,
+    c: A.c + (B.c - A.c) * k,
+    h: ha == null ? null : ha + arc(ha, hb) * k,
+  }
+}
+const LIN = new Map()
+const linHex = (hex) => { let v = LIN.get(hex); if (!v) { v = linOf(hex); LIN.set(hex, v) } return v }
+
+// a colour as OKLCH, `h` in degrees (null for a grey): for the checks
+export function oklchOf(rgbLin) {
+  const o = lchOf(rgbLin)
+  return { l: o.l, c: o.c, h: o.h == null ? null : (((o.h * 180) / Math.PI) % 360 + 360) % 360 }
+}
+
+// two hexes mixed `k` of the way in OKLCH, as linear light
+const mixMemo = memo((a, b, k) => rgbOfLch(mixLch(lchOf(linHex(a)), lchOf(linHex(b)), k)))
+export function oklchMix(hexA, hexB, k) {
+  const kk = clamp(k)
+  if (kk <= 0) return [...linHex(hexA)]
+  if (kk >= 1) return [...linHex(hexB)]
+  return [...mixMemo(`${hexA}|${hexB}|${kk}`, hexA, hexB, kk)]
+}
+
+// The liquid crystal relaxing after the side button (reel3-TREATMENT.md
+// shot 3): as a lit cell falls, its hue turns toward 250 (the cold blue a
+// panel's crystal goes as it lets go) by `k`, and its chroma to 0.6 of
+// itself by k = 1, its lightness kept; the cell's fall itself is the
+// caller's (cells.relax). A grey has no hue to turn
+const RELAX_H = (250 * Math.PI) / 180
+export function relaxTint(rgbLin, k) {
+  const kk = clamp(k)
+  if (kk <= 0) return [rgbLin[0], rgbLin[1], rgbLin[2]]
+  const o = lchOf(rgbLin)
+  if (o.h == null) return [rgbLin[0], rgbLin[1], rgbLin[2]]
+  return rgbOfLch({ l: o.l, c: o.c * (1 - 0.4 * kk), h: o.h + arc(o.h, RELAX_H) * kk })
+}
+
+// The bouquet's first rose (reel3-PLAN.md, the roses): from the grey a
+// `night` print lights at its top, `night.lit`, at k = 0, to the rose's
+// panel colour `rose.mid` at k = 1, through OKLCH, as linear light. At 1 it
+// is exactly `rose.mid`, which is also the keepsake's rose page
+const rampMemo = memo((k) => rgbOfLch(mixLch(lchOf(linHex(COL.night.lit)), lchOf(linHex(COL.rose.mid)), k)))
+export function roseRamp(k) {
+  const kk = clamp(k)
+  if (kk <= 0) return [...linHex(COL.night.lit)]
+  if (kk >= 1) return [...linHex(COL.rose.mid)]
+  return [...rampMemo(kk, kk)]
+}
+
+// A photograph's print tone (reel3-photo.js): its luminance `L` (0..1) to a
+// colour of the skin it is printed in, from the skin's `ink` at 0 through
+// its `mid` to its `lit` at 1, through OKLCH, as linear light. `skin` is
+// 'white' (the dance, his colour) or 'night' (the roses, the sea)
+// (asked for every cell of a photograph every frame, so kept a skin at a
+// time by the level itself, which a photograph has only eight or nine of)
+const TONES = new Map()
+export function printTone(L, skin = 'white') {
+  let m = TONES.get(skin)
+  if (!m) {
+    const s = COL[skin]
+    if (!s || !s.ink) throw new Error(`reel3-motion: no print skin ${skin}`)
+    const ink = lchOf(linHex(s.ink))
+    const mid = lchOf(linHex(s.mid))
+    const lit = lchOf(linHex(s.lit))
+    m = memo((k) => (k <= 0.5 ? rgbOfLch(mixLch(ink, mid, k / 0.5)) : rgbOfLch(mixLch(mid, lit, (k - 0.5) / 0.5))))
+    TONES.set(skin, m)
+  }
+  const k = clamp(Number.isFinite(L) ? L : 0)
+  return [...m(k, k)]
+}
diff --git a/app/src/studio/parts/reel3-panel.js b/app/src/studio/parts/reel3-panel.js
new file mode 100644
index 0000000..5d2de00
--- /dev/null
+++ b/app/src/studio/parts/reel3-panel.js
@@ -0,0 +1,917 @@
+// ── the third reel's panel ──────────────────────────────────────────────────
+//
+// The whole of the third reel is one phone's screen, and this is its panel:
+// 154 by 274 cells of seven pixels, six lit and one dark, fixed to the frame
+// (reel3-time.js GRID). It is the first reel's living dark (panel-fluid.js,
+// forked here, its solver's notice kept at the foot of the file) with the
+// phone's own cells drawn into it. Three layers of cells come up from the
+// CPU each frame, a texel a cell:
+//
+//   the scene   what the phone shows, in its own light: a cell's colour, how
+//               much of the dark behind it it hides, the shape its light is
+//               drawn in (its square, or the first reel's star shapes), how
+//               much of the panel's own light comes through it (a
+//               photograph's light parts), how much it is there only where
+//               that light is, and the rose in the flow a cell waits for
+//               before it goes dark (the sea's people against the rose)
+//   the titles  the film's captions, chalk, cut into the same cells, with
+//               the warm drop of light the first reel's words had round them
+//   the light   the light the story places on the panel this frame, as the
+//               first reel placed it (reel-aura.js's sources and hearts)
+//
+// and under them the flow: light moving in the panel as ink moves in water,
+// stepped a sixtieth of a second at a time from the film's start, its stars
+// coming where the light has drifted. The hand holding the phone moves only
+// where the flow, the placed light and the stars are read (`view`); the
+// cells themselves never move, as a screen's pixels never do.
+//
+// What is the first reel's, kept as it was: the stable fluid (Stam's, after
+// Pavel Dobryakov's passes), the light pass, the stars with their own need
+// of light and their own twinkle, the haze, the placed light's round points
+// with the eye's cool grey for dim light (Purkinje), postprocessing's mipmap
+// bloom and its neutral tone mapping. What is gone: the photograph drawn
+// smooth over the panel, and the shade boxes under the words. Photographs
+// reach this panel only as cells, through the scene (reel3-photo.js).
+//
+// It is drawn from `t` and nothing else: the flow is re-simulated from its
+// first step whenever the film goes back, and every layer is uploaded whole
+// every frame.
+import * as THREE from 'three'
+import { EffectComposer, RenderPass, EffectPass, BloomEffect, ToneMappingEffect, ToneMappingMode, Effect, BlendFunction } from 'postprocessing'
+import { MAXS, MAXPTS, SOURCE, linear } from './panel-fluid.js'
+import { GRID, COL, linOf } from './reel3-time.js'
+
+export { MAXS, MAXPTS, SOURCE, linear }
+
+// the panel's cells on the frame: its first cell's corner, a cell's size,
+// the margin of cells kept past the frame's edges, and the whole of it
+const CELLS = { x: GRID.GX, y: GRID.GY, c: GRID.C, margin: GRID.MARGIN, cw: GRID.CW, ch: GRID.CH }
+const N = CELLS.cw * CELLS.ch
+// the first reel's titles had round them `drop-shadow(0 0 3px ...)` and
+// `drop-shadow(0 0 12px ...)` in this warm white, at .32 and .12 (reel.css
+// `.rl-line`). The wide one is a blur of the titles' cells, worked out here
+// a cell at a time (the narrow one is the cells' own bilinear spread)
+const WIDE_SIGMA = 6 / GRID.C
+const WIDE = (() => {
+  const k = [-3, -2, -1, 0, 1, 2, 3].map((x) => Math.exp(-(x * x) / (2 * WIDE_SIGMA * WIDE_SIGMA)))
+  const s = k.reduce((a, b) => a + b, 0)
+  return k.map((x) => x / s)
+})()
+// the first reel's words were whole cells, seven pixels a side, and their
+// light round them was theirs; the captions here are whole cells too
+// (TITLE_FRAG), so the light round them is theirs as it is
+const COVER = 1
+const CHALK_Y = (() => { const [r, g, b] = linOf(COL.chalk); return 0.2126 * r + 0.7152 * g + 0.0722 * b })()
+
+const VERT = /* glsl */ `
+  uniform vec2 texelSize;
+  varying vec2 vUv;
+  varying vec2 vL;
+  varying vec2 vR;
+  varying vec2 vT;
+  varying vec2 vB;
+  void main () {
+    vUv = position.xy * 0.5 + 0.5;
+    vL = vUv - vec2(texelSize.x, 0.0);
+    vR = vUv + vec2(texelSize.x, 0.0);
+    vT = vUv + vec2(0.0, texelSize.y);
+    vB = vUv - vec2(0.0, texelSize.y);
+    gl_Position = vec4(position.xy, 0.0, 1.0);
+  }
+`
+const HEAD = /* glsl */ `
+  precision highp float;
+  precision highp sampler2D;
+  varying vec2 vUv;
+  varying vec2 vL;
+  varying vec2 vR;
+  varying vec2 vT;
+  varying vec2 vB;
+`
+// the solver's passes and the light pass, as panel-fluid.js has them
+const FRAG = {
+  splat: `
+    uniform sampler2D uTarget;
+    uniform vec2 uPoint;
+    uniform vec2 uSize;
+    uniform vec3 uValue;
+    uniform float uRadius;
+    void main () {
+      vec2 d = (vUv - uPoint) * uSize;
+      float g = exp(-dot(d, d) / (uRadius * uRadius));
+      gl_FragColor = vec4(texture2D(uTarget, vUv).xyz + g * uValue, 1.0);
+    }`,
+  fade: `
+    uniform sampler2D uTarget;
+    uniform vec2 uPoint;
+    uniform vec2 uSize;
+    uniform float uRadius;
+    uniform float uAmount;
+    void main () {
+      vec2 d = (vUv - uPoint) * uSize;
+      float g = uRadius > 0.0 ? exp(-dot(d, d) / (uRadius * uRadius)) : 1.0;
+      gl_FragColor = texture2D(uTarget, vUv) * (1.0 - uAmount * g);
+    }`,
+  advect: `
+    uniform sampler2D uVelocity;
+    uniform sampler2D uSource;
+    uniform float dt;
+    uniform float dissipation;
+    uniform vec2 simTexel;
+    void main () {
