+// A word of the film (reel3-time.js TEXT) at its own place, colour and
+// strength. `k` replaces its strength (so pass `TEXT[key].k × behaviour`),
+// `rgb` its colour, `text` its words (a schedule's); the rest go to `type`.
+// When it is shown is the scene's
+export function say(buf, key, f, { k, rgb, dx = 0, dy = 0, clip, text, level, a = 1, add = false } = {}) {
+  const x = TEXT[key]
