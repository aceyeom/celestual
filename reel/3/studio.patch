+#!/usr/bin/env node
+// reel3-check.mjs: the third reel's checks (reel3-TREATMENT.md F), off its
+// clock file and its foundation, so the film is held to what it says it is
+// before a frame of it is drawn.
+//
+//   node scripts/reel3-check.mjs              everything node can check
+//   node scripts/reel3-check.mjs -v           and every pass, not only the
+//                                             failures and the counts
+//   node scripts/reel3-check.mjs --browser    and, in the studio's page, the
+//                                             words measured in the phone's
+//                                             own face against the safe zones
+//   node scripts/reel3-check.mjs --browser --md5
+//                                             and the film's frames shot
+//                                             twice and compared (slow: the
+//                                             fluid re-simulates)
+//   node scripts/reel3-check.mjs --browser --cut
+//                                             and the colour held over the
+//                                             cut out of nine (F1678 and
+//                                             F1680 shot, their red over
+//                                             blue compared)
+//
+// In node (no page, no canvas):
+//
+//   grid      every cut on a multiple of 80; every moment named in the clock,
+//             the words and the sounds on the twenty frame grid unless
+//             `S.inAction` says why not; every visible event on an even frame
+//             and four frames or more; stepped motion moving on even frames
+//   springs   the treatment's numbers (F6), sampled from motion-dom as the
+//             film samples them; every move under four cells drawn as light
+//             leaning
+//   wash      the product's spread, every block turned by the wash's end (F1522), its front
+//             lobed and not round, and in step with `washAt`
+//   motion    the curves, the rose's way across the art to the lockup's star,
+//             the OKLCH turns
+//   voice     voice-lint's own patterns (scripts/voice-lint.mjs, read out of
+//             the file, since it runs itself when it is imported) over every
+//             word in the film, with the film's own rules: lowercase but
+//             Owen, Bee and Nadia; U+2019 for every apostrophe; no run of
+//             three words twice outside the product's own labels
+//   rose      no rose before the re-read (F1360), by OKLCH hue
+//   boxes     every word inside the safe zones, by the treatment's widths
+//   cells     the painters and behaviours of reel3-cells.js, unit by unit,
+//             with a face of plain bars standing in for Jersey 10
+//
+// Exits 1 on any failure.
+import { readFileSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import { createHash } from 'node:crypto'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+const parts = join(root, 'app/src/studio/parts')
+const load = (f) => import(pathToFileURL(join(parts, f)).href)
+const args = process.argv.slice(2)
+const VERBOSE = args.includes('-v') || args.includes('--verbose')
+
+const T = await load('reel3-time.js')
+const MO = await load('reel3-motion.js')
+const W = await load('reel3-wash.js')
+const C = await load('reel3-cells.js')
+const { S, TEXT, SPRINGS, LAYOUT, GRID, COL, CUES, SCENES, HOOKS, ms } = T
+
+// ── reporting ───────────────────────────────────────────────────────────────
+let fails = 0
+let passes = 0
+let section = ''
+const tally = new Map()
+function ok(cond, what, detail = '') {
+  const t = tally.get(section) || { pass: 0, fail: 0 }
+  if (cond) {
+    passes++
+    t.pass++
+    if (VERBOSE) console.log(`  ✓ ${what}${detail ? `  (${detail})` : ''}`)
+  } else {
+    fails++
+    t.fail++
+    console.error(`  ✗ ${section}: ${what}${detail ? `  (${detail})` : ''}`)
+  }
+  tally.set(section, t)
+  return cond
+}
+const near = (a, b, eps) => Math.abs(a - b) <= eps
+function begin(name) {
+  section = name
+  if (VERBOSE) console.log(`\n${name}`)
+}
+function info(s) { if (VERBOSE) console.log(`  · ${s}`) }
+
+// ── grid and parity (F5) ────────────────────────────────────────────────────
+begin('grid')
+{
+  const off = T.offGrid()
+  ok(off.length === 0, 'every frame in S is on the 20 f grid or in S.inAction', off.join(', '))
+  for (const f of S.cuts) ok(f % 80 === 0, `cut F${f} on a multiple of 80`)
+  for (const f of S.shots) ok(f % 80 === 0, `shot F${f} starts on a multiple of 80`)
+  // a frame that may be seen: even, and on the grid or excused
+  const fit = (f, what) => {
+    if (!ok(Number.isInteger(f) && f % 2 === 0, `${what} F${f} is an even frame`)) return
+    ok(f % T.HALF_F === 0 || T.inAction(f) != null, `${what} F${f} on the 20 f grid or in S.inAction`, T.inAction(f) || '')
+  }
+  for (const f of new Set(T.framesOf())) fit(f, 'S moment')
+  for (const [k, [a, b]] of Object.entries(SCENES).flatMap(([k, rs]) => rs.map((r) => [k, r]))) {
+    fit(a, `scene ${k} from`)
+    fit(b, `scene ${k} to`)
+  }
+  for (const [key, x] of Object.entries(TEXT)) {
+    if (x.on != null) fit(x.on, `${key} on`)
+    if (x.cut != null) fit(x.cut, `${key} cut`)
+    if (x.out != null) for (const g of [x.out, x.out + 6, x.out + 12]) fit(g, `${key} three-step`)
+    if (x.rim) for (const g of x.rim) fit(g, `${key} rim`)
+    // a caption's ramp is how it comes on, not a moment of its own: it
+    // lands on an even frame, and is none, two frames (with a screen's
+    // wake) or four
+    if (x.role === 'title') ok([0, 2, 4].includes(x.ramp) && (x.on + x.ramp) % 2 === 0, `${key} comes on prelit, with a wake or over four frames`, `ramp ${x.ramp}`)
+    if (x.sched) for (const [g] of x.sched) fit(g, `${key} sched`)
+    if (x.on != null && x.cut != null) ok(x.cut - x.on >= 4, `${key} is up four frames or more`, `${x.cut - x.on} f`)
+  }
+  for (const [at] of CUES) for (const f of [at].flat(2)) fit(f, 'cue')
+  // a span of the clock lasts four frames or more, but the power-on's two
+  // frames of black, which are the absence of an event (shot 3)
+  const spans = []
+  const walk = (o, path) => {
+    for (const [k, v] of Object.entries(o)) {
+      if (Array.isArray(v) && v.length === 2 && v.every((x) => typeof x === 'number') && v[1] > v[0]) spans.push([`${path}.${k}`, v])
+      else if (v && typeof v === 'object' && !Array.isArray(v) && k !== 'inAction') walk(v, `${path}.${k}`)
+    }
+  }
+  walk(S, 'S')
+  for (const [name, [a, b]] of spans) {
+    if (name === 'S.sent.black') { ok(b - a === 2, 'the power-on is two frames of black', `${b - a} f`); continue }
