+  ok(md5(A1) === md5(A2), 'painting is the same whatever was painted before', md5(A1).slice(0, 8))
+
+  // the bench's cards all paint
+  let cards = 0
+  try {
+    for (let k = 0; k < 100; k++) { const x = new C.CellBuf(); C.debug(k, x, new C.CellBuf()); if (x.rgba.some((v) => v > 0)) cards++ }
+    ok(cards >= 8, 'the bench\'s cards paint', `${cards} cards`)
+  } catch (e) {
+    ok(false, 'the bench\'s cards paint', String(e))
+  }
+  C.cutWith(null)
+}
+
+// ── in the page ─────────────────────────────────────────────────────────────
+if (args.includes('--browser')) await inPage()
+
+async function inPage() {
+  const { studio } = await import(pathToFileURL(join(root, 'scripts/studio.mjs')).href)
+  const s = await studio()
+  try {
+    // the words, cut by the product's own typeCells in the face itself
+    begin('browser: widths')
+    const page = await s.pageAt(1)
+    await s.open(page, 'list=1', 400, 400)
+    const strings = new Set()
+    for (const x of Object.values(TEXT)) {
+      strings.add(x.s)
+      if (x.sched) for (const [, t] of x.sched) strings.add(t)
+    }
+    strings.add('@')
+    strings.add(T.URL)
+    const cut = await page.evaluate(async (all) => {
+      await document.fonts.load('400 40px "Jersey 10"')
+      const { typeCells } = await import('/src/wall/pixtype.js')
+      const out = {}
+      for (const t of all) {
+        const L = typeCells(t)
+        const xs = L.cells.map((c) => c[0])
+        const ys = L.cells.map((c) => c[1])
+        out[t] = { w: L.w, sure: L.sure, x0: Math.min(...xs), x1: Math.max(...xs), y1: Math.max(...ys), n: L.cells.length }
+      }
+      return out
+    }, [...strings])
+    for (const [t, L] of Object.entries(cut)) ok(L.sure && L.n > 0, `"${t}" cut in Jersey 10`)
+    for (const [key, x] of Object.entries(TEXT)) {
+      const texts = x.sched ? x.sched.map(([, t]) => t) : [x.s]
+      for (const t of texts) {
+        const L = cut[t]
+        const w = L.w * x.size
+        if (x.w != null && t === x.s) {
+          if (w !== x.w) console.log(`  · ${key}: typeCells says ${w} cells, the treatment ${x.w}`)
+        }
+        const left = x.align === 'right' ? Math.round(x.i) + 1 - w : x.align === 'center' ? Math.round(x.i - w / 2) : Math.round(x.i)
+        // its lit cells, not its advance: what can be read
+        const lo = left + x.size * L.x0
+        const hi = left + x.size * L.x1 + x.size - 1
+        boxOk(`${key} "${t}"`, lo, hi, x.j, x.j + 10 * x.size - 1)
+        ok(x.j + x.size * (L.y1 + 10) + x.size - 1 <= GRID.FOOT_J + 3 * x.size, `${key} "${t}": its descenders end by y 1540 and a descender's depth`)
+      }
+    }
+    if (args.includes('--md5')) await md5s(s)
+    if (args.includes('--cut')) await heldCut(s)
+  } finally {
+    await s.close()
+  }
+}
+
+// The film's frames shot more than one way and compared (F2): F1560 fresh
+// against F1560 reached a frame at a time; three shares of F1500 to 1520,
+// each run up to as a share is; and B's frame n + 80 against A's frame n.
+// Slow: every fresh page re-simulates the fluid from frame 0. For the
+// integrator, once the film is whole
+async function md5s(s) {
+  begin('browser: md5')
+  const shot = async (film, fs, run = [-250, -120, -40]) => {
+    const page = await s.browser.newPage({ viewport: { width: 1080, height: 1920 }, deviceScaleFactor: 1 })
+    try {
+      await s.open(page, `film=${film}`, 1080, 1920)
+      const clip = await page.locator('.st-board').first().boundingBox()
+      const out = []
+      const t0 = ms(fs[0])
+      for (const pre of run) if (t0 + pre >= 0) await page.evaluate((m) => window.__seek(m), t0 + pre)
+      for (const f of fs) {
+        await page.evaluate((m) => window.__seek(m), ms(f))
+        const png = await page.screenshot({ type: 'png', clip: { x: clip.x, y: clip.y, width: 1080, height: 1920 } })
+        out.push(createHash('md5').update(png).digest('hex'))
+      }
+      return out
+    } finally {
+      await page.close()
+    }
+  }
+  const range = (a, b) => Array.from({ length: b - a + 1 }, (_, n) => a + n)
+  const [fresh] = await shot('celestual-reel-3', [1560])
+  const seq = await shot('celestual-reel-3', range(1500, 1560))
+  ok(fresh === seq[seq.length - 1], 'F1560 fresh is F1560 reached a frame at a time', `${fresh.slice(0, 8)} ${seq[seq.length - 1].slice(0, 8)}`)
+  const shares = []
+  for (const from of [1480, 1490, 1500]) shares.push((await shot('celestual-reel-3', range(from, 1520))).slice(1500 - from))
+  ok(shares.every((x) => JSON.stringify(x) === JSON.stringify(shares[0])), 'three shares of F1500 to 1520 agree')
+  for (const n of [0, 80, 370, 1000, 1640]) {
+    const [a] = await shot('celestual-reel-3', [n])
+    const [b] = await shot('celestual-reel-3-b', [n + HOOKS.b.offset])
+    ok(a === b, `B's frame ${n + HOOKS.b.offset} is A's frame ${n}`, `${a.slice(0, 8)} ${b.slice(0, 8)}`)
+  }
+}
+
+// The cut out of nine keeps its colour (reel3-TREATMENT.md B4, F1680): a
+// hard cut on her footfall from his note to the art, the rose the light on
+// both sides of it. The panel's mean red over its blue (sRGB 0-255) the
+// frame before the cut's frame and on it, read off the panel's own canvas,
+// differ by less than HELD_RB (8). Slow: the fluid re-simulates to F1678
+async function heldCut(s) {
+  const HELD_RB = 8
+  begin('browser: the held cut')
+  const page = await s.browser.newPage({ viewport: { width: 1080, height: 1920 }, deviceScaleFactor: 1 })
+  try {
+    await s.open(page, 'film=celestual-reel-3', 1080, 1920)
+    const rb = {}
+    for (const f of [S.coda.from - 2, S.coda.from]) {
+      await page.evaluate((m) => window.__seek(m), ms(f))
+      rb[f] = await page.evaluate(() => {
+        const src = document.querySelector('.r3-gl')
+        const c = document.createElement('canvas')
+        c.width = src.width
+        c.height = src.height
+        const g = c.getContext('2d')
+        g.drawImage(src, 0, 0)
+        const d = g.getImageData(0, 0, c.width, c.height).data
+        let t = 0
+        for (let i = 0; i < d.length; i += 4) t += d[i] - d[i + 2]
+        return t / (d.length / 4)
+      })
+    }
+    const [a, b] = [rb[S.coda.from - 2], rb[S.coda.from]]
+    ok(Math.abs(a - b) < HELD_RB, `the panel's red over blue within ${HELD_RB} either side of the cut at F${S.coda.from}`, `F${S.coda.from - 2} ${a.toFixed(2)}, F${S.coda.from} ${b.toFixed(2)}`)
+  } finally {
+    await page.close()
+  }
+}
+
+// ── the count ───────────────────────────────────────────────────────────────
+console.log(`\nreel3-check: ${[...tally].map(([k, t]) => `${k} ${t.pass}/${t.pass + t.fail}`).join(', ')}`)
+if (fails) {
+  console.error(`reel3-check: ${fails} failure${fails === 1 ? '' : 's'}, ${passes} passed`)
+  process.exit(1)
+}
+console.log(`reel3-check: all ${passes} passed`)
