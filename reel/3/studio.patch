@@ -0,0 +1,410 @@
+// ── the third reel: on purpose ──────────────────────────────────────────────
+//
+// Thirteen bars at 90 beats a minute (reel3-time.js), drawn from `t` and
+// nothing else, in the first reel's world: the whole film is one phone's
+// screen, a panel of 154 by 274 cells of seven pixels, six lit and one dark,
+// with the first reel's living dark in it (its sky, its hashed stars, light
+// spreading in it as ink does in water). Nadia, her study group's walk home,
+// and Owen's 51 minute playlist for a 19 minute walk.
+//
+//   0      her light along a bar to a pin, his white on to the bar's end.
+//          `the walk home is 19 min` / `his playlist for it is 51 min`
+//   2.67   tue 1:12 am, the group chat. `so walk slower`. her draft cleared,
+//          a letter, then words, its ghost left burnt in; the backlight dies
+//   6.67   1:41. `sent privately.` to `dear Owen`, `till this saturday`; its
+//          light leaks into the dark; the side button, and the crystal relaxes
+//   9.33   wednesday, 4%, his charger. `nothing told him / about tuesday.`
+//          later, the same lock screen: `lost you two`
+//  13.33   her note, read once: `i walk slower / on purpose.` options, and
+//          the ask; a half press that never commits, and keep it
+//  17.33   reveals in 00:00:02, each change a redraw
+//  20      nine: the count rolls over, and in its ring the roses, their
+//          sky light and the hands dark against it. `if it’s only you, /
+//          the walk stays / the walk.` the list re-reads: the bouquet's
+//          rose first, light through its petals, then `it’s mutual`; the
+//          slot; the wash out of it, the rose ink, his note, read alone.
+//          `he hadn’t / seen mine.`, the rose travelling round his note
+//  28      the hard cut on her footfall to the player, the art in rose
+//          light, footfalls up it to 51:00. `i let it play / to the end.`
+//          the player stops: the art dims but for its sun, his white leaves
+//          the scrubber, and her light swells at its end
+//  32      the door, and the name, centred, a rose bloom opening round its
+//          star
+//
+// This file is the frame (reel3-CONTRACT.md 4): it holds the film until the
+// face, the photographs, every word's cells and every scene are ready, and
+// then, for each frame, steps the panel's flow to it, sets the captions from
+// TEXT (and, for a caption lit by an event, its scene), has each scene on
+// at that moment paint the phone's cells and
+// place its light, puts the sky in, and draws the panel (reel3-panel.js).
+// Over it all, the address, the one line in the page's own DOM.
+
+import { useEffect, useLayoutEffect, useRef, useState } from 'react'
+import { Board, useHold } from '../kit.jsx'
+import { shake } from './reel.jsx'
+import { drop } from './reel-aura.js'
+import { typeCells } from '../../wall/pixtype.js'
+import { ensureFaces } from '../../wall/type.js'
+import { MS, ms, fr, active, F_END, S, TEXT, TITLES, titleAt, stepsOut, HOOKS, URL, LAYOUT, COL, GRID, FLOW, linOf, DEBUG, SCENE_ORDER } from './reel3-time.js'
+import { CellPanel, MAXS, SOURCE } from './reel3-panel.js'
+import * as cells from './reel3-cells.js'
+import { CellBuf, type as typeIn } from './reel3-cells.js'
+import * as photo from './reel3-photo.js'
+import * as ui from './reel3-ui.js'
+import * as hook from './reel3/hook.js'
+import * as chat from './reel3/chat.js'
+import * as sent from './reel3/sent.js'
+import * as wed from './reel3/wed.js'
+import * as fri from './reel3/fri.js'
+import * as sat from './reel3/sat.js'
+import * as nine from './reel3/nine.js'
+import * as coda from './reel3/coda.js'
+import * as name from './reel3/name.js'
+import './reel.css'
+import './reel3.css'
+
+export { MS }
+
+// every scene, in the order they are drawn on a frame they share (none do)
+const MODULES = { hook, chat, sent, wed, fri, sat, nine, coda, name }
+export const SCENE_MODULES = SCENE_ORDER.map((k) => ({ key: k, ...MODULES[k] }))
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+// a screen coming on over `n` frames from `f0`: reel.jsx's `on`, in frames
+const onF = (f, f0, n) => { const k = clamp((f - f0) / n); return k * k * (3 - 2 * k) }
+const mixed = (a, b, k) => a.map((x, i) => x * (1 - k) + b[i] * k)
+
+// A scene that throws is told once on the console (which the film script
+// reports) and left out of that frame, so one scene being built never takes
+// the others' frames with it; the frame is the same picture either way
+const TOLD = new Set()
+function guard(m, what, fn) {
+  try { fn() } catch (e) {
+    const key = `${m.key}.${what}`
+    if (!TOLD.has(key)) { TOLD.add(key); console.error(`reel3: ${key}: ${e && e.stack ? e.stack.split('\n').slice(0, 3).join(' | ') : e}`) }
+  }
+}
+
+// ── the flow ────────────────────────────────────────────────────────────────
+// one step a frame, from frame 0: the film's moment of each
+const STEPS = Array.from({ length: F_END }, (_, n) => ms(n))
+// The first reel's panel under everything (reel.jsx `flow`): how long light
+// lasts in it, how long a push does, how little it curls, and three slow
+// currents wandering in it, each drawing the flow along after it, so the
+// dark is never quite still and nothing in it rises. Each current carries a
+// little of the sky's own blue every step (FLOW.current), and between them
+// they wander the whole panel, corner to corner, so the stars catch
+// wherever they have been. And the first reel's other notes (reel.jsx
+// `OTHERS`): eight faint lights fixed about the panel, at the first reel's
+// own cells and amount, a little of the sky's two colours each every step
+// for the whole film (the top's turning to the rose with the sky, from the
+// reveal), for the currents to carry, so the dark is a pinprick starfield
+// in nearly every cell and never a perforated sheet of the sky's round
+// points with a star here and there. From the send to the lock screen
+// light lasts longer (0.3), so the lilac the send leaked is still in the
+// panel when wednesday comes up, as the treatment has it
+const CURRENT_INK = mixed(linOf(COL.ice.glow), linOf(COL.lilac.glow), 0.45)
+// how far the currents wander from the frame's middle, across and down (px)
+const SWEEP = [460, 860]
+const OTHERS = FLOW.others.at.map(([i, j], k) => ({ x: 6.5 + 7 * i, y: 8.5 + 7 * j, top: k % 2 === 1 }))
+function baseFlow(fl, t) {
+  const f = Math.round(fr(t))
+  fl.dyeFade = f >= S.sent.from && f < 640 ? 0.3 : 0.42
+  fl.velFade = 0.3
+  fl.curl = 5
+  const C = FLOW.current
+  for (let i = 0; i < 3; i++) {
+    const px = 3100 + i * 700
+    const py = 2300 + i * 500
+    const ph = i * 2.1
+    const x = 540 + Math.sin(t / px + ph) * SWEEP[0]
+    const y = 960 + Math.sin(t / py + ph * 1.7) * SWEEP[1]
+    const vx = (Math.cos(t / px + ph) * SWEEP[0] * 1000) / px
+    const vy = (Math.cos(t / py + ph * 1.7) * SWEEP[1] * 1000) / py
+    fl.push(x, y, vx * 0.06, vy * 0.06, 110)
+    if (f >= 0 && f % C.every === 0) fl.ink(x, y, CURRENT_INK.map((c) => c * C.a), C.r)
+  }
+  if (f < 0) return
+  const O = FLOW.others
+  const rose = f < S.nine.sky ? 0 : drop((t - ms(S.nine.sky)) / 1000, S.nine.skyTau / 1000)
+  const top = mixed(SKY_B, SKY_ROSE, rose).map((c) => c * O.a)
+  const foot = SKY_A.map((c) => c * O.a)
+  for (const o of OTHERS) fl.ink(o.x, o.y, o.top ? top : foot, O.r)
+}
+// what the film does to the flow at step `n` (its moment `t`): the base,
+// then every scene, every step, each keeping to its own frames
+function script(fl, t) {
+  baseFlow(fl, t)
+  for (const m of SCENE_MODULES) if (m.flow) guard(m, 'flow', () => m.flow(fl, t))
+}
+
+// ── the light placed each frame ─────────────────────────────────────────────
+// reel-aura.js's sources, as `add` takes them (px on the frame, `col`
+// linear), and up to four hearts; a source too faint or too small to see is
+// left out, and past MAXS the last are
+export function lightList() {
+  const out = []
+  const hearts = []
+  return {
+    source(o) {
+      const s = { seed: 0, flow: 0, turn: 0, dir: 0, soft: 0, crest: 0, body: 1, time: 0, grain: 1, ...o }
+      if (!(s.a > 0.002) || !(s.R > 1) || out.length >= MAXS) return
+      out.push(s)
+    },
+    heart(h) { if (hearts.length < 4) hearts.push(h) },
+    done() {
+      const sources = new Float32Array(MAXS * SOURCE)
+      out.forEach((s, i) => sources.set([s.x, s.y, s.R, s.a, s.col[0], s.col[1], s.col[2], s.seed, s.flow, s.turn, s.dir, s.soft, s.crest, s.body, s.time, s.grain], i * SOURCE))
+      return { sources, n: out.length, hearts, points: new Float32Array(0), m: 0 }
+    },
+  }
+}
+
+// The dark's own light, the first reel's two (reel-aura.js), at the first
+// reel's own strength (0.13 and 0.10) until the name, and 0.55 of it there,
+// as the first reel lowered its sky for its name: a deep blue from the
+// foot, and from the top a violet with his white in it, which from the
+// slot's press turns to the rose and stays, no stronger for it (the first
+// reel's 0.10 is its most). Their middles are just off the frame, the foot's
+// below its bottom left corner and the top's past its top right, so the
+// spiral veins each winds in cross the corners and its core is never on the
+// frame (a core on it stood in every shot as a dark swirl, dirt on the
+// lens); and each turns a little faster than the first reel's, so its veins
+// drift through a shot and never sit still as stains. Far off the frame and
+// stronger (as they were), the frame saw only their smooth outer light: a
+// dead black top and a lit grid at the foot. Both at the first reel's own
+// strength (`A_UP` 1): as its veins turn through the film the foot's cells
+// run a mean of about 13 to 24 of 255 and the top's 8 to 12, the first
+// reel's own range (19 to 24 at its foot, 11 to 12 at its top)
+const SKY_A = mixed(linOf(COL.ice.glow), linOf(COL.lilac.glow), 0.45)
+const SKY_B = mixed(linOf(COL.lilac.glow), linOf(COL.white.glow), 0.3)
+const SKY_ROSE = mixed(linOf(COL.lilac.glow), linOf(COL.rose.glow), 0.6)
+// (from the slot's press the foot's blue gives way a little to the rose,
+// to 0.8, as the page lets the panel's light through; and from the cut to
+// the player (nine's held frames, when there are any), it gives way
+// further, to the treatment's 0.55, and the top's rose deepens (SKY_DUSK),
+// so the panel through her walk home and under the name is the rose's
+// night and not the blue one before the reveal; the top is lowered to 0.55
+// only at the name)
+const A_UP = 1
+const SKY_DUSK = mixed(linOf(COL.lilac.glow), linOf(COL.rose.glow), 0.85)
+function sky(L, tA) {
+  const s = tA / 1000 + 2
+  const f = fr(tA)
+  const named = f >= S.name.from
+  const m = named ? 0.55 : 1
+  const dusk = S.nine.uiOut > S.nine.held ? clamp((f - S.nine.held) / (S.nine.uiOut - S.nine.held)) : f >= S.nine.uiOut ? 1 : 0
+  const foot = f >= S.nine.sky ? 0.8 - 0.25 * dusk : 1
+  L.source({ x: -40, y: 2010, R: 1600, a: 0.13 * A_UP * foot, col: SKY_A, seed: 3.1, flow: 0.05 * s, turn: 0.03 * s, time: s, grain: 0.55 })
+  const k = fr(tA) < S.nine.sky ? 0 : drop((tA - ms(S.nine.sky)) / 1000, S.nine.skyTau / 1000)
+  L.source({ x: 1140, y: -40, R: 1450, a: 0.1 * m, col: mixed(mixed(SKY_B, SKY_ROSE, k), SKY_DUSK, dusk), seed: 7.7, flow: 0.04 * s, turn: -0.03 * s, time: s, grain: 0.6 })
+}
+
+// ── how the panel is held, and shown ────────────────────────────────────────
+// the hand (reel.jsx `held`): where the panel's light is read drifts a pixel
+// or two; the cells never move. Still from the latch on
+const held = (tA) => { const h = fr(tA) < S.name.from ? 1 : 0; return { dx: shake(tA, 41) * 1.4 * h, dy: shake(tA, 47) * 1.6 * h } }
+// (the stars at the first reel's 0.85: it is screens on the dark, and the
+// dark is alive round them by its pinprick stars, as the first reel's is)
+const looksAt = (tA) => ({ grid: 1, gain: 1, star: 0.85, haze: 0.06, tint: 0.36, lightGain: 1.25, lightHaze: 0.1, passGain: 1, titleGlow: 1, time: tA / 1000 + 2 })
+
+// ── the captions ────────────────────────────────────────────────────────────
+// From TEXT alone (reel3-time.js `titleAt`): chalk, cut into the panel's
+// cells; while one lands (`rim`) its cells are the warm white going to
+// chalk, a little over. A caption's cells hide the dark behind them as far
+// as they are lit. A caption with `enter` is lit a cell at a time by the
+// event that lights it, which its scene answers (`titleLevel(key, f)`, a
+// level for each cell, or null for none of it yet): the limbo's cells
+// catching, the rose's light. A scene may also say what colour each cell
+// is on its way from to chalk (`titleTint(key, f)`: `{rgb, u(i, j)}`, u
+// how far to chalk), the two laid as one light, the chalk's and the
+// event's. A caption with a `rim` lands warm, the warmth going straight or
+// as a footfall's pulse goes
+const CHALK = linOf(COL.chalk)
+const WARM = linOf(COL.warm)
+function paintTitles(titles, f) {
+  titles.clear()
+  for (const x of TITLES) {
+    if (x.enter) {
+      if (f < x.on || (x.cut != null && f >= x.cut)) continue
+      const m = MODULES[x.enter]
+      let level = null
+      if (m && m.titleLevel) guard({ key: x.enter }, 'titleLevel', () => { level = m.titleLevel(x.key, f) })
+      if (!level) continue
+      let tint = null
+      if (m.titleTint) guard({ key: x.enter }, 'titleTint', () => { tint = m.titleTint(x.key, f) })
+      const out = stepsOut(f, x.out)
+      const o = { size: x.size, align: x.align, k: out, a: Math.min(1, out) }
+      if (!tint) typeIn(titles, x.s, x.i, x.j, CHALK, { ...o, level })
+      else {
+        const lv = level
+        typeIn(titles, x.s, x.i, x.j, CHALK, { ...o, level: (i, j) => lv(i, j) * tint.u(i, j) })
+        typeIn(titles, x.s, x.i, x.j, tint.rgb, { ...o, add: true, level: (i, j) => lv(i, j) * (1 - tint.u(i, j)) })
+      }
+      continue
+    }
+    let k = titleAt(x, f)
+    if (k <= 0) continue
+    let rgb = CHALK
+    if (x.rim && f >= x.rim[0] && f < x.rim[1]) {
+      const u = (f - x.rim[0]) / (x.rim[1] - x.rim[0])
+      const w = x.rimShape === 'pulse' ? (1 - u) ** 2 : 1 - u
+      rgb = mixed(CHALK, WARM, w)
+      k *= 1 + 0.25 * w
+    }
+    typeIn(titles, x.s, x.i, x.j, rgb, { size: x.size, align: x.align, k, a: Math.min(1, k) })
+  }
+}
+
+// A-time (ms) of the film's moment `t`: hook B's eighty frames before A's
+// first, and taken to its frame exactly (fr keeps a fractional frame's
+// four places), so B's frame n + 80 is A's frame n to the last bit, its
+// flow stepped to the same step
+const timeA = (t, which) => ms(fr(t - ms(HOOKS[which].offset)))
+
+// ── a frame ─────────────────────────────────────────────────────────────────
+function frame(panel, bufs, photos, t, which) {
+  const { scene, titles } = bufs
+  // past the film's end, the bench: a module's own test cards, the flow at
+  // rest, the hand still, the sky as at the first frame (and between the
+  // end and the bench, the same with no card, so a still's run up to a card
+  // never steps the whole film's flow)
+  if (fr(t) >= DEBUG.photo[0] || fr(timeA(t, which)) >= F_END) {
+    // (rounded: a bench still's ms, a third of a frame each, comes back a
+    // hair under or over its frame)
+    const f = Math.round(fr(t))
+    panel.stepTo(-1)
+    titles.clear()
+    scene.clear()
+    const run = Object.entries(DEBUG).find(([, [a, b]]) => f >= a && f < b)
+    const mod = run && { photo, ui, cells }[run[0]]
+    if (mod && typeof mod.debug === 'function') guard({ key: run[0] }, 'debug', () => mod.debug(f - run[1][0], scene, titles, photos))
+    const L = lightList()
+    sky(L, 0)
+    panel.render({ dx: 0, dy: 0 }, looksAt(0), L.done(), { scene, title: titles })
+    return
+  }
+  const tA = timeA(t, which)
+  const f = fr(tA)
+  panel.stepTo(tA)
+  paintTitles(titles, f)
+  scene.clear()
+  const on = SCENE_MODULES.filter((m) => active(m.range, tA))
+  for (const m of on) guard(m, 'paint', () => m.paint(tA, scene, titles, photos))
+  const L = lightList()
+  sky(L, tA)
+  for (const m of on) if (m.light) guard(m, 'light', () => m.light(tA, L))
+  panel.render(held(tA), looksAt(tA), L.done(), { scene, title: titles })
+}
+
+// ── ready ───────────────────────────────────────────────────────────────────
+// The face first, then the photographs, then every word cut while the face
+// is in (so its cells are sure, and kept), then every scene's own
+// preparing; the film is held black until all of it is done and the panel
+// is made. The face is declared by the app's own sheet (type.js), and a
+// face asked for before its sheet is in comes back as no face at all, which
+// the canvas would quietly cut in another; so the sheet is waited for, and
+// the face asked for until it is there
+const FACE = '400 40px "Jersey 10"'
+const frameLater = () => new Promise((r) => requestAnimationFrame(() => r()))
+async function faceIn() {
+  await ensureFaces()
+  for (let tries = 0; tries < 600; tries++) {
+    const got = await document.fonts.load(FACE, words().join(' ')).catch(() => [])
+    if (got.length && got.every((x) => x.status === 'loaded')) return true
+    await frameLater()
+  }
+  console.error('reel3: the face never came; its words would be cut in another')
+  return false
+}
+function words() {
+  const out = new Set(['@', URL])
+  for (const x of Object.values(TEXT)) {
+    out.add(x.s)
+    if (x.sched) for (const [, s] of x.sched) out.add(s)
+  }
+  for (const s of ui.WORDS || []) out.add(s)
+  return [...out]
+}
+let PRIMED = null
+let PRIMING = null
+function prime() {
+  if (!PRIMING) {
+    PRIMING = (async () => {
+      await faceIn()
+      const told = (who) => (e) => { console.error(`reel3: ${who}: ${e && e.stack ? e.stack.split('\n').slice(0, 3).join(' | ') : e}`); return null }
+      const photos = await photo.loadPhotos().catch(told('loadPhotos'))
+      for (const s of words()) typeCells(s)
+      await Promise.all(SCENE_MODULES.map((m) => Promise.resolve().then(() => m.prime(photos)).catch(told(`${m.key}.prime`))))
+      PRIMED = { photos }
+      return PRIMED
+    })()
+  }
+  return PRIMING
+}
+
+// ── the address ─────────────────────────────────────────────────────────────
+// The first reel's line (reel.jsx `CellLine`): the phone's face cut into
+// cells four pixels a side, centred under the name, with reel.css's warm
+// light round it; every cell of it on in the same four frames
+const PAD = 14
+function UrlLine({ tA }) {
+  const ref = useRef(null)
+  const { x, y, c } = LAYOUT.name.url
+  const L = typeCells(URL)
+  const w = L.w * c
+  const left = GRID.GX + Math.round((x - w / 2 - GRID.GX) / GRID.C) * GRID.C
+  const k = onF(fr(tA), S.name.url, 4)
+  useLayoutEffect(() => {
+    const g = ref.current && ref.current.getContext('2d')
+    if (!g) return
+    g.clearRect(0, 0, ref.current.width, ref.current.height)
+    if (k <= 0.004) return
+    g.fillStyle = COL.chalk
+    g.globalAlpha = k
+    for (const [cx, cy] of L.cells) g.fillRect(PAD + cx * c, PAD + (cy + 10) * c, c, c)
+    g.globalAlpha = 1
+  })
+  return <canvas ref={ref} className="rl-line" width={Math.ceil(w + PAD * 2)} height={13 * c + PAD * 2} style={{ left: left - PAD, top: y - PAD }} />
+}
+
+export function Reel3({ t, hook: which = 'a' }) {
+  const ref = useRef(null)
+  const panel = useRef(null)
+  const bufs = useRef(null)
+  const [primed, setPrimed] = useState(PRIMED)
+  const [ready, setReady] = useState(false)
+  useEffect(() => {
+    let live = true
+    prime().then((p) => { if (live) setPrimed(p) })
+    return () => { live = false }
+  }, [])
+  // the panel, once everything it draws is ready
+  useEffect(() => {
+    if (!primed || !ref.current || panel.current) return undefined
+    panel.current = new CellPanel(ref.current, { script, steps: STEPS })
+    bufs.current = { scene: new CellBuf(), titles: new CellBuf() }
+    // (the panel, for a script that measures its flow: scripts/reel3-check
+    // and the tuning probes read the dye back through it; nothing draws
+    // from it)
+    window.__r3panel = panel.current
+    setReady(true)
+    return undefined
+  }, [primed])
+  useEffect(() => () => { if (panel.current) { panel.current.dispose(); panel.current = null } }, [])
+  useHold(ready)
+  useLayoutEffect(() => {
+    if (!ready || !panel.current) return
+    frame(panel.current, bufs.current, primed.photos, t, which)
+  })
+  const tA = timeA(t, which)
+  return (
+    <Board w={1080} h={1920} grain={0} className="r3-board" style={{ background: '#000' }}>
+      <canvas ref={ref} className="r3-gl" width="1080" height="1920" />
+      {ready && fr(tA) >= S.name.url - 4 && fr(tA) < F_END ? <UrlLine tA={tA} /> : null}
+      {/* the grain, the halation and the print's grade are the finish's
+          (scripts/studio-finish.mjs) */}
+      <span className="st-vignette" style={{ opacity: 0.55 }} aria-hidden="true" />
+    </Board>
+  )
+}
