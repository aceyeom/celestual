+  const B = typeLayout(now, i, j, { size, align }).cells
+  const id = ([a, b]) => (b + 1024) * 4096 + a + 1024
+  const inA = new Set(A.map(id))
+  const inB = new Set(B.map(id))
+  const oldOnly = A.filter((c) => !inB.has(id(c)))
+  const newOnly = B.filter((c) => !inA.has(id(c)))
+  const kept = B.filter((c) => inA.has(id(c)))
