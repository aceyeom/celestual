+  return g
+}
+// (`lift`, 0 unless given, takes the keys' band from `bot` toward the
+// band's `top`: a band with no keys on it, the done sheet's, would read as a
+// black slab under the glass once its light is on the dark round it)
+export function glass(buf, r, tint, { back = 0.5, band = null, keys = null, lift = 0, k = 1 } = {}) {
+  if (!(k > 0)) return
+  const a = clamp(k)
+  for (const [i, j, c] of glassCells(r, tint, band, keys, lift)) buf.set(i, j, c, back * k, a)
+}
+
+// ── the bar (the hook's street, and the player's scrubber) ─────────────────
+// One channel of cells, the bar's 120 a street the length of his playlist:
+//
+//   channel   every cell of it, unlit glass at ash ×0.15
+//   fill      `fill` cells lit from its first, his white at 0.5; the last of
+//             them lit by as much of it as is filled, and the four at its
+//             front a phosphor head, ×1.6, 1.35, 1.15, 1.05 from the front
+//             (the cells a running fill has just reached, still settling)
+//   pin       {i, above: [j, j], below: [j, j]}: a tick over it and under it
+//             in ash ×0.4, where 19 minutes ends (45 of the 120 is 19 of 51)
+//   glowRow   a row under the bar, from bar cell `glowFrom` to the head, his
+//             white at 0.15 at the head and less back toward `glowFrom`
+//   walker    {x, rows, size, k}: her light, a size × size block of lilac
+//             with its middle column at `x` (a float: leaned between
+//             columns), rows `rows`
+//
+// `pinK` the pin's tick's level (the hook's 0.6, so the 19 of 51 reads on
+// a bar whose passed cells have gone almost to the channel's own dark),
+// `k` (not in the contract's list; 1 unless given) is the whole bar's level,
+// and `fillK` his white's in it (0.5, the hook's bright thing; the player
+// keeps it to his 0.3); `fillAt(c, back)`, if given, a filled cell's own
+// level in place of `fillK` and the head's (the hook's phosphor: each cell
+// as bright as the head was when it passed, going down to a floor)
+const HEAD = [1.6, 1.35, 1.15, 1.05]
+export function bar(buf, f, { bar: B, cells: n = 120, fill = 0, head = 4, pin = null, pinK = 0.4, walker = null, glowRow = null, glowFrom = 0, fillK = 0.5, fillAt = null, k = 1 } = {}) {
+  if (!(k > 0) || !B) return
+  const a = clamp(k)
+  const ash = lin('ash')
+  const white = lin('white.lit')
+  fillRect(buf, [B.i0, B.j0, B.i1, B.j1], ash, { k: 0.15 * k, a })
+  const lit = clamp(fill, 0, n)
+  const whole = Math.floor(lit)
+  const part = lit - whole
+  // the front cell: the one partly filled, or the last whole one
+  const front = part > 1e-6 ? whole : whole - 1
+  for (let c = 0; c <= front; c++) {
+    const back = front - c
+    const kk = (c === whole ? part : 1) * (fillAt ? fillAt(c, back) : fillK * (back < head ? HEAD[back] ?? 1 : 1))
+    for (let j = B.j0; j <= B.j1; j++) buf.set(B.i0 + c, j, white, kk * k, a)
+  }
+  if (glowRow != null && front >= 0) {
+    const from = Math.max(0, Math.floor(glowFrom))
+    const span = front - from + 1
+    for (let c = from; c <= front; c++) buf.set(B.i0 + c, glowRow, white, (0.15 * (c - from + 1) / span) * k, a)
+  }
+  if (pin) {
+    for (const [p, q] of [pin.above, pin.below]) for (let j = p; j <= q; j++) buf.set(pin.i, j, ash, pinK * k, a)
+  }
+  if (walker) {
+    const size = walker.size || 3
+    const left = walker.x - (size - 1) / 2
+    const i0 = Math.floor(left)
+    const block = []
+    for (let j = walker.rows[0]; j <= walker.rows[1]; j++) for (let x = 0; x < size; x++) block.push([i0 + x, j])
