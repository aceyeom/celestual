+  let j1 = top + 10 * size - 1
+  for (const c of cells) {
+    if (c[1] < j0) j0 = c[1]
+    if (c[1] > j1) j1 = c[1]
+  }
+  const out = { i0: left, i1: left + w - 1, j0, j1, w, cells }
