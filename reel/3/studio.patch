diff --git a/app/src/studio/films/reel-3-b.jsx b/app/src/studio/films/reel-3-b.jsx
new file mode 100644
index 0000000..55f161f
--- /dev/null
+++ b/app/src/studio/films/reel-3-b.jsx
@@ -0,0 +1,10 @@
+import { Reel3, MS } from '../parts/reel3.jsx'
+import { HOOKS, ms } from '../parts/reel3-time.js'
+
+// the third reel at 9:16, opened cold on the ghost: `i already / walk
+// slower` burnt into the dark for eighty frames, then all of the first
+function Film({ t }) {
+  return <Reel3 t={t} hook="b" />
+}
+
+export default { id: 'celestual-reel-3-b', w: 1080, h: 1920, ms: MS + ms(HOOKS.b.offset), fps: 60, Film }
diff --git a/app/src/studio/films/reel-3.jsx b/app/src/studio/films/reel-3.jsx
new file mode 100644
index 0000000..5dc514f
--- /dev/null
+++ b/app/src/studio/films/reel-3.jsx
@@ -0,0 +1,8 @@
+import { Reel3, MS } from '../parts/reel3.jsx'
+
+// the third reel at 9:16: on purpose
+function Film({ t }) {
+  return <Reel3 t={t} hook="a" />
+}
