@@ -0,0 +1,333 @@
+// ── reel 3 · coda ───────────────────────────────────────────────────────────
+//
+// 8 · to the end (1680 to 1920): what she does with it (reel3-TREATMENT.md
+// shot 8, reel3-PLAN.md "now playing", reel3-CONTRACT.md 11.10 and 12.3-4).
+//
+//   1560  her first two footfalls, while his note is still on the screen,
+//   1620  are heard and not lit (nine)
+//   1680  the third. A hard cut on it, its pulse of rose carrying the cut:
+//         the now-playing art is there with the player round it, dance.jpg
+//         at 125 cells, the square that was the 26 cell cover in the chat,
+//         from the words' left margin to the feed's safe line, and `50:57`;
+//         the scrubber under it as wide, which is the hook's bar come back,
+//         his white filled to within a sliver of its end, the pin still at
+//         the 19 minutes the walk was meant to take, her lilac at its end,
+//         the hook's light round her, leaning on each footfall as it leaned
+//         on the pin. The art is printed as the first reel printed its
+//         photographs: its sky its own print's light toned rose, the rose
+//         nine left in the panel held even behind it (LIGHTS.wash.art) and
+//         let through it a little, as rose on the cut as the frame before
+//         it; its figures dark glass. The phone is in her hand as she
+//         walks, so its live wallpaper leans the dark figures against their
+//         sky with every step (motion-dom's spring, alternate feet
+//         alternate sides, the picture sampled again where the lean puts
+//         it, so its dither re-forms where it is; nothing slides). The sun
+//         between their hands is a star of the warm white, its middle cell
+//         and its four arms, with a small warm light of its own round it,
+//         the sky stepping down toward it so it is the brightest thing in
+//         the picture; it comes up a step a second, toward 51:00
+//   1680  each footfall drops the rose into the panel further up her way
+//   -1800 (MotionPathPlugin, reel3-time.js ROUTE, `footAt`): from her light
+//         at the scrubber's end up the art's right edge, into the sky right
+//         of her, under the arch of their raised hands; every one where the
+//         picture lets the light through. Each is a quick bright pulse of
+//         rose under the picture, the thud of the step, and a slow bloom it
+//         leaves; its ink opens in veins round where it fell (the left foot
+//         one way, the right the other) and drifts on toward the next
+//   1740  `50:58` with `i let it play`; 1800 `50:59` with `to the end.`,
+//         each line whole on its footfall and warm with the thud, the warmth
+//         dying as the footfall's pulse does (reel3.jsx, TEXT `rimShape`)
+//   1860  `51:00`, the last footfall, back at her walker: play becomes stop.
+//         The player stops as a player does: the art goes to its stopped
+//         dim in three steps but for its sun, and his white leaves the
+//         scrubber from her walker back, block by block (reel3-ui.js
+//         `player`), so the last thing that moves is his playlist's light
+//         leaving the bar while hers stays at its end, full, and swells
+//         (`swellOf`), as she leaned on the pin at the hook's 80; and the
+//         sun's own warm light comes up, the one warm star in the art
+//   1868  stillness, `51:00` held while `to the end.` is read: the frame's
+//   -1920 two lights the sun's warm star and her lilac at the end of the bar
+//   1920  the latch, and the hard cut: name.js opens a rose round the
+//         lockup's star; the cut takes the lines and the player
+//
+// The captions are reel3.jsx's, from TEXT. Every motion here is the
+// phone's or the light's: the cells never move, and nothing comes toward
+// anything. From `seen mine.` on light lasts a little longer in the panel
+// (the flow's fade at HOLD_FADE), so nine's rose is still in it, under the
+// art, to the end.
+
+import { SCENES, S, LAYOUT, FLOW, LIGHTS, COL, GRID, fr, ms, stepsOut } from '../reel3-time.js'
+import { lin, on } from '../reel3-cells.js'
+import { springOf, routeAt, footAt } from '../reel3-motion.js'
+import * as ui from '../reel3-ui.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.coda
+
+const T = S.coda
+const M = GRID.MARGIN
+const W = GRID.CW
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+// how far a drop of ink has spread `dt` seconds after it fell: quickly, then
+// slower and slower, never stopping (reel-aura.js `drop`, which a scene may
+// not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+
+// ── the art ─────────────────────────────────────────────────────────────────
+// The art printed as the first reel's photographs were (its passthrough):
+// where the picture is light (its print's light over LIGHT_AT) its own
+// light is ART_K_SKY of its print, toned rose (SKY_TINT, as the first
+// reel's `photoAt` toned its reveal's print), and it lets ART_PASS_SKY of
+// the panel through (the panel as it is drawn there: the rose's round
+// points and the stars it catches, reel3-panel.js), so the print carries
+// the sky and the rose under it tints it and twinkles through it as stars;
+// where it is dark, its own at ART_K and ART_PASS of the light, so the
+// figures stay dark glass. (At ART_PASS_SKY 2.8 the fluid's billows were
+// printed through the sky as dark curls, a marbled moon double exposed
+// with smoke, and not dance.jpg's flat dusk)
+const ART = LAYOUT.player.art
+const LIGHT_AT = 0.45
+const ART_K = 0.55
+const ART_PASS = 1.6
+const ART_K_SKY = 0.4
+const ART_PASS_SKY = 1
+const SKY_TINT = [1.06, 0.9, 0.98]
+// and a sky cell shows SKY_SHOW of the dark behind it that its print lets
+// show (the photograph's own passthrough, `1 - 0.85·s`): the placed light
+// held behind the sky is always in its veins, and at all of it the veins'
+// dark gaps stood in the sky as C-shaped holes, a marbled moon
+const SKY_SHOW = 0.5
+// At 51:00 the art goes to its stopped state as a player's art does when
+// it stops: its light and what it lets through down to STOPPED[2] in three
+// steps a delivered frame and two apart (STOPPED, from S.coda.stop), all
+// but the sun's five cells, so the couple recede and the sun is the art's
+// one light
+const STOPPED = [0.82, 0.63, 0.45]
+const stoppedAt = (f) => { const d = f - T.stop; return d < 0 ? 1 : STOPPED[Math.min(2, Math.floor(d / 6))] }
+// The sun, a star of the warm white, a step up with each footfall the art
+// is there for, to all of it at 51:00: its middle cell at SUN_K and its
+// four arms at ARM of it, its corners left to the sky (a block of equal
+// squares read as a stuck pixel); the sky's windows stepping down toward
+// it, what they let through and what they show of the light behind, from
+// SUN.near + SUN.fall cells out to SUN.floor of themselves at SUN.near, so
+// the sun is the brightest thing in the art even as the last footfall's
+// bloom opens; and round it a small warm light of its own (SUN_GLOW), so
+// the panel's round points glow round it as round every lit thing in the
+// first reel
+const SUN_STEPS = [[1680, 0.55], [1740, 0.7], [1800, 0.85], [1860, 1]]
+const SUN_K = 2.4
+const ARM = 0.6
+const SUN = { near: 1, fall: 30, floor: 0.2 }
+// (and from the stop its own warm light the art's one light, R 140 at 0.6,
+// coming up over four frames: it is what carries the cut to the lockup's
+// star, warm, and no rose stands between the two dancing figures)
+const SUN_GLOW = { R: 70, a: 0.25, stop: { R: 140, a: 0.6 }, crest: 0.3, body: 1, flow: 0.05, turn: 0.02, seed: 5.5 }
+// his white in the scrubber at his level (0.3 and under but at nine,
+// reel3-TREATMENT.md B2); the hook's 0.5 was that shot's bright thing
+const FILL_K = 0.3
+
+// From `seen mine.` on, light lasts a little longer in the panel (the first
+// reel's fade is 0.42), so the rose nine put in it is under the art to the
+// end; at 0.3 and not less, so the footfalls' ink does not pile up there
+const HOLD_FROM = S.nine.mine
+const HOLD_FADE = 0.3
+
+// ── the footfalls ───────────────────────────────────────────────────────────
+// Each drops the rose under the art (FLOW.codaStep, for T.inkSteps steps;
+// the last, at her walker, FLOW.codaLast) at its point of the route, winds
+// it round where it fell and, while the way goes on up the art, carries it
+// on along the route toward the next as a current; every push given FLOW.codaStep.pushStep of itself a step,
+// as the first reel's currents give theirs (whole every step, a footfall's
+// ink ran to a jet that rolled up into a cap, its rim a ring in the art's
+// sky)
+const CURRENT = { v: 600, r: 46 }
+const SWIRL = { r: 40, v: 260, pushR: 40, turn: 0.4 }
+// Each footfall's light (LIGHTS.step): a rose source at the footfall,
+// opening quickly and then slower, fading over its life
+const LAST = T.steps.length - 1
+const BLOOM = LIGHTS.step
+// and the footfall itself, the thud of it in the light: a quick bright
+// pulse of the rose under the picture that the slow bloom is left behind
+// by. Bright enough to be rose and not the grey a dim light goes to (the
+// panel's Purkinje), its front a crest the eye reads as a step landing,
+// and over in 0.6 s (at 0.7 and 190 px it was a grey smudge of points)
+const PULSE = { R0: 30, R: 260, tau: 0.22, a: 1.1, life: 0.6, crest: 0.5, body: 0.9, flow: 0.5, seed: 4.1 }
+// The rose held: nine's light (LIGHTS.wash) going on behind the art's sky
+// (`art.at`, `art.R` wide, even, no rim), its sky this light passing
+// through it, easing from `art.a[0]` on the cut to `art.a[1]` by the latch
+const HELD = LIGHTS.wash.art
+function heldAt(f) {
+  return HELD.a[0] + (HELD.a[1] - HELD.a[0]) * clamp((f - T.art) / (T.latch - T.art))
+}
+// Her light at the scrubber's end, where the route starts: the hook's own
+// placed light, her lilac glow at R 300 and 0.45, so she is the light at
+// the end of his playlist's bar as she was the light on the hook's street,
+// and at 51:00 swelling (`swell`) as she arrives, for some 0.6 s. (At R 90
+// and 0.12 she was a grey speck, and the couple in the art were the
+// story's end)
+const HER = { R: 300, a: 0.45, swell: { R: 360, a: 0.6 }, crest: 0.55, body: 0.85, flow: 0.1, turn: 0.04, seed: 2.3 }
+
+// once, before the first frame: her ways measured and every footfall's
+// point, and the springs built
+export function prime() {
+  for (let k = 0; k < T.steps.length; k++) footAt(k)
+  springOf('parallaxX', T.art + 1)
+  springOf('parallaxY', T.art + 1)
+  springOf('walkerStep', T.art + 1)
+}
+
+// The art's light cells let the panel's light through by how light they
+// are (a cell's light is read back from what it hides, the photograph's
+// `1 - 0.85·s`), its light parts printed low and passing the light through
+// strongly, less the nearer the sun they are, its dark ones dark glass;
+// its sun a star of the warm white, at the step the footfalls have it at
+const sunStep = (f) => { let sk = 0; for (const [g, x] of SUN_STEPS) if (f >= g) sk = x; return sk }
+function passArt(buf, f, photo) {
+  const { rgba, shape, pass } = buf
+  const [su, sv] = photo.sun('art')
+  const sk = sunStep(f)
+  const stop = stoppedAt(f)
+  const warm = lin(COL.warm)
+  for (let j = ART[1]; j <= ART[3]; j++) {
+    for (let i = ART[0]; i <= ART[2]; i++) {
+      const n = (j + M) * W + i + M
+      const o = n * 4
+      const u = i - ART[0]
+      const v = j - ART[1]
+      const d2 = (u - su) ** 2 + (v - sv) ** 2
+      if (d2 <= 1) {
+        const k = SUN_K * sk * (d2 === 0 ? 1 : ARM)
+        for (let c = 0; c < 3; c++) rgba[o + c] = warm[c] * k
+        rgba[o + 3] = 1
+        shape[n] = 0
+        pass[n] = 0
+        continue
+      }
+      if (shape[n]) { if (stop < 1) { for (let c = 0; c < 3; c++) rgba[o + c] *= stop; pass[n] *= stop } continue }
+      const sky = photo.L('art', u, v) > LIGHT_AT
+      const s = clamp(1 - rgba[o + 3]) / 0.85
+      const near = sky ? clamp((Math.sqrt(d2) - SUN.near) / SUN.fall, SUN.floor, 1) : 1
+      pass[n] = (sky ? ART_PASS_SKY * near : ART_PASS) * s * stop
+      rgba[o + 3] = 1 - (1 - rgba[o + 3]) * near * (sky ? SKY_SHOW : 1)
+      const k = (sky ? ART_K_SKY : ART_K) * stop
+      for (let c = 0; c < 3; c++) rgba[o + c] *= sky ? k * SKY_TINT[c] : k
+    }
+  }
+}
+
+// the frame: the art and the player round it
+export function paint(t, buf, titles, photo) {
+  const f = fr(t)
+  if (photo) {
+    photo.paint(buf, 'art', f, { offset: [springOf('parallaxX', f), springOf('parallaxY', f)] })
+    passArt(buf, f, photo)
+  }
+  if (f >= T.player) ui.player(buf, f, { k: 1, fillK: FILL_K, lean: springOf('walkerStep', f) })
+}
+
+// The rose at each footfall, for its steps, at its point of her way, a
+// push round it turned a little each step, so it opens in veins, and but
+// for the last a push from there toward the next footfall, so it drifts on
+// that way. The last is beside where the lockup's star will be. From
+// `seen mine.` the panel keeps its light a little longer
+export function flow(fl, t) {
+  const f = Math.round(fr(t))
+  if (f >= HOLD_FROM) fl.dyeFade = HOLD_FADE
+  const ps = FLOW.codaStep.pushStep
+  T.steps.forEach((at, k) => {
+    // (the footfalls under his note are heard, and put nothing in the
+    // panel: their ink under the page read as a smudge and a scribble)
+    if (at < T.from || f < at || f >= at + T.inkSteps) return
+    const R = k === LAST ? FLOW.codaLast : FLOW.codaStep
+    const ink = lin(COL[R.tint].glow).map((c) => c * R.a)
+    const p = footAt(k)
+    fl.ink(p.x, p.y, ink, R.r)
+    // wound round where it fell, the left foot one way and the right the
+    // other, so each opens in its own spiral veins
+    const turn = k % 2 ? -1 : 1
+    const th = turn * SWIRL.turn * (f - at)
+    const c = Math.cos(th)
+    const s = Math.sin(th)
+    const v = SWIRL.v * ps
+    fl.push(p.x + SWIRL.r * c, p.y + SWIRL.r * s, -turn * v * s, turn * v * c, SWIRL.pushR)
+    // and on toward the next footfall, a current, while her way goes on
+    // up the art (the last is back at her walker, and nothing is drawn
+    // down across the picture to it)
+    if (k < LAST - 1) {
+      const b = footAt(k + 1)
+      const len = Math.hypot(b.x - p.x, b.y - p.y) || 1
+      const w = CURRENT.v * ps
+      fl.push(p.x, p.y, (w * (b.x - p.x)) / len, (w * (b.y - p.y)) / len, CURRENT.r)
+    }
+  })
+}
+
+// Each footfall's light at its point of her way, its pulse and its bloom,
+// from its frame for its life; only those from the cut on (`from`: the two
+// under his note are heard and not lit). The last, at her walker, is its
+// pulse alone, the thud of her arriving, so once it is over her lilac is
+// the light at the end of the bar and no rose stands over it; and the
+// blooms the earlier steps left in the art go with the player's stop, by
+// the product's three steps, so no rose is left under the arch of the two
+// figures' hands as the story ends
+export function footfalls(t, L, { from = T.from } = {}) {
+  const f = fr(t)
+  T.steps.forEach((step, k) => {
+    if (step < from) return
+    const dt = (f - step) / 60
+    const B = BLOOM
+    if (!(dt >= 0 && dt < B.life)) return
+    const p = footAt(k)
+    if (k < LAST) {
+      L.source({
+        x: p.x, y: p.y,
+        R: B.R0 + B.R * drop(dt, B.tau),
+        a: B.a * (1 - dt / B.life) ** 1.2 * stepsOut(f, T.stop),
+        col: lin(COL.rose.glow), crest: B.crest, body: B.body, flow: B.flow * dt, time: dt,
+      })
+    }
+    if (dt < PULSE.life) {
+      L.source({
+        x: p.x, y: p.y,
+        R: PULSE.R0 + PULSE.R * drop(dt, PULSE.tau),
+        a: PULSE.a * (1 - dt / PULSE.life) ** 2,
+        col: lin(COL.rose.glow), seed: PULSE.seed + k, crest: PULSE.crest, body: PULSE.body, flow: PULSE.flow * dt, time: dt,
+      })
+    }
+  })
+}
+
+// The light placed: nine's rose held behind the art's sky; hers at the
+// scrubber's end, swelling at 51:00; the sun's own small warm light, from
+// the stop the art's one light; and the footfalls'
+export function light(t, L) {
+  const f = fr(t)
+  const s = t / 1000
+  {
+    const G = LIGHTS.wash
+    const dt = (t - ms(S.nine.wash[0])) / 1000
+    const [x, y] = HELD.at
+    L.source({
+      x, y, R: G.R0 + HELD.R * drop(dt, G.tau), a: heldAt(f), col: lin(COL.rose.glow),
+      seed: G.seed, crest: HELD.crest, body: HELD.body, flow: G.flow * dt, turn: G.turn * dt, time: dt, grain: HELD.grain,
+    })
+  }
+  if (f >= T.player) {
+    const at = routeAt(0)
+    const sw = ui.swellOf(f)
+    L.source({
+      x: at.x + 7 * springOf('walkerStep', f), y: at.y, R: HER.R + (HER.swell.R - HER.R) * sw, a: (HER.a + (HER.swell.a - HER.a) * sw) * on(f, T.player, 4), col: lin(COL.lilac.glow),
+      seed: HER.seed, crest: HER.crest, body: HER.body, flow: HER.flow * s, turn: HER.turn * s, time: s,
+    })
+  }
+  {
+    const [su, sv] = LAYOUT.player.sun
+    const G = SUN_GLOW
+    const up = f >= T.stop ? on(f, T.stop, 4) : 0
+    L.source({
+      x: 6.5 + 7 * su, y: 8.5 + 7 * sv, R: G.R + (G.stop.R - G.R) * up, a: (G.a + (G.stop.a - G.a) * up) * sunStep(f), col: lin(COL.warm),
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+    })
+  }
+  footfalls(t, L)
+}
diff --git a/app/src/studio/parts/reel3/fri.js b/app/src/studio/parts/reel3/fri.js
new file mode 100644
index 0000000..3079c8a
--- /dev/null
+++ b/app/src/studio/parts/reel3/fri.js
@@ -0,0 +1,173 @@
+// ── reel 3 · fri ────────────────────────────────────────────────────────────
+//
+// 5 · her note (800 to 1040). The vault's page for the note she placed on
+// tuesday (You.jsx 643-692, reel3-ui.js `noteFace`), and the one time her
+// words are on the screen: `i walk slower / on purpose.` Then the product's
+// own way to letting it go, and not (reel3-TREATMENT.md shot 5,
+// reel3-CONTRACT.md 11.7).
+//
+//   800   a hard cut, and the note is simply there; the light its glass
+//         throws on the dark spreads out well past its edges as ink does,
+//         and its lower corners keep putting a little of its lilac into the
+//         dark with a push out from each, so the currents carry the lilac
+//         and the stars it lights round the glass while she reads, two
+//         seconds: the line the film is named for, given the time
+//   920   `options`: the product's press, the key inverted for four frames
+//   924   the ask, on the same glass, its rows coming on where they are over
+//         the LCD's four frames (no menu between, no sheet rising: the one
+//         arrival from below in the film is wednesday's notification):
+//         `they never find / out you sent it.`, the keys saying the
+//         question, `let it go` and `keep it`
+//   960   a half press on `let it go`. The pressure is a real spring
+//         (motion-dom, SPRINGS.press) toward 0.55 of the key, drawn as the
+//         press's inversion filling it from its foot up, eight of its
+//         fifteen rows and the ninth leaning, its label half turned; its
+//         edge lit by the pressure. It never reaches the commit. The light
+//         the pressed plate gives off spills out under the glass into the
+//         dark, lilac points coming up there as long as the press is held
+//   1000  let go: a second spring drains it by about 1016, the edge's
+//         light going on its own 250 ms
+//   1016  stillness
+//   1032  `keep it`, pressed all the way, the one decisive press: inverted
+//         to the cut at 1040, which lands on it, so the glass never draws
+//         her words again
+
+import { SCENES, S, LAYOUT, COL, FLOW, fr, ms, midX, midY, cellX, cellY } from '../reel3-time.js'
+import { lin } from '../reel3-cells.js'
+import { springOf } from '../reel3-motion.js'
+import * as ui from '../reel3-ui.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.fri
+
+const T = S.fri
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+// how far a drop of ink has spread `dt` seconds after it fell (reel-aura.js
+// `drop`, which a scene may not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+
+// how deep the half press goes, and the edge's light at its deepest
+const HALF = 0.55
+const EDGE = 0.3
+
+// The page at frame `f` (reel3-CONTRACT.md 11.7's table): which of the
+// note's pages, how far its rows have come on (the LCD's four frames, where
+// they are), and the press on a key
+export function pageAt(f) {
+  if (f < T.options) return { page: 'note' }
+  if (f < T.ask) return { page: 'note', press: { key: 'l', depth: 1, edge: 0 } }
+  const rows = clamp((f - T.ask) / T.rowsOn)
+  const on = rows * rows * (3 - 2 * rows)
+  if (f < T.half) return { page: 'ask', rows: on }
+  if (f < T.release) {
+    const depth = springOf('press', f)
+    return { page: 'ask', rows: on, press: { key: 'l', depth, edge: (EDGE * depth) / HALF } }
+  }
+  if (f < T.keep) {
+    const depth = Math.max(0, springOf('release', f))
+    return { page: 'ask', rows: on, press: { key: 'l', depth, edge: EDGE * Math.exp(-ms(f - T.release) / T.edgeTau) } }
+  }
+  return { page: 'ask', rows: on, press: { key: 'r', depth: 1, edge: 0 } }
+}
+
+// The glass's light on the dark, lilac, from its middle, spreading out to
+// its reach from the cut (it is all there at once on the screen; on the
+// dark, light takes a moment to go anywhere). The glass hides the light
+// under it, so its reach is the glass's half diagonal (some 550 px) and
+// a band past its edges: lit haze and stars standing round it, as every
+// lit screen in the first reel threw its halo wider than itself. Its veins
+// wind round the glass and drift out along themselves while she reads
+// (`turn`, `flow`, a second), so the dark round her note is alive for the
+// four seconds she holds it (at the sky's own slow drift the light round
+// the glass stood still and the shot was one card)
+const G = LAYOUT.fri.glass
+const GLASS_PX = { x: midX((G[0] + G[2]) / 2), y: midY((G[1] + G[3]) / 2) }
+const GLOW = { R0: 560, R: 260, tau: 0.32, a: 0.45, crest: 0.2, body: 1, flow: 0.5, turn: 0.45, seed: 4.9 }
+// the glass's two lower corners, just outside it, and which way is out
+const CORNERS = [
+  { x: cellX(G[0]) - 10, y: cellY(G[3]) + 16, out: -1 },
+  { x: cellX(G[2]) + 16, y: cellY(G[3]) + 16, out: 1 },
+]
+
+// What a pressed key gives off under the glass: the plate lit from its foot
+// up (the inversion turns its dark glass to the light), as much as the press
+// has turned of it and the pressure lights its edge, at the key's foot and a
+// little under it, so it shows in the dark below the glass and not on it
+const KEY_LIGHT = { a: 0.26, R0: 40, R: 150, tau: 0.25, below: 10, crest: 0.25, body: 1, flow: 0.3, seed: 7.3 }
+const keyPx = (side) => {
+  const K = LAYOUT.fri.keys[side]
+  return { x: midX((K[0] + K[2]) / 2), y: midY(K[3]) }
+}
+
+// once, before the first frame: the press's springs built, the release's
+// starting point with them (it lets go from wherever the press is when it
+// is let go)
+export function prime() {
+  springOf('press', T.half + 1)
+  springOf('release', T.release + 1)
+}
+
+// the frame: her glass, on whatever page it is on, and the press
+export function paint(t, buf) {
+  const f = fr(t)
+  const p = pageAt(f)
+  ui.noteFace(buf, f, { page: p.page, press: p.press ?? null, rows: p.rows ?? 1 })
+}
+
+// The flow: at the glass's lower corners, while she has it open, its
+// lilac every step and a push out from each (FLOW.feed.fri, its push given
+// as the first reel's currents give theirs, a little a step), the push
+// turning a little every step, the two corners opposite ways, so her lilac
+// winds out round the glass in the panel's veins over the four seconds she
+// has it open and is seen to (at the first reel's protagonists' 0.0016 and
+// 7 px a second the lilac round the glass kept one shape the whole shot)
+export function flow(fl, t) {
+  const F = FLOW.feed.fri
+  const f = Math.round(fr(t))
+  if (f < F.from || f >= F.to) return
+  const ink = lin(COL[F.tint].glow).map((c) => c * F.a)
+  const v = F.push * F.pushStep
+  for (const c of CORNERS) {
+    // out from the glass, then turning down and under it, round and on:
+    // the left corner's push from pointing left turning toward down, the
+    // right's from right toward down
+    const th = (c.out > 0 ? 0 : Math.PI) + c.out * F.turn * (f - F.from)
+    fl.ink(c.x, c.y, ink, F.r)
+    fl.push(c.x, c.y, v * Math.cos(th), v * Math.sin(th), F.pushR)
+  }
+}
+
+// The light placed: the glass's, and while a press holds it, the key's,
+// under the glass. The quick press on `options` is over before any light
+// could spread from it, and gives none; the half press and `keep it` do
+export function light(t, L) {
+  const f = fr(t)
+  const s = t / 1000
+  const dt = (t - ms(T.from)) / 1000
+  L.source({
+    x: GLASS_PX.x, y: GLASS_PX.y, R: GLOW.R0 + GLOW.R * drop(dt, GLOW.tau), a: GLOW.a, col: lin(COL.lilac.glow),
+    seed: GLOW.seed, crest: GLOW.crest, body: GLOW.body, flow: GLOW.flow * s, turn: GLOW.turn * s, time: s,
+  })
+  let side = null
+  let k = 0
+  let from = 0
+  if (f >= T.half && f < T.keep) {
+    const p = pageAt(f).press
+    side = 'l'
+    // the plate's light is the part of it turned, and its lit edge
+    k = clamp(p.depth / HALF) * 0.8 + clamp(p.edge / EDGE) * 0.2
+    from = T.half
+  } else if (f >= T.keep) {
+    side = 'r'
+    k = 1.25
+    from = T.keep
+  }
+  if (!side || !(k > 0.01)) return
+  const K = KEY_LIGHT
+  const at = keyPx(side)
+  const kt = (t - ms(from)) / 1000
+  L.source({
+    x: at.x, y: at.y + K.below, R: K.R0 + K.R * drop(kt, K.tau), a: K.a * k, col: lin(COL.lilac.glow),
+    seed: K.seed, crest: K.crest, body: K.body, flow: K.flow * kt, time: kt,
+  })
+}
