+    ok(signs.every((s, n) => s === (n % 2 ? -1 : 1)), 'alternate feet kick alternate sides', signs.join(' '))
+    ok(MO.springOf('parallaxX', S.coda.art) === 0, 'the art is still on its first frame')
+    ok(SPRINGS.parallaxX.at.every((f) => f >= S.coda.art), 'only the footfalls the art is there for move it')
+  }
+  // asked out of order, the same
+  {
+    const fs = [214, 731, 1015, 1050, 1706, 84, 1706.5, 214]
+    const a = fs.map((f) => [MO.springOf('chatScroll', f), MO.springOf('notification', f), MO.springOf('press', f), MO.springOf('release', f), MO.springOf('parallaxX', f)])
+    const b = [...fs].reverse().map((f) => [MO.springOf('chatScroll', f), MO.springOf('notification', f), MO.springOf('press', f), MO.springOf('release', f), MO.springOf('parallaxX', f)]).reverse()
+    ok(JSON.stringify(a) === JSON.stringify(b), 'every spring is the same whatever was asked before it')
+  }
+  // a move under four cells is drawn as light leaning (or re-sampled, for
+  // the photograph): the film's springs, and how each is drawn
+  const DRAWN = { walkerLean: 'lean', walkerStep: 'lean', chatScroll: 'lean', notification: 'lean', press: 'fill, its partial row leaning', release: 'fill, its partial row leaning', parallaxX: 're-sampled photograph', parallaxY: 're-sampled photograph' }
