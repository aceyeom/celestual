+// ── reel 3 · the cells ──────────────────────────────────────────────────────
+//
+// The panel's cells on the CPU: what every scene draws into, and the LCD's
+// own behaviours, as functions of the frame. The film is one phone's
+// screen, 154 by 274 cells of seven pixels (reel3-time.js GRID), and
+// everything on it, a word, a glass, a bubble's edge, a photograph, is
+// some of these cells lit; nothing is drawn between them. What moves less
+// than a cell moves as light leaning: a cell's light split between the two
+// rows (or four cells) it falls between (`lean`), so the 60 to 30 mix of
+// the finish reads it as a shutter's blur and never as a double.
+//
+// A `CellBuf` is the panel and its margin, 166 by 286 cells (six off each
+// edge, reel3-CONTRACT.md 3.2), each with four numbers and two more:
+//
+//   rgba   its own light, linear (0..1.15; 1.15 an LCD's overshoot), and
+//          `a`, how much of the light behind it (the sky, the stars, the
+//          placed light, the haze) it blocks, 0..1
+//   shape  how its own light is drawn: 0 its 6 px square, 1 a point, 2 a
+//          cross, 3 a sparkle (reel 1's star patterns; a photograph's
+//          brightest cells), 4 a round point as the placed light's (nine's
+//          wash front)
+//   pass   0..4, how much of the panel's own light at it (the flow's dye
+//          and the placed light) lights its square: a photograph lit from
+//          behind
+//   light  0..1, how much the cell is there only where the panel's own
+//          light is: at 1 its light, what it lets through and what it hides
+//          are all ×smoothstep(.01, .07) of the light at it, so a picture
+//          drawn so exists only inside the light's lobes and the rest of
+//          the panel stays the night
+//   gate   0, or a level of the ink in the flow: a cell with a gate is
+//          what it is painted (the rose page, nine's) until the flow's dye
+//          at it is over its gate, and then goes dark, `light` of the way
+//          to the unlit cell: a silhouette that develops only where the
+//          ink has reached (the sea's two in the water, in nine's rose)
+//
+// The panel shows `floor + behind·(1 - a) + own(rgb, shape) + pass·light`
+// (reel3-panel.js), so a lit word is `set(i, j, rgb, k, 1)`, dark glass is
+// `set(i, j, [0, 0, 0], 1, 1)`, and an empty cell is left alone. The unlit
+// cell's own grey (#15171B) is the panel's, and no painter writes it.
+//
+// Painters take the buffer first, paint at the levels they are given, and
+// overwrite: the last to write a cell wins, unless `{add: true}`. The
+// behaviours (retention, relaxation, the redraw and its ring, the press)
+// are each one shot's, and are worked out from the frames they start on,
+// never from the frame before.
+
+import { GRID, LAYOUT, TEXT, S, RETAIN, ms, hexOf, linOf, stepsOut } from './reel3-time.js'
+import { relaxTint } from './reel3-motion.js'
+import { noise } from './reel3-wash.js'
+import { typeCells } from '../../wall/pixtype.js'
+import { PIX } from '../../wall/looks.js'
+
+export { stepsOut }
+
+export const CW = GRID.CW
+export const CH = GRID.CH
+export const MARGIN = GRID.MARGIN
+const M = MARGIN
+const N = CW * CH
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+
+// ── colours ─────────────────────────────────────────────────────────────────
+// sRGB hex to linear light, once a colour. Kept frozen, since every painter
+// shares the one array: a caller that wants to change a colour makes its
+// own. A colour role ('lilac.lit', 'ash') reads as its hex
+const LIN = new Map()
+export const lin = (hex) => {
+  let v = LIN.get(hex)
+  if (!v) {
+    v = Object.freeze(linOf(hex.startsWith('#') ? hex : hexOf(hex)))
+    LIN.set(hex, v)
+  }
+  return v
+}
+// a painter's colour: linear [r, g, b] as given, or a hex or a role
+const rgbOf = (c) => (typeof c === 'string' ? lin(c) : c)
+// how bright a linear colour is (Rec. 709)
+const lum = (c) => 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
+
+// ── the buffer ──────────────────────────────────────────────────────────────
+export class CellBuf {
+  constructor() {
+    this.rgba = new Float32Array(N * 4)
+    this.shape = new Uint8Array(N)
+    this.pass = new Float32Array(N)
+    this.light = new Float32Array(N)
+    this.gate = new Float32Array(N)
+  }
+  clear() {
+    this.rgba.fill(0)
+    this.shape.fill(0)
+    this.pass.fill(0)
+    this.light.fill(0)
+    this.gate.fill(0)
+  }
+  // a visible cell (i 0..153, j 0..273; the margin is -6.. and ..+6) to its
+  // place in the buffer, row 0 at the top; -1 off the buffer
+  index(i, j) {
+    const x = i + M
+    const y = j + M
+    if (!(x >= 0 && y >= 0 && x < CW && y < CH)) return -1
+    return (y | 0) * CW + (x | 0)
+  }
+  get(i, j) {
+    const n = this.index(i, j)
+    if (n < 0) return null
+    const o = n * 4
+    return [this.rgba[o], this.rgba[o + 1], this.rgba[o + 2], this.rgba[o + 3]]
+  }
+  // The whole cell written: its light, what it blocks, and its shape back
+  // to the square and its pass to none, since the last painter to write a
+  // cell wins all of it (a word set over a photograph is a word, not a
+  // photograph's cross in the word's colour). A painter that wants a shape
+  // or a pass sets them after
+  set(i, j, rgb, k = 1, a = 1) {
+    const n = this.index(i, j)
+    if (n < 0) return
+    const o = n * 4
+    const c = rgbOf(rgb)
+    this.rgba[o] = c[0] * k
+    this.rgba[o + 1] = c[1] * k
+    this.rgba[o + 2] = c[2] * k
+    this.rgba[o + 3] = a
+    this.shape[n] = 0
+    this.pass[n] = 0
+    this.light[n] = 0
+    this.gate[n] = 0
+  }
+  // light added to a cell, and it blocks at least `a`
+  add(i, j, rgb, k = 1, a = 1) {
+    const n = this.index(i, j)
+    if (n < 0) return
+    const o = n * 4
+    const c = rgbOf(rgb)
+    this.rgba[o] += c[0] * k
+    this.rgba[o + 1] += c[1] * k
+    this.rgba[o + 2] += c[2] * k
+    if (a > this.rgba[o + 3]) this.rgba[o + 3] = a
+  }
+  scale(i, j, k) {
+    const n = this.index(i, j)
+    if (n < 0) return
+    const o = n * 4
+    this.rgba[o] *= k
+    this.rgba[o + 1] *= k
+    this.rgba[o + 2] *= k
+  }
+  setShape(i, j, s) {
+    const n = this.index(i, j)
+    if (n >= 0) this.shape[n] = s
+  }
+  setPass(i, j, p) {
+    const n = this.index(i, j)
+    if (n >= 0) this.pass[n] = p
+  }
+  // a backlight level over a rect: every cell's own light ×k
+  scaleRect(rect, k) {
+    const [i0, j0, i1, j1] = rectIn(rect)
+    for (let j = j0; j <= j1; j++) {
+      for (let i = i0; i <= i1; i++) {
+        const o = ((j + M) * CW + i + M) * 4
+        this.rgba[o] *= k
+        this.rgba[o + 1] *= k
+        this.rgba[o + 2] *= k
+      }
+    }
+  }
+  // Another buffer's cells over a rect, each ×k(i, j): its light and its
+  // pass ×k, what it blocks ×min(1, k) (as a photograph's level is), its
+  // shape as it is. An overwrite, empty cells and all
+  copyFrom(src, rect = LAYOUT.panel, k = () => 1) {
+    const [i0, j0, i1, j1] = rectIn(rect)
+    for (let j = j0; j <= j1; j++) {
+      for (let i = i0; i <= i1; i++) {
+        const n = (j + M) * CW + i + M
+        const o = n * 4
+        const kk = k(i, j)
+        this.rgba[o] = src.rgba[o] * kk
+        this.rgba[o + 1] = src.rgba[o + 1] * kk
+        this.rgba[o + 2] = src.rgba[o + 2] * kk
+        this.rgba[o + 3] = src.rgba[o + 3] * Math.min(1, kk)
+        this.shape[n] = src.shape[n]
+        this.pass[n] = src.pass[n] * kk
+        this.light[n] = src.light[n]
+        this.gate[n] = src.gate[n]
+      }
+    }
+  }
+}
+
+// a rect [i0, j0, i1, j1] (inclusive cells) cut to the buffer, in whole cells
+function rectIn(rect) {
+  return [
+    Math.max(-M, Math.ceil(rect[0])), Math.max(-M, Math.ceil(rect[1])),
+    Math.min(CW - M - 1, Math.floor(rect[2])), Math.min(CH - M - 1, Math.floor(rect[3])),
+  ]
+}
+// A clip, as painters take it: a rect, or {i0, j0, i1, j1} with any side
+// left open (the chat's viewport is only rows, LAYOUT.chat.viewport). Null
+// is no clip at all
+function clipOf(c) {
+  if (!c) return null
+  if (Array.isArray(c)) return { i0: c[0], j0: c[1], i1: c[2], j1: c[3] }
+  return { i0: c.i0 ?? -Infinity, j0: c.j0 ?? -Infinity, i1: c.i1 ?? Infinity, j1: c.j1 ?? Infinity }
+}
+const inClip = (c, i, j) => !c || (i >= c.i0 && i <= c.i1 && j >= c.j0 && j <= c.j1)
+
+// ── light leaning ───────────────────────────────────────────────────────────
+// Whole-cell shapes at a fractional offset. Each cell's light is split
+// bilinearly over the (up to four) cells it falls between, so a bubble
+// rising by 0.3 of a row is 0.7 of itself in its rows and 0.3 in the rows
+// over them, and nothing is ever drawn between cells. The parts of one
+// shape are gathered first, so a cell two of its cells fall into is whole
+// again: inside a shape leaned by half a cell nothing dims, only its edges
+// split. What it blocks goes as its light does: a cell's `a` is how much of
+// it the shape covers (the max of its parts, summed where they meet).
+//
+// Written over what is there as a shape over a picture: a cell the shape
+// covers wholly is the shape's, one it covers in part is that part of the
+// shape over the rest of what was there. With `add` it is light added.
+// Cells may carry a level of their own, [i, j, k].
+const ACC = new Float32Array(N * 4)
+const COV = new Float32Array(N)
+const HIT = new Uint8Array(N)
+const TOUCHED = new Int32Array(N)
+let touched = 0
+function gather(n, c, k, a, w) {
+  if (!HIT[n]) { HIT[n] = 1; TOUCHED[touched++] = n }
+  const o = n * 4
+  ACC[o] += c[0] * k * w
+  ACC[o + 1] += c[1] * k * w
+  ACC[o + 2] += c[2] * k * w
+  ACC[o + 3] += a * w
+  COV[n] += w
+}
+function lay(buf, add) {
+  const { rgba, shape, pass } = buf
+  for (let t = 0; t < touched; t++) {
+    const n = TOUCHED[t]
+    const o = n * 4
+    const cov = Math.min(1, COV[n])
+    const a = Math.min(1, ACC[o + 3])
+    if (add) {
+      rgba[o] += ACC[o]
+      rgba[o + 1] += ACC[o + 1]
+      rgba[o + 2] += ACC[o + 2]
+      if (a > rgba[o + 3]) rgba[o + 3] = a
+    } else {
+      const keep = 1 - cov
+      rgba[o] = ACC[o] + rgba[o] * keep
+      rgba[o + 1] = ACC[o + 1] + rgba[o + 1] * keep
+      rgba[o + 2] = ACC[o + 2] + rgba[o + 2] * keep
+      rgba[o + 3] = a + rgba[o + 3] * keep
+      if (cov >= 0.999) { shape[n] = 0; pass[n] = 0; buf.light[n] = 0; buf.gate[n] = 0 }
+    }
+    ACC[o] = ACC[o + 1] = ACC[o + 2] = ACC[o + 3] = 0
+    COV[n] = 0
+    HIT[n] = 0
+  }
+  touched = 0
+}
+export function lean(buf, cells, dx, dy, rgb, { k = 1, a = 1, clip, add = false } = {}) {
+  const c = rgbOf(rgb)
+  const cl = clipOf(clip)
+  const fx = Math.floor(dx)
+  const fy = Math.floor(dy)
+  const tx = dx - fx
+  const ty = dy - fy
+  // the four parts, and where each falls, by weight; a whole offset is one
+  const parts = [[0, 0, (1 - tx) * (1 - ty)], [1, 0, tx * (1 - ty)], [0, 1, (1 - tx) * ty], [1, 1, tx * ty]].filter((p) => p[2] > 1e-6)
+  for (const cell of cells) {
+    const kk = cell.length > 2 ? k * cell[2] : k
+    if (!(kk > 0)) continue
+    for (const [ox, oy, w] of parts) {
+      const i = cell[0] + fx + ox
+      const j = cell[1] + fy + oy
+      if (!inClip(cl, i, j)) continue
+      const n = buf.index(i, j)
+      if (n >= 0) gather(n, c, kk, a, w)
+    }
+  }
+  lay(buf, add)
+}
+
+// ── shapes ──────────────────────────────────────────────────────────────────
+// a rect filled: a glass's body, a backlight, a block of dark glass
+export function rect(buf, r, rgb, { k = 1, a = 1, add = false, clip } = {}) {
+  const c = rgbOf(rgb)
+  const cl = clipOf(clip)
+  const [i0, j0, i1, j1] = rectIn(r.map(Math.round))
+  for (let j = j0; j <= j1; j++) {
+    for (let i = i0; i <= i1; i++) {
