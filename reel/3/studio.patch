+// not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+const centreOf = (r) => ({ x: (cellX(r[0]) + cellX(r[2]) + 6) / 2, y: (cellY(r[1]) + cellY(r[3]) + 6) / 2 })
+const vis = (i, j) => j * VW + i
+// a frame to the delivered frame it is shown in (the mix down to thirty)
+const even = (f) => 2 * Math.floor(f / 2)
+
+// ── the roses ───────────────────────────────────────────────────────────────
+// The limbo is a memory of a picture, in the night, printed as the first
+// reel printed its photographs at night: in the photograph's own order,
+// toned with its night blue (reel3-photo.js NIGHT_TINT), its sky the light
+// and its figures dark shapes against it (the first reel's passthrough
+// silhouettes, its best photograph frames). Three values, kept apart, as
+// the first reel's night print has them: the sky lit, a cell at a time at
+// its own step of the photograph's light, falling from SKY[0] at the top
+// to SKY[1] by row SKY_ROW as the first reel's sky light falls (in the
+// night's mid, its windows letting the panel's own light through as the
+// panel draws it, SKY_PASS, so its slow veins turn in the sky while the
+// brand's line is read); the bouquet's heads round mid greys in it
+// (`HEAD`, shaded by how pink each cell is, so the middle of each head is
+// its lightest and its darkest folds are dark glass: round flowers, cut
+// from each other, not one lobed shape); and the stems, the leaves and
+// both hands dark glass (`DARK`): a hand reaching in from the left, the
+// roses on their cone of stems held out by a hand from the right, never
+// touching. (At HEAD 0.06 to 0.13 the heads printed as dark as the stems,
+// and the subject was one blurred bush in a grey fog)
+//
+// Each cell comes up on a frame of its own by its level (`reachOf`), the
+// darkest first and the sky's lightest last, at OVER the step it comes
+// and SETTLE the next, and then at its level: the redraw's overdrive in
