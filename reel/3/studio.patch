@@ -0,0 +1,254 @@
+// ── reel 3 · chat ───────────────────────────────────────────────────────────
+//
+// 2 · the long table (160 to 400), tue 1:12 am, and hook B's cold open (-80
+// to 0). A plain dark group chat in cells: Owen's playlist card with its
+// cover, Bee's joke, and under it all her field with a reply she has not
+// sent, `i already / walk slower`, the one bright thing in the shot.
+//
+//   160   the thread sits thirty rows low, the caret blinking in her draft
+//   180   Owen's line comes in, and the thread goes up on a real spring
+//         (motion-dom, SPRINGS.chatScroll): past by 2.7 rows at +14, back
+//         within half a row by +21, drawn as light leaning; his bubble
+//         clipped over the field as it rises, the cover sampled again
+//         every frame where the scroll has put it, so its dither crawls
+//   260   she clears it, as a held key does: a letter, a pause as long as
+//         she reads it back, five letters as the key repeats, and then the
+//         repeat jumps to whole words. Each cleared letter's cells fall to
+//         RETAIN of their light on the crystal's 90 ms and stay there; the
+//         caret steps back after them in whole cells
+//   360   the backlight dies in one frame: every cell the phone lit goes,
+//         and left among the stars is what it could not take back, the
+//         ghost of `i already walk slower`
+//
+// Hook B's eighty frames before the film are that last picture alone, the
+// retention gone all the way to its floor (reel3-CONTRACT.md 12.9: the cold
+// open is the owner of retention's).
+//
+// Nothing is typed on this screen, ever. The thread only scrolls.
+
+import { SCENES, S, TEXT, LAYOUT, FLOW, RETAIN, fr, hexOf, midX, midY } from '../reel3-time.js'
+import { lin, lean, rect, typeLayout, retention, say } from '../reel3-cells.js'
+import { springOf } from '../reel3-motion.js'
+import * as ui from '../reel3-ui.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.chat
+
+// her draft's two lines, and how bright the shot's one bright thing is
+const LINES = ['chat.draft1', 'chat.draft2']
+const DRAFT_K = TEXT['chat.draft1'].k
+// The caret is solid while the key is down and for a moment after the last
+// press (a phone holds it 200 ms or so before it blinks again), and blinks
+// on its period otherwise: on first from the cut, and off first once she
+// has let go, so the field she has emptied goes dark round the ghost before
+// the screen does
+const CARET = LAYOUT.chat.caret
+const SOLID = S.chat.solid
+const caretOn = (f) => {
+  if (f >= SOLID[0] && f < SOLID[1]) return true
+  const half = S.chat.caret / 2
+  if (f < SOLID[0]) return (f - S.chat.from) % S.chat.caret < half
+  return (f - SOLID[1]) % S.chat.caret >= half
+}
+
+// ── the draft, and what clears it ───────────────────────────────────────────
+// Each character of each line with the frame its cells are cleared on
+// (Infinity: never). The key held on the last line's end takes letters one
+// a press (S.chat.dels); then the repeat jumps to words (S.chat.words),
+// from the end: a word with any space after it, and, where the line goes on
+// before it, the space before it too (`walk` and its space, then `already`
+// and the space before it, then `i`). Worked out once the face is in, since
+// the cells are the face's
+let DRAFT = null
+function draftOf() {
+  if (DRAFT) return DRAFT
+  const lines = LINES.map((key) => {
+    const x = TEXT[key]
+    const lay = typeLayout(x.s, x.i, x.j, { size: x.size, align: x.align })
+    return { key, i0: lay.i0, j: x.j, h: 10 * x.size, chars: lay.chars.map((c) => ({ ...c, gone: Infinity })) }
+  })
+  const lastLine = lines[lines.length - 1].chars
+  let n = lastLine.length - 1
+  for (const f of S.chat.dels) if (n >= 0) lastLine[n--].gone = f
+  const words = [...S.chat.words]
+  for (let l = lines.length - 1; l >= 0 && words.length; l--) {
+    const ch = lines[l].chars
+    let end = l === lines.length - 1 ? n : ch.length - 1
+    while (end >= 0 && words.length) {
+      const f = words.shift()
+      let k = end
+      while (k >= 0 && ch[k].ch === ' ') ch[k--].gone = f
+      while (k >= 0 && ch[k].ch !== ' ') ch[k--].gone = f
+      if (k >= 0 && ch[k].ch === ' ') ch[k--].gone = f
+      end = k
+    }
+  }
+  DRAFT = { lines }
+  return DRAFT
+}
+
+// The caret's column and row at frame `f`: on the line the clearing was
+// last on (the last line before anything is), in the face's own gap after
+// the last of its characters still standing (the last column of its
+// advance, pixtype.js `ends`), between what is left and the ghost it has
+// just made and on neither's stroke; a row over the capitals and a row
+// under them, so it is plainly the caret and not a letter's stem. On a line
+// with none left, in the cell before the line's start, clear of the first
+// ghost. Whole cells, so it steps back with every press
+function caretAt(D, f) {
+  let line = D.lines[D.lines.length - 1]
+  let latest = -Infinity
+  for (const L of D.lines) {
+    for (const c of L.chars) {
+      if (c.gone <= f && c.gone > latest) { latest = c.gone; line = L }
+    }
+  }
+  let i = line.i0 - CARET.gap
+  for (const c of line.chars) if (c.gone > f) i = c.i1
+  return { i, j: line.j - 1, h: Math.min(CARET.h, line.h) + 2 }
+}
+
+// The draft's cells at frame `f`: standing characters at the draft's own
+// level, cleared ones at their retention for good. With `ghostOnly`, the
+// cleared cells alone (the backlight gone); with `floor`, every cell at the
+// retention's floor (the cold open: the same ghost, long after)
+function paintDraft(buf, f, { ghostOnly = false, floor = false } = {}) {
+  const D = draftOf()
+  const rgb = lin(hexOf(TEXT['chat.draft1'].col))
+  for (const L of D.lines) {
+    const cells = []
+    for (const c of L.chars) {
+      if (!c.cells.length) continue
+      let k
+      if (floor) k = RETAIN
+      else if (c.gone <= f) k = retention(f, c.gone)
+      else if (ghostOnly) continue
+      else k = 1
+      for (const [i, j] of c.cells) cells.push([i, j, k])
+    }
+    lean(buf, cells, 0, 0, rgb, { k: DRAFT_K })
+  }
+}
+
+// ── the scene ───────────────────────────────────────────────────────────────
+
+// once, before the first frame, after the face and the photographs are in
+export function prime() {
+  DRAFT = null
+  draftOf()
+}
+
+// the frame at `t` (ms, the film's own time): the phone's cells into
+// `buf`, read the captions already in `titles`, the photographs from `photo`
+export function paint(t, buf, titles, photo) {
+  const f = fr(t)
+  // hook B's cold open: the ghost, and nothing else
+  if (f < 0) { paintDraft(buf, f, { floor: true }); return }
+  // the backlight gone: what the crystal kept
+  if (f >= S.chat.dark) { paintDraft(buf, f, { ghostOnly: true }); return }
+
+  // the status row and the header hold still through the scroll
+  ui.status(buf, f, 'chat.status', { bat: 2 })
+  say(buf, 'chat.header', f)
+
+  // the thread: thirty rows low until his line comes, then on its spring,
+  // the cover sampled where the scroll has carried it, cut to the rows
+  // between the header and her field as the thread is
+  const dy = f < S.chat.arrive ? LAYOUT.chat.scroll : springOf('chatScroll', f)
+  const { cover } = ui.thread(buf, f, { dy })
+  if (photo) photo.paint(buf, 'cover', f, { at: cover, clip: LAYOUT.chat.viewport })
+
+  // her field, the draft in it, and the caret
+  ui.field(buf, f)
+  paintDraft(buf, f)
+  if (caretOn(f)) {
+    // (at its full light while the key is held, so it reads beside the
+    // dimmed letters it leaves)
+    const c = caretAt(draftOf(), f)
+    const solid = f >= SOLID[0] && f < SOLID[1]
+    rect(buf, [c.i, c.j, c.i + CARET.w - 1, c.j + c.h - 1], lin(hexOf(TEXT['chat.draft1'].col)), { k: solid ? 1 : DRAFT_K })
+  }
+}
+
+// A step of the panel's flow at `t` (ms): while she reads his line and
+// clears her draft, her field keeps putting its lilac into the dark from
+// its two lower corners, just outside it, as her note's glass does on
+// friday (fri.js), with a push out from each that turns a little every
+// step, the two corners opposite ways, so her lilac winds out under the
+// thread in the panel's veins and the stars catch round her draft while
+// she reads (FLOW.feed.chat; at the first reel's 0.0016 nothing moved and
+// the chat was a still screenshot until the first delete). As strong as
+// her draft is lit, so it dims with the draft as she clears it
+const FIELD = LAYOUT.chat.field
+const CORNERS = [
+  { x: midX(FIELD[0]), y: midY(FIELD[3] + 2), out: -1 },
+  { x: midX(FIELD[2]), y: midY(FIELD[3] + 2), out: 1 },
+]
+// On the cut from the hook, the first reel's own move at a cut (its fl.fade
+// at the cut to `ifnot`): the hook's white burst at the bar's end taken
+// down to a faint haze where it is, so it does not carry over into the
+// chat as a cluster of white crosses with no light round them, a glitter
+// sticker beside Bee's bubble
+const BURST_FADE = { r: 260, amount: 0.65 }
+export function flow(fl, t) {
+  const F = FLOW.feed.chat
+  const f = Math.round(fr(t))
+  if (f === S.chat.from) fl.fade(LAYOUT.hook.burst.x, LAYOUT.hook.burst.y, BURST_FADE.r, BURST_FADE.amount)
+  if (f < F.from || f >= F.to) return
+  const at = draftLight(f)
+  if (!at) return
+  const ink = lin(`${F.tint}.glow`).map((c) => c * F.a * at.k)
+  const v = F.push * F.pushStep
+  for (const c of CORNERS) {
+    // out from the field, turning down and under it, the left corner's
+    // from pointing left, the right's from pointing right
+    const th = (c.out > 0 ? 0 : Math.PI) + c.out * F.turn * (f - F.from)
+    fl.ink(c.x, c.y, ink, F.r)
+    fl.push(c.x, c.y, v * Math.cos(th), v * Math.sin(th), F.pushR)
+  }
+}
+
+// The light this scene places in the panel at `t` (ms), into `L`: what her
+// draft throws on the dark round the field, as every lit thing in the film
+// throws its light (the sent glass, the bolt, her note, the count). It is
+// as strong as the draft is lit, and stands where its light is: so as she
+// clears it the light goes back along the lines after the caret and dims
+// to what the ghost keeps, and when the backlight dies it goes with it.
+// Its veins turn round the field and drift out along themselves while she
+// reads (`turn`, `flow`, a second), as her note's glass's do on friday, so
+// the dark round her draft is alive (at the sky's own slow drift, R 260
+// and 0.16, the chat was a still screenshot until the first delete)
+const GLOW = { R: 380, a: 0.24, flow: 0.5, turn: 0.45 }
+// where the draft's light stands at `f` (px) and how much of it is lit
+function draftLight(f) {
+  const D = draftOf()
+  let sum = 0
+  let all = 0
+  let x = 0
+  let y = 0
+  for (const line of D.lines) {
+    for (const c of line.chars) {
+      const n = c.cells.length
+      if (!n) continue
+      const k = c.gone <= f ? retention(f, c.gone) : 1
+      const cx = (c.i0 + c.i1) / 2
+      sum += n * k
+      all += n
+      x += n * k * cx
+      y += n * k * (line.j + 5)
+    }
+  }
+  if (!(sum > 0)) return null
+  return { x: midX(x / sum), y: midY(y / sum), k: sum / all }
+}
+export function light(t, L) {
+  const f = fr(t)
+  if (f < S.chat.from || f >= S.chat.dark) return
+  const at = draftLight(f)
+  if (!at) return
+  const s = t / 1000
+  L.source({
+    x: at.x, y: at.y, R: GLOW.R, a: GLOW.a * at.k,
+    col: lin('lilac.glow'), seed: 1.7, flow: GLOW.flow * s, turn: GLOW.turn * s, crest: 0.25, body: 1, time: s,
+  })
+}
