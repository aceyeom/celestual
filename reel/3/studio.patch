+// ── reel 3 · name ───────────────────────────────────────────────────────────
+//
+// 9 · name (1920 to 2080): the door's latch, and a hard cut to the lockup in
+// the panel's own cells (reel3-TREATMENT.md shot 9, reel3-CONTRACT.md 11.11
+// and 12.1). It is set at LAYOUT.name.lock, the first reel's own card,
+// centred on the frame, its star on the art's sun's row: the cut changes
+// everything on the screen but the light, which carries over it in the
+// sun's own warm light the frame before (coda.js SUN_GLOW) and the star's
+// warm white the frame after.
+//
+//   1920   every cell of it on in the cut frame: chalk, the star's in the
+//          warm white. Nothing comes on, nothing morphs, nothing is lit from
+//          the star (the first reel's ending, and its lockup lit cell by cell
+//          from its star, are this film's never). The panel's light is taken
+//          down 0.6 in the one step, as the first reel took its down at its
+//          cut into `ifnot` (its fl.fade), so the coda's old ink does not lie
+//          behind the mark as a lopsided cloud with dark curls in it
+//   1920+  a rose bloom opens round the star from the cut, and not before it
+//          (no rose stood between the two dancing figures): its round points
+//          centred on the star, strong enough to stay rose over the panel's
+//          Purkinje knee to the end (LIGHTS.last), still opening as the film
+//          ends
+//   1940   the address, all at once (reel3.jsx's, the one line in the DOM)
+//
+// The hand is still from the latch on, and the sky is rose at 0.55 to the
+// end; both are the frame's (reel3.jsx).
+import { SCENES, S, COL, LIGHTS, LAYOUT, fr } from '../reel3-time.js'
+import { lin } from '../reel3-cells.js'
+import * as ui from '../reel3-ui.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.name
+
+// the rose round the star (LIGHTS.last), from the cut
+const BLOOM = LIGHTS.last
+// what the cut takes of the panel's light, everywhere, in its one step
+const CUT_FADE = 0.6
+// how far a drop of ink has spread `dt` seconds after it fell (reel-aura.js
+// `drop`, which a scene may not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+
+// nothing to work out before the first frame
+export function prime() {}
+
+// The frame: the lockup, into the captions' layer, as the brand is laid over
+// the picture and never shaken; the phone's own cells (`buf`) stay empty
+export function paint(t, buf, titles) {
+  ui.lockup(titles, { k: 1 })
+}
+
+// the flow: on the cut, the panel's light taken down in one step (the
+// first reel's own move at its cut into `ifnot`)
+export function flow(fl, t) {
+  if (Math.round(fr(t)) === S.name.from) fl.fade(0, 0, 0, CUT_FADE)
+}
+
+// the rose round the star, opening from the cut
+export function light(t, L) {
+  const f = fr(t)
+  const dt = (f - S.name.from) / 60
+  if (!(dt >= 0 && dt < BLOOM.life)) return
+  const [x, y] = LAYOUT.name.starPx
+  L.source({
+    x, y,
+    R: BLOOM.R0 + BLOOM.R * drop(dt, BLOOM.tau),
+    a: BLOOM.a * (1 - dt / BLOOM.life) ** 1.2,
+    col: lin(COL.rose.glow), crest: BLOOM.crest, body: BLOOM.body, flow: BLOOM.flow * dt, time: dt,
+  })
+}
