+  const byP = [...cells].sort((a, b) => rosy[b] - rosy[a] || a - b)
+  const span = byP.map((n) => rosy[n]).sort((a, b) => a - b)
+  const lo = span.length ? span[Math.floor(0.05 * (span.length - 1))] : 0
+  const hi = span.length ? span[Math.floor(0.98 * (span.length - 1))] : 1
+  const q = new Uint8Array(VW * VH)
+  const turnAt = new Int16Array(VW * VH)
+  const lv = new Float32Array(VW * VH)
+  // the heads' grey: half by how pink, half by the photograph's own light
+  // pulled off its neighbours (reel3-photo.js LOOK.limbo `pull`), laid
+  // over the heads' own span, so each head is lightest in its middle and
+  // its round edge is cut against the next
+  const tSpan = cells.map((n) => toned[n]).sort((a, b) => a - b)
+  const tLo = tSpan.length ? tSpan[Math.floor(0.05 * (tSpan.length - 1))] : 0
+  const tHi = tSpan.length ? tSpan[Math.floor(0.98 * (tSpan.length - 1))] : 1
+  let x = 0
+  let y = 0
+  byP.forEach((n, r) => {
+    const i = n % VW
+    const j = Math.floor(n / VW)
+    q[n] = clamp(3 + Math.floor(5.5 * clamp((rosy[n] - lo) / (hi - lo || 1)) + hash(i + 9, j + 4)), 0, 8)
+    turnAt[n] = T.rose + 2 * Math.floor((r / byP.length) * (T.roseSpread / 2))
+    const tu = clamp((toned[n] - tLo) / (tHi - tLo || 1))
+    lv[n] = HEAD[0] + (HEAD[1] - HEAD[0]) * (0.5 * (q[n] / 8) + 0.5 * tu)
+    x += i
+    y += j
+  })
+  // a fold turns with the petals beside it, at the step their pinkness
+  // gives it, a step under theirs; in the grey a dip under the heads'
+  // darkest step (FOLD), the cut between one head and the next
+  for (const n of folds) {
+    const i = n % VW
+    const j = Math.floor(n / VW)
+    const u = rosy[n] < 0 ? 0 : clamp((rosy[n] - lo) / (hi - lo || 1))
+    q[n] = clamp(2 + Math.floor(5.5 * u + hash(i + 9, j + 4)), 0, 8)
+    turnAt[n] = T.rose + 2 * Math.floor(T.roseSpread / 4)
+    lv[n] = FOLD * HEAD[0]
+  }
+  // the rest in the photograph's own order: its light laid from dark glass
+  // to the sky's own in eight steps; the hands dark glass whatever their
+  // light (in the photograph their skin is as light as the sky)
+  for (let n = 0; n < lv.length; n++) {
+    if (!inPic[n] || soft[n]) continue
+    if (isHand[n]) { lv[n] = DARK; continue }
+    const i = n % VW
+    const j = Math.floor(n / VW)
+    const u = (luma[n] - LUMA[0]) / (LUMA[1] - LUMA[0])
+    const k = clamp(Math.floor(7.5 * clamp(u, 0, 1.12) + hash(i + 17, j + 3)), 0, 9) / 8
+    lv[n] = DARK + (skyAt(j) - DARK) * Math.max(0, k) ** 1.4
+  }
+  // the heads' middle, and their thirds left to right, each a light the
+  // turn lets through (BOUQUET_GLOW)
+  const mid = cells.length ? { x: midX(x / cells.length), y: midY(y / cells.length) } : { x: midX(40), y: midY(40) }
+  const byX = [...cells].sort((a, b) => (a % VW) - (b % VW) || a - b)
+  const parts = []
+  for (let p = 0; p < BOUQUET_GLOW.parts; p++) {
+    const part = byX.slice(Math.floor((p * byX.length) / BOUQUET_GLOW.parts), Math.floor(((p + 1) * byX.length) / BOUQUET_GLOW.parts))
+    if (!part.length) continue
+    let px = 0
+    let py = 0
+    for (const n of part) { px += n % VW; py += Math.floor(n / VW) }
+    parts.push({ x: midX(px / part.length), y: midY(py / part.length) })
+  }
+  return { soft, leaf, q, turnAt, hand: isHand, lv, sky, inPic, mid, parts }
+}
+
+// once, before the first frame: the halos, the wash's map and every cell's
+// turn, the keepsake; and with the photographs, the ring's map, the bouquet
+// and the hand
+export function prime(photos) {
+  ready()
+  if (photos) ringOf(photos)
+}
+
+// The captions' cells this frame, and every cell within one of them: where
+// the picture is kept dark for them. Answers whether there are any
+function nearTitles(titles) {
+  NEAR.fill(0)
+  let any = false
+  const M = GRID.MARGIN
+  const W = GRID.CW
+  for (let j = 0; j < VH; j++) {
+    for (let i = 0; i < VW; i++) {
+      if (titles.rgba[((j + M) * W + i + M) * 4 + 3] <= 0.01) continue
+      any = true
+      for (let b = -1; b <= 1; b++) {
+        const q = j + b
+        if (q < 0 || q >= VH) continue
+        for (let a = -1; a <= 1; a++) {
+          const p = i + a
+          if (p >= 0 && p < VW) NEAR[vis(p, q)] = 1
+        }
+      }
+    }
+  }
+  return any
+}
+
+// The roses (reel3-CONTRACT.md 11.9, 1): the picture developing, each
+// cell at OVER the step it comes up and SETTLE the next, then at its level
+// in the print (`lv`); from the re-read the bouquet's heads turn to the
+// rose, a cell at a time, as light through their petals, the whole grey
+// photograph still round them, the stems and the hands dark against its
+// sky, holding the roses out; from the press all of it goes by the three
+// steps. Each cell is a square of the night's mid at its level, hiding the
+// dark behind it, the sky's windows letting the panel's light through as
+// the panel draws it (SKY_PASS) and showing SKY_SHOW of the dark behind
+// them at their lightest, so the panel's slow light turns in the sky;
+// round the captions' letters the picture is kept dim, and round the
+// strip's words and `it’s mutual` darker, falling off with distance (never
+// round the bouquet: only the words get the dark)
+function roses(buf, f, titles, photo) {
+  ringOf(photo)
+  const B = BOUQUET
+  const rest = f < T.rosesOut ? 1 : Math.max(stepsOut(f, T.rosesOut), T.limboHold)
+  const gone = stepsOut(f, T.bouquetOut)
+  const fe = even(f)
+  const near = f < T.reread && nearTitles(titles)
+  const stripK = f < TEXT['strip.label'].cut ? stepsOut(f, T.stripOut) : 0
+  const mutualK = f >= T.mutual ? on(f, T.mutual, MUTUAL_ON) : 0
+  const ringing = f < RING_END
+  const turnOf = (n) => (f >= T.rose && B.soft[n] ? on(fe, B.turnAt[n], ROSE_TURN) : 0)
+  const lastRow = photo.at('limbo')[1] + photo.grid('limbo').ch - 1
+  const M = GRID.MARGIN
+  const { rgba, shape, pass } = buf
+  // the count's own light kept off the picture's windows round it, and
+  // the picture's own light there taken down
+  const ci = (DIGITS_MID.x - GRID.GX) / GRID.C - 0.5
+  const cj = (DIGITS_MID.y - GRID.GY) / GRID.C - 0.5
+  LEVEL.fill(0)
+  for (let j = 0; j <= lastRow; j++) {
+    for (let i = 0; i < VW; i++) {
+      const n = vis(i, j)
+      if (!B.inPic[n]) continue
+      const since = fe - REACH[n]
+      if (since < 0) continue
+      const head = B.soft[n]
+      // the whole of it to the press, which takes all of it (the sky's
+      // `rest` is the press's own three steps)
+      let k = (B.soft[n] || B.lv[n] <= DARK ? 1 : rest) * gone
+      if (ringing && since < 2 * T.ringStep && f < T.linesOut) k *= since < T.ringStep ? OVER : SETTLE
+      if (!(k > 0)) continue
+      let w = 1
+      if (!B.soft[n]) {
+        if (near && NEAR[n]) w *= UNDER_TITLE
+        const pl = Math.max(stripK * plateAt(STRIP_D[n], i, j), mutualK * plateAt(MUTUAL_D[n], i, j))
+        if (pl > 0) w *= 1 - (1 - UNDER_STRIP) * pl
+      }
+      let cw = 1
+      if (stripK > 0) {
+        const d = Math.hypot(i - ci, j - cj) * GRID.C
+        if (d < COUNT_NEAR[1]) cw = smooth(COUNT_NEAR[0], COUNT_NEAR[1], d)
+      }
+      // the photograph's foot thinning into the dark
+      if (j > lastRow - FOOT) k *= clamp((lastRow - j) / FOOT + 0.8 * (hash(i + 3, j + 9) - 0.5))
+      if (!(k > 0)) continue
+      LEVEL[n] = k
+      const b = (j + M) * GRID.CW + i + M
+      const o = b * 4
+      const own = B.lv[n] * k * w * (COUNT_OWN + (1 - COUNT_OWN) * cw)
+      const tn = turnOf(n)
+      if (tn > 0) {
+        // the head's own light from its grey to its step of the rose, and
+        // its petals letting the rose's light through, a fold a little
+        const c = ROSE_STEPS[B.q[n]]
+        const rk = ROSE_K * gone * (B.leaf[n] ? FOLD : 1)
+        for (let ch = 0; ch < 3; ch++) rgba[o + ch] = MID[ch] * own * (1 - tn) + c[ch] * rk * tn
+        pass[b] = head ? ROSE_PASS * tn * (B.q[n] / 8) * gone : 0
+      } else {
+        for (let ch = 0; ch < 3; ch++) rgba[o + ch] = MID[ch] * own
+        const win = B.soft[n] ? 0 : B.sky[n]
+        pass[b] = SKY_PASS * win * k * w * (COUNT_PASS + (1 - COUNT_PASS) * cw)
+      }
+      // what it hides of the dark behind it: all of it but some of the
+      // sky's (its windows show the panel's light turning behind the
+      // print); and under the strip's words more, by the darkening
+      const pl = B.soft[n] ? 0 : Math.max(stripK * plateAt(STRIP_D[n], i, j), mutualK * plateAt(MUTUAL_D[n], i, j))
+      rgba[o + 3] = Math.max(Math.min(1, k) * (1 - SKY_SHOW * B.sky[n]), PLATE * pl)
+      shape[b] = 0
+    }
+  }
+}
+
+// The wash over the list (reel3-CONTRACT.md 11.9, 5): where a cell's block
+// has turned, the list cell going out over four frames, the turn's soft
+// lead of the rose's glow (LEAD, four steps, dithered and only round his
+// note), the rose page under it, and the keepsake over the page, as a word
+// or a glass is laid on a page: each line of it, and each glass, whole,
+// S.nine.washLag frames after the last of its cells has turned
+// (LINE_TURN), so his words are never bitten into fragments. A bare page
+// cell hides PAGE_HIDE of the dark behind it, so its sky and stars come
+// through, and lets the panel's light through it, a step more as it turns
+// (the product's p1 and p2, given to what it lets through and not to its
+// own dim rose); it is drawn as the panel's light is, a round point, its
+// fade the page's own falloff. The keepsake's cells hide all of it. The
+// cells of `it’s mutual` keep the word through the turn and go in its own
+// three steps from S.nine.mutualOut into what the wash has made of them,
+// so the film's first rose line is never bitten mid-word
+const MUTUAL_KEEP = new Set()
+function wash(buf, f) {
+  const M = GRID.MARGIN
+  const W = GRID.CW
+  const { rgba, shape, pass } = buf
+  const K = KEEP
+  const keepWord = f < T.mutualOut + 12
+  const wordK = stepsOut(f, T.mutualOut)
+  if (!MUTUAL_KEEP.size) for (const [i, j] of MUTUAL_CELLS) MUTUAL_KEEP.add(vis(i, j))
+  for (let j = 0; j < VH; j++) {
+    for (let i = 0; i < VW; i++) {
+      const v = vis(i, j)
+      const tf = TURN[v]
+      if (f < tf) continue
+      const since = f - tf
+      const kOut = 1 - on(f, tf, OUT_F)
+      const kIn = on(f, LINE_TURN[v] + T.washLag, IN_F)
+      const boost = since < T.washStep ? 0.35 : since < 2 * T.washStep ? 0.15 : 0
+      const fall = pageK(i, j)
+      const st = Math.floor(since / T.washStep)
+      const lead = st < LEAD.length ? LEAD[st] * (1 - LEAD_DITHER + LEAD_DITHER * hash(i + 41, j + 7)) * smooth(LEAD_NEAR[0], LEAD_NEAR[1], fall / PAGE_K) : 0
+      const n = (j + M) * W + i + M
+      const o = n * 4
+      // the word, as it stands before the wash touches it
+      const word = keepWord && MUTUAL_KEEP.has(v)
+      const was = word ? [rgba[o], rgba[o + 1], rgba[o + 2], rgba[o + 3], pass[n], shape[n]] : null
+      const ka = K.rgba[o + 3] * kIn
+      const under = KEEP_HALO[v]
+      const pk = fall * (1 - ka) * (under ? UNDER_KEEP.page : 1)
+      for (let c = 0; c < 3; c++) rgba[o + c] = rgba[o + c] * kOut + PAGE[c] * pk + K.rgba[o + c] * kIn + ROSE_LIT[c] * lead * (1 - ka)
+      rgba[o + 3] = Math.max(rgba[o + 3] * kOut, PAGE_HIDE + (1 - PAGE_HIDE) * ka)
+      pass[n] = pass[n] * kOut + PAGE_PASS * (fall / PAGE_K) * (1 + boost) * (1 - ka) * (under ? UNDER_KEEP.pass : 1)
+      // (the glass, the names and `from Owen` in their squares; every
+      // other cell of the page a round point)
+      if (kOut < 0.5 || lead > 0) shape[n] = ka > 0.5 && K.rgba[o + 3] >= 0.5 ? K.shape[n] : 4
+      if (was) {
+        for (let c = 0; c < 4; c++) rgba[o + c] = was[c] * wordK + rgba[o + c] * (1 - wordK)
+        pass[n] = was[4] * wordK + pass[n] * (1 - wordK)
+        if (wordK > 0.5) shape[n] = was[5]
+      }
+    }
+  }
+}
+
+// the frame: back to front, the roses, the strip, `it’s mutual`, the slot,
+// and the wash over them, to the hard cut
+export function paint(t, buf, titles, photo) {
+  ready()
+  const f = fr(t)
+  if (photo && f >= T.ring && f < T.bouquetOut + 12) roses(buf, f, titles, photo)
+  if (f < TEXT['strip.label'].cut) ui.strip(buf, f)
+  // (whole until its own three steps, which the wash lays over what it has
+  // made of the word's cells; a cell of it the wash has not reached steps
+  // out as it is)
+  if (f >= T.mutual && f < TEXT['nine.mutual'].cut) say(buf, 'nine.mutual', f, { k: TEXT['nine.mutual'].k * on(f, T.mutual, MUTUAL_ON) * (f >= MUTUAL_TURN ? 1 : stepsOut(f, T.mutualOut)) })
+  if (f >= T.slot) ui.slot(buf, f, { k: on(f, T.slot, SLOT_ON) })
+  if (f >= T.wash[0]) wash(buf, f)
+}
+
+// The captions this scene lights a cell at a time (TEXT `enter`). Each
+// cell's own frame is its own hash's, one of four delivered frames from the
+// line's (`CATCH`), never an order across the line: no sweep, the line
+// condenses where it is as the panel's cells catch. `the walk.` comes on so
+// (the limbo's cells catching round it); `he hadn’t` and `seen mine.` are lit
+// by the rose: each cell comes up in the rose's mid and goes to chalk over
+// `ROSE_TO` frames from its own (`titleTint`)
+const CATCH = 4
+const ROSE_TO = 8
+const catchOf = (x, i, j) => x.on + 2 * Math.floor(hash(i + 5, j + 11) * CATCH)
+const ROSE_MID = lin(COL.rose.mid)
+const LIT_BY_ROSE = new Set(['nine.hadnt', 'nine.mine'])
+export function titleLevel(key, f) {
+  const x = TEXT[key]
+  if (!x || !(key === 'nine.walk' || LIT_BY_ROSE.has(key))) return null
+  const fe = even(f)
+  return (i, j) => on(fe, catchOf(x, i, j), 4)
+}
+export function titleTint(key, f) {
+  if (!LIT_BY_ROSE.has(key)) return null
+  const x = TEXT[key]
+  const fe = even(f)
+  return { rgb: ROSE_MID, u: (i, j) => clamp((fe - catchOf(x, i, j)) / ROSE_TO) }
+}
+
+// The rose into the panel's flow (reel3-CONTRACT.md 11.9): round the
+// slot's middle from the press's end to the wash's, with a push round it
+// turned a little each step, so the ink winds into a spiral; on every step
+// of the wash, spilled at the front as it passes, pushed a little on
+// outward; past the wash, from a point travelling round his glass's middle
+// (FLOW.nineRose `glass`), pushed on along its way round, so the current
+// circles his note behind the page while he is read; and at the press the
+// bouquet's rose poured in from where its heads were. As the limbo starts
+// to develop, the white the count's seconds left under it is taken down
+// where each opened (sat.js `tickPoints`), so no pool of it stands under
+// the limbo's caption
+const TICK_FADE = { r: 120, amount: 0.7 }
+export function flow(fl, t) {
+  const f = Math.round(fr(t))
+  if (f === T.ring) for (const p of tickPoints()) fl.fade(p.x, p.y, TICK_FADE.r, TICK_FADE.amount)
+  const B = FLOW.nineBouquet
+  if (f >= T.bouquetOut && f < T.bouquetOut + T.bouquetInk && BOUQUET) {
+    fl.ink(BOUQUET.mid.x, BOUQUET.mid.y, lin(COL[B.tint].glow).map((c) => c * B.a), B.r)
+  }
+  if (f < T.ink || f >= T.uiOut) return
+  ready()
+  const R = FLOW.nineRose
+  const glow = lin(COL[R.tint].glow)
+  const { x, y } = LAYOUT.keep.ink
+  // while the wash goes, at its own, tapering over the wash's last steps to
+  // its hold; past the wash at its hold, winding on behind the page while
+  // he is read, tapering to nothing over the last steps before the cut
+  const end = T.ink + T.inkSteps
+  const a = f < end ? R.hold + (R.a - R.hold) * Math.min(1, (end - f) / R.taper) : R.hold * Math.min(1, (T.uiOut - f) / R.taper)
+  if (f >= T.wash[1]) {
+    // round his glass's middle, the way round turned R.glassTurn a step,
+    // and the push on along it, so the current circles the note
+    const o = orbitAt(f)
+    fl.ink(o.x, o.y, glow.map((v) => v * a), R.r)
+    const v = SWIRL.v * SWIRL.held
+    fl.push(o.x, o.y, v * o.ux, v * o.uy, SWIRL.pushR)
+    return
+  }
+  const th = SWIRL.turn * (f - T.ink)
+  const c = Math.cos(th)
+  const s = Math.sin(th)
+  fl.ink(x + R.orbit[0] * c, y + R.orbit[1] * s, glow.map((v) => v * a), R.r)
+  // (the push given SWIRL.pushStep of itself a step, as the first reel's
+  // currents give theirs; whole each step it ran to a jet, and the rose
+  // went up the panel as smoke)
+  const v = SWIRL.v * SWIRL.pushStep
+  fl.push(x + SWIRL.r * c, y + SWIRL.r * s, -v * s, v * c, SWIRL.pushR)
+  // (less as the front goes out, so the panel's edges keep their dark)
+  const step = Math.floor((f - T.wash[0]) / T.washStep)
+  const pts = FRONTS[step] || []
+  const less = 1 - 0.7 * (step / T.washSteps)
+  for (const p of pts) {
+    const dx = p.x - x
+    const dy = p.y - y
+    const d = Math.hypot(dx, dy) || 1
+    fl.ink(p.x, p.y, glow.map((v) => v * SPILL.a * less * (0.6 + 0.8 * p.h)), SPILL.r)
+    fl.push(p.x, p.y, (SPILL.push * SWIRL.pushStep * dx) / d, (SPILL.push * SWIRL.pushStep * dy) / d, SPILL.pushR)
+  }
+}
+
+// the slot's backlight level at a frame (the flicker's steps, S.nine.flicker)
+function flickerAt(f) {
+  const F = T.flicker
+  if (f < F[0][0]) return 0
+  let v = 0
+  for (const [g, x] of F) if (f >= g) v = x
+  return v
+}
+
+// The light this scene places: the count's glow until the strip has gone;
+// the bouquet's as it turns; `it’s mutual`'s; the slot's; the rose's out of
+// the slot as the wash goes; his glass's once the rose has reached it. Her
+// footfalls under his note are heard and not lit (their light read as a
+// smudge and a scribble, never as steps)
+export function light(t, L) {
+  ready()
+  const f = fr(t)
+  const s = t / 1000
+  const rose = lin(COL.rose.glow)
+  if (f < TEXT['strip.label'].cut) {
+    const G = COUNT_GLOW
+    const at = centreOf(ui.stripDigits(countAt(f)))
+    L.source({
+      x: at.x, y: at.y, R: G.R0 + G.R * drop((t - ms(S.sat.from)) / 1000, G.tau) + G.limbo.R * drop((t - ms(T.ring)) / 1000, G.limbo.tau), a: G.a * stepsOut(f, T.stripOut),
+      col: lin(COL.white.glow), seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+    })
+    // and the roll over's own bloom, as each second's in shot 6
+    tickLight(t, L, at)
+  }
+  if (f >= T.rose && f < T.bouquetOut + 12 && BOUQUET) {
+    const G = BOUQUET_GLOW
+    const dt = (t - ms(T.rose)) / 1000
+    BOUQUET.parts.forEach((p, n) => {
+      L.source({
+        x: p.x, y: p.y, R: G.R0 + G.R * drop(dt, G.tau), a: G.a * on(f, T.rose, T.roseSpread) * stepsOut(f, T.bouquetOut),
+        col: rose, seed: G.seed + 1.3 * n, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+      })
+    })
+  }
+  if (f >= T.mutual) {
+    const G = MUTUAL_GLOW
+    const dt = (t - ms(T.mutual)) / 1000
+    const k = on(f, T.mutual, MUTUAL_ON) * stepsOut(f, T.mutualOut)
+    L.source({
+      x: MUTUAL_MID.x, y: MUTUAL_MID.y, R: G.R0 + G.R * drop(dt, G.tau), a: G.a * k, col: rose,
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+    })
+  }
+  if (f >= T.slot && f < T.wash[0] + OUT_F) {
+    const G = SLOT_GLOW
+    const pressed = f >= T.press[0] && f < T.press[1]
+    const k = pressed ? G.press : G.edge + G.back * flickerAt(f)
+    const { x, y } = LAYOUT.keep.ink
+    L.source({
+      x, y, R: G.R, a: k * on(f, T.slot, SLOT_ON) * (1 - on(f, T.wash[0], OUT_F)), col: rose,
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, time: s,
+    })
+  }
+  if (f >= T.wash[0]) {
+    const G = WASH_GLOW
+    const dt = (t - ms(T.wash[0])) / 1000
+    const { x, y } = LAYOUT.keep.ink
+    L.source({
+      x, y, R: G.R0 + G.R * drop(dt, G.tau), a: roseHeld(f), col: rose,
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * dt, turn: G.turn * dt, time: dt,
+    })
+  }
+  // the turn's small lights just ahead of the front, a few of each step's
+  // blocks, each for SPARK.life steps
+  if (f >= T.wash[0] && f < T.wash[1] + SPARK.life * T.washStep) {
+    const now = Math.floor((f - T.wash[0]) / T.washStep)
+    for (let m = Math.max(0, now - SPARK.life + 1); m <= Math.min(now, T.washSteps - 1); m++) {
+      const age = (f - (T.wash[0] + m * T.washStep)) / (SPARK.life * T.washStep)
+      for (const p of (FRONTS[m] || []).slice(0, SPARK.n)) {
+        L.source({
+          x: p.x, y: p.y, R: SPARK.R, a: SPARK.a * (1 - age), col: rose,
+          seed: SPARK.seed + 7.1 * p.h, crest: SPARK.crest, body: SPARK.body, time: s,
+        })
+      }
+    }
+  }
+  // his note's own rose, out from the middles of his glass's four edges
+  if (f >= GLASS_TURN + T.washLag) {
+    const N = LIGHTS.note
+    const dt = (t - ms(GLASS_TURN + T.washLag)) / 1000
+    const k = on(f, GLASS_TURN + T.washLag, N.in)
+    for (const e of NOTE_EDGES) {
+      L.source({
+        x: e.x, y: e.y, R: N.R0 + N.R * drop(dt, N.tau), a: N.a * k, col: rose,
+        seed: e.seed, crest: N.crest, body: N.body, flow: N.flow * dt, turn: e.spin * N.turn * dt, dir: e.dir, soft: N.soft, time: dt,
+      })
+    }
+  }
+  // the rose going round his note, past the wash, tapering to the cut as
+  // its ink does
+  if (f >= T.wash[1] && f < T.uiOut) {
+    const G = ORBIT_GLOW
+    const o = orbitAt(f)
+    const k = on(f, T.wash[1], 20) * Math.min(1, (T.uiOut - f) / FLOW.nineRose.taper)
+    L.source({
+      x: o.x, y: o.y, R: G.R, a: G.a * k, col: rose,
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, time: s,
+    })
+  }
+  // (his glass's white goes with his glass at the cut; the rose round it
+  // is the panel's, and stays)
+  if (f >= GLASS_TURN + T.washLag && f < T.held) {
+    const G = GLASS_GLOW
+    const dt = (t - ms(GLASS_TURN + T.washLag)) / 1000
+    const at = LAYOUT.keep.glass
+    L.source({
+      x: midX((at[0] + at[2]) / 2), y: midY((at[1] + at[3]) / 2), R: G.R0 + G.R * drop(dt, G.tau),
+      a: G.a * on(f, GLASS_TURN + T.washLag, IN_F), col: lin(COL.white.glow),
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+    })
+  }
+}
+
+// for the bench and the checks: the ring's map as worked out (null before
+// the photographs are in)
+export const ringMap = () => (REACH ? { reach: REACH, end: RING_END } : null)
