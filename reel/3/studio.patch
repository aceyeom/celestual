+    const from = name === 'release' ? MO.springOf('press', o.at) : o.from
+    const reach = Math.max(Math.abs(o.to - from), Math.abs(o.expect?.peak ?? 0), Math.abs(o.expect?.under ?? 0))
+    ok(reach >= 4 || DRAWN[name] != null, `${name} (${reach.toFixed(2)} cells) is four cells or more, or drawn as light leaning`, DRAWN[name] || 'not drawn')
+    ok(DRAWN[name] != null, `${name} says how it is drawn`, DRAWN[name] || '')
+  }
+}
+
+// ── the wash (contract 9) ───────────────────────────────────────────────────
+begin('wash')
+{
+  const { bw, bh, th } = W.spreadMap()
+  ok(bw === LAYOUT.wash.blocks[0] && bh === LAYOUT.wash.blocks[1], 'the panel in 77 × 137 blocks of 2 × 2 cells', `${bw} × ${bh}`)
+  ok(Math.min(...th) === 0 && Math.abs(Math.max(...th) - 0.98) < 1e-6, 'thresholds laid 0..0.98, nearest block to farthest (under the front\'s last step)')
+  ok(W.spreadMap() === W.spreadMap(LAYOUT.wash.from), 'worked out once for its rect')
+  let all = true
+  let last = 0
+  for (let j = 0; j < GRID.VIS_H; j++) {
+    for (let i = 0; i < GRID.VIS_W; i++) {
+      const f = W.turnF(i, j)
+      if (f > last) last = f
+      if (!W.washState(i, j, S.nine.wash[1]).turned) all = false
+    }
+  }
+  ok(all, `every cell turned by F${S.nine.wash[1]}`)
+  ok(last < S.nine.wash[1], 'every block has turned by the front\'s last step, before the wash ends', `F${last}`)
+  ok(W.turnF(76, 160) === S.nine.wash[0], 'the slot\'s middle turns at once', `F${W.turnF(76, 160)}`)
+  // in step with the clock's front: a block has turned at f exactly when
+  // the front `washAt(f).p` is past its threshold
+  let agree = true
+  for (let f = S.nine.wash[0]; f < S.nine.wash[1]; f++) {
+    const p = T.washAt(f).p
+    for (let k = 0; k < th.length; k += 7) {
+      const i = 2 * (k % bw)
+      const j = 2 * Math.floor(k / bw)
+      if ((W.turnF(i, j) <= f) !== (th[k] < p)) agree = false
+    }
+  }
+  ok(agree, 'turnF agrees with washAt\'s front at every frame')
+  const st = (since) => W.washState(76, 160, S.nine.wash[0] + since).boost
+  ok(st(-1) === 0 && st(0) === 0.35 && st(1) === 0.35 && st(2) === 0.15 && st(3) === 0.15 && st(4) === 0, 'a block just turned is +0.35, then +0.15, then settles')
+  // the slot's own blocks first, all of them at once: the rose grows out of
+  // the slot (reel3-wash.js `RAMP`)
+  const r = LAYOUT.wash.from
