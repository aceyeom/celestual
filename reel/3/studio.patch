+  }
+  // a page of her note comes on where it is: no sheet's spring
+  ok(!SPRINGS.sheetMenu && !SPRINGS.sheetAsk, 'her note\'s pages do not rise (the notification is the one arrival from below)')
+  // her walker at the scrubber's end leaning on each footfall, as on the pin
+  {
+    const o = SPRINGS.walkerStep
+    for (const a of o.at) {
+      const [f, v] = peakOf(run('walkerStep', a, a + 20))
+      ok(near(v, o.expect.peak, 0.01) && f - a === o.expect.peakF, `walkerStep leans ${o.expect.peak} at +${o.expect.peakF} f from F${a}`, `${v.toFixed(4)} at +${f - a}`)
+    }
+  }
+  // the half press never commits, and drains
+  {
+    const o = SPRINGS.press
+    const vs = run('press', o.at, S.fri.release)
+    const [f, v] = peakOf(vs)
+    ok(near(v, o.expect.peak, 0.001) && f - o.at === o.expect.peakF, `press peaks ${o.expect.peak} at +${o.expect.peakF} f`, `${v.toFixed(4)} at +${f - o.at}`)
