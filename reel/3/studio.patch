+++ b/app/src/studio/parts/reel3-wash.js
@@ -0,0 +1,204 @@
+// ── reel 3 · the wash ───────────────────────────────────────────────────────
+//
+// The reveal growing out of the slot at nine (F1426 to 1522) is the
+// product's own backlight turning, copied: the panel in square blocks of
+// two cells, each block turning on its own step, by how far it is from
+// where the turn leaves from, pushed on or held back by two octaves of a
+// slow noise and a jitter of its own, so the front is ragged at the block
+// and grows in lobes and islands, never as a circle. The front steps on the
+// product's ease (pixmark.js `washFrom`, WASH_EASE 1.6), a step every two
+// frames here (33 ms, the product's 40 rounded to the film's even frames),
+// and a block that has just turned is drawn a step lighter and settles (the
+// product's p1 and p2).
+//
+// `hash3`, `noise` and `spreadMap` are app/src/wall/PixelStory.jsx's
+// (lines 485 to 555, "the pink, a few cells at a time"), copied with their
+// maths unchanged; only what they are measured on is this panel's: the
+// distance is to a rectangle (the slot, LAYOUT.wash.from) and not to a
+// point, and the product's whole field is drawn 1.6 times larger for a
+// panel of 154 cells across and not 95: the noise lattices (19 and 7 become
+// 30 and 11, LAYOUT.wash.lattice) and, with them, how far the noise and the
+// jitter push the front (`AMP`). Scaled in its lattices alone the field's
+// lobes came out 1.6 times as wide and no deeper, and on this tall panel
+// the front read as the slot's rounded outline grown, a few frames ragged
+// (3 steps between the first and last block of a ring round the slot; 5
+// with `AMP`). And on this panel the slot is three quarters of its width,
+// so even with `AMP` the front went up and down the screen as a straight
+// band with a ragged edge, a wipe. So here, as nine was tuned on the panel
+// (reel3-CONTRACT.md 14), the noise pushes `DEEP` times as far again (five
+// times the product's own in all), and it fades in over the first `RAMP`
+// cells out of the rect: the rect's own blocks turn first, all of them,
+// and the rose grows out of it in lobes and leaves islands. No block
+// outside the rect turns before `FLOOR` of its distance says, or before the
+// rect's own blocks whatever their jitter. `washP` and `washAt` are
+// pixmark.js's (lines 736 to 747), and live in reel3-time.js beside the
+// frames they step on.
+//
+// Nothing here touches the page: node reads it, and scripts/reel3-check.mjs
+// asserts that the front is lobed.
+
+import { GRID, LAYOUT, S, washP } from './reel3-time.js'
+
+export { washP, washAt } from './reel3-time.js'
+
+// ── copied from PixelStory.jsx ──────────────────────────────────────────────
+const smoothstep = (k) => k * k * (3 - 2 * k)
+// a number from three others, the same every time it is asked
+// (PixelStory.jsx `hash3`, verbatim)
+export function hash3(a, b, c) {
+  let h = Math.imul(a ^ 0x9e3779b9, 0x85ebca6b) ^ Math.imul(b + 0x632be5ab, 0xc2b2ae35) ^ Math.imul(c + 0x27d4eb2f, 0x165667b1)
+  h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d)
+  return ((h ^ (h >>> 13)) >>> 0) / 4294967296
+}
+// a smooth noise, -1 to 1, on a lattice `w` cells apart
+// (PixelStory.jsx `noise`, verbatim)
+export function noise(x, y, w, salt) {
+  const fx = x / w
+  const fy = y / w
+  const i = Math.floor(fx)
+  const j = Math.floor(fy)
+  const u = smoothstep(fx - i)
+  const v = smoothstep(fy - j)
+  const a = hash3(i, j, salt)
+  const b = hash3(i + 1, j, salt)
+  const c = hash3(i, j + 1, salt)
+  const d = hash3(i + 1, j + 1, salt)
+  return 2 * (a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v) - 1
+}
+
+// ── the blocks ──────────────────────────────────────────────────────────────
+const SPREAD = LAYOUT.wash.block
+const BW = Math.ceil(GRID.VIS_W / SPREAD)
+const BH = Math.ceil(GRID.VIS_H / SPREAD)
+const [LAT_A, LAT_B] = LAYOUT.wash.lattice
+// the product's field drawn larger: its pushes grow with its lattices
+const AMP = LAT_A / 19
+// and pushed further on this panel, faded in out of the rect, and held to a
+// floor (see above); JIT is the jitter's reach at half, so no block outside
+// the rect turns before the rect's own
+const DEEP = 5 / 1.6
+const RAMP = 20
+const FLOOR = 0.35
+const JIT = AMP * 3.4 * 0.5
+const STEPS = S.nine.washSteps
+// the farthest block's threshold, a little under the front's last step
+const TOP = 0.98
+const ramp = (d) => smoothstep(Math.min(1, Math.max(0, d / RAMP)))
+
+// how far a point is from a rect of whole cells, in cells, and none inside
+// it: the point in the cells' own measure (a cell i spans i to i + 1, so its
+// middle is i + 0.5), the rect from its first cell's edge to its last's
+function dRect(x, y, [i0, j0, i1, j1]) {
+  const dx = Math.max(i0 - x, 0, x - (i1 + 1))
+  const dy = Math.max(j0 - y, 0, y - (j1 + 1))
+  return Math.hypot(dx, dy)
+}
+
+// The panel's blocks and, for each, the moment it turns, as a threshold
+// 0..1, the nearest block to the farthest (PixelStory.jsx `spreadMap`, its
+// sum the product's: the distance, seven of the wide noise, 2.6 of the
+// fine, and 3.4 of the block's own jitter; the noise ×AMP·DEEP and faded in
+// over RAMP, the jitter ×AMP, see above). A block (bi, bj) is the cells
+// (2bi..2bi+1, 2bj..2bj+1), and is measured at its middle. Worked out once
+// for each rect it leaves from
+const MAPS = new Map()
+export function spreadMap(rect = LAYOUT.wash.from) {
+  const key = rect.join(',')
+  const had = MAPS.get(key)
+  if (had) return had
+  const th = new Float32Array(BW * BH)
+  let lo = Infinity
+  let hi = -Infinity
+  for (let bj = 0; bj < BH; bj++) {
+    for (let bi = 0; bi < BW; bi++) {
+      const x = (bi + 0.5) * SPREAD
+      const y = (bj + 0.5) * SPREAD
+      const d = dRect(x, y, rect)
+      const jit = AMP * 3.4 * (hash3(bi, bj, 3) - 0.5)
+      const v = d > 0 ? Math.max(FLOOR * d + JIT, d + ramp(d) * AMP * DEEP * (7 * noise(x, y, LAT_A, 1) + 2.6 * noise(x, y, LAT_B, 2)) + jit) : jit
+      // (its ends read back as kept, so they lay at exactly 0 and 1)
+      const n = bj * BW + bi
+      th[n] = v
+      if (th[n] < lo) lo = th[n]
+      if (th[n] > hi) hi = th[n]
+    }
+  }
+  // (laid 0 to TOP: the front's last step is 1, and a block at exactly 1
+  // was left unturned on it, a dead cell on the page's top edge to the
+  // wash's very end)
+  for (let k = 0; k < th.length; k++) th[k] = (TOP * (th[k] - lo)) / (hi - lo || 1)
+  const out = { bw: BW, bh: BH, th }
+  MAPS.set(key, out)
+  return out
+}
+
+// For each block, the step of the wash it turns on: the first step `n`
+// whose front has passed it (th < washP((n + 1) / 48), as `washAt` steps
+// it); every block has turned by the front's last step
+const TURNS = new Map()
+function turnsOf(rect) {
+  const key = rect.join(',')
+  const had = TURNS.get(key)
+  if (had) return had
+  const { th } = spreadMap(rect)
+  const fronts = Array.from({ length: STEPS }, (_, n) => washP((n + 1) / STEPS))
+  const steps = new Uint8Array(th.length)
+  for (let k = 0; k < th.length; k++) {
+    let n = 0
+    while (n < STEPS && !(th[k] < fronts[n])) n++
+    steps[k] = n
+  }
+  TURNS.set(key, steps)
+  return steps
+}
+// a visible cell's block; the cells of the panel's margin, off the frame,
+// take the block at the edge they are past, as the product's edge blocks
+// run on to its canvas's edges
+const blockOf = (i, j) => {
+  const bi = Math.min(BW - 1, Math.max(0, Math.floor(i / SPREAD)))
+  const bj = Math.min(BH - 1, Math.max(0, Math.floor(j / SPREAD)))
+  return bj * BW + bi
+}
+
+// the step (0..48) a cell's block turns on
+export function turnStep(i, j, rect = LAYOUT.wash.from) {
+  return turnsOf(rect)[blockOf(i, j)]
+}
+// and its frame
+export function turnF(i, j, rect = LAYOUT.wash.from) {
+  return S.nine.wash[0] + S.nine.washStep * turnStep(i, j, rect)
+}
+
+// A cell at frame `f`: whether its block has turned, how many frames ago,
+// and how much lighter it is drawn for it, a step at +0.35 and the next at
+// +0.15, then settled (PixelStory.jsx `spreadBlocks`, its p1 and p2)
+export function washState(i, j, f, rect = LAYOUT.wash.from) {
+  const since = f - turnF(i, j, rect)
+  const turned = since >= 0
+  const boost = !turned ? 0 : since < S.nine.washStep ? 0.35 : since < 2 * S.nine.washStep ? 0.15 : 0
+  return { turned, since, boost }
+}
+
+// ── the page ────────────────────────────────────────────────────────────────
+// The rose page the wash leaves (nine) and the coda holds: how strong it is
+// at a cell, LAYOUT.wash.page under the keepsake (its names, his glass,
+// `from Owen`: LAYOUT.wash.keepRect) and falling off from that rect's edge
+// over `pageFall` cells to `pageEdge` of it, so the panel keeps its dark
+// toward its edges and corners and the page is the note's ground, not a
+// slab over the whole frame. Worked out once, a visible cell at a time
+let PAGE_K = null
+export function pageK(i, j) {
+  if (!PAGE_K) {
+    const P = LAYOUT.wash
+    PAGE_K = new Float32Array(GRID.VIS_W * GRID.VIS_H)
+    for (let y = 0; y < GRID.VIS_H; y++) {
+      for (let x = 0; x < GRID.VIS_W; x++) {
+        const d = dRect(x + 0.5, y + 0.5, P.keepRect)
+        PAGE_K[y * GRID.VIS_W + x] = P.page * (P.pageEdge + (1 - P.pageEdge) * Math.exp(-d / P.pageFall))
+      }
+    }
+  }
+  const x = Math.min(GRID.VIS_W - 1, Math.max(0, i))
+  const y = Math.min(GRID.VIS_H - 1, Math.max(0, j))
+  return PAGE_K[y * GRID.VIS_W + x]
+}
