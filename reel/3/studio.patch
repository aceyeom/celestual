+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.nine
+
+const T = S.nine
+const VW = GRID.VIS_W
+const VH = GRID.VIS_H
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+const smooth = (a, b, x) => { const k = clamp((x - a) / (b - a)); return k * k * (3 - 2 * k) }
