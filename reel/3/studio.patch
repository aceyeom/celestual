+export default { id: 'celestual-reel-3', w: 1080, h: 1920, ms: MS, fps: 60, Film }
diff --git a/app/src/studio/films/reel3-ui-ref.jsx b/app/src/studio/films/reel3-ui-ref.jsx
new file mode 100644
index 0000000..d1c9565
--- /dev/null
+++ b/app/src/studio/films/reel3-ui-ref.jsx
@@ -0,0 +1,213 @@
+// ── reel 3 · the product's own screens, for the cells to be held against ────
+//
+// Not a film: one frame, eight panels of the third reel's frame (1080 by
+// 1920 each, four across and two down), each the product's real screen for
+// one of reel3-ui.js's painters, at product size, drawn by the product's own
+// components and stylesheets and set on the same rect of the frame the
+// painter sets its glass on. Over each, dashed, the rects the painter draws
+// to (reel3-time.js LAYOUT), and under it the panel's own cells, a 6 px
+// square and a dark pixel every 7 from (3, 5), so a still of this and a
+// still of the bench (reel3-ui.js `debug`, frames 3100 on) are one frame
+// apart in what they say and nothing else:
+//
+//   0  1:41, the note sheet done (screens/Ping.jsx 1202-1221)
+//   1  her note in the vault (screens/You.jsx 712-726)
+//   2  its menu (You.jsx 673-684)
+//   3  let it go? (You.jsx 685-693)
+//   4  the reveal strip on its last day (You.jsx 296-331; the strip is a
+//      function of that file and not exported, so it is its markup, in the
+//      product's own profile.css)
+//   5  the slot landing, searching, and held (Slot.jsx `MutualSlot`)
+//   6  the keepsake's note (Keepsake.jsx 944-983; its `Note` and `Pane` are
+//      the file's own, so their markup, in the product's mutual.css)
+//   7  the phone's glyphs (looks.js PIX) at a cell a pixel of theirs
+//
+// It is never sampled into the film: at 7 px a cell the product's words
+// would be mush, and the film's words are the face's own cells. What it is
+// for is the structure: what stands on each band, where the glyphs are, the
+// glass's colours. Where the cells depart from it is on purpose and said in
+// reel3-ui.js (the words at C, a glass the safe zone's width, one band row,
+// the count not rose before nine).
+//
+//   OUT=<dir> node scripts/studio-film.mjs reel3-ui-ref --stills 0
+//
+// The slot and the strip's stylesheet are only fetched when this film is
+// the one on the page (they are the product's account sheet, with more of
+// the product behind them), so every other film is untouched by it.
+import { useEffect, useState } from 'react'
+import { Board, Screen, ScreenText, useHold } from '../kit.jsx'
+import { ScreenMenu, ScreenNote, PixIcon } from '../../wall/screen.jsx'
+import { SQUARE } from '../../wall/PixelStory.jsx'
+import { LAYOUT, TEXT } from '../parts/reel3-time.js'
+
+const W = 1080
+const H = 1920
+const C = 7
+const px = (i) => 3 + C * i
+const py = (j) => 5 + C * j
+// a rect of cells as a box on the frame, its last cell's square included
+const box = ([i0, j0, i1, j1]) => ({ left: px(i0), top: py(j0), width: C * (i1 - i0 + 1) - 1, height: C * (j1 - j0 + 1) - 1 })
+const PANELS = [[0, 0], [1, 0], [2, 0], [3, 0], [0, 1], [1, 1], [2, 1], [3, 1]]
+
+// the panel's unlit cells, so the product's screen is seen over the grid
+// its cells will be on: a dark pixel at x ≡ 2 and y ≡ 4 (mod 7)
+const GRID = {
+  backgroundColor: '#15171B',
+  backgroundImage: 'linear-gradient(90deg, #000 1px, transparent 1px), linear-gradient(180deg, #000 1px, transparent 1px)',
