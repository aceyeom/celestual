+const LEVEL = new Float32Array(VW * VH)
+// a mask grown (or, `out` false, shrunk) by a disc of radius `r` cells
+function grow(m, r, out = true) {
+  const o = new Uint8Array(m.length)
+  const disc = []
+  for (let b = -r; b <= r; b++) for (let a = -r; a <= r; a++) if (a * a + b * b <= r * r + r) disc.push([a, b])
+  for (let j = 0; j < VH; j++) {
+    for (let i = 0; i < VW; i++) {
+      let hit = !out
+      for (const [a, b] of disc) {
+        const p = i + a
+        const q = j + b
+        const v = p >= 0 && q >= 0 && p < VW && q < VH ? m[vis(p, q)] : 0
+        if (out && v) { hit = true; break }
+        if (!out && !v) { hit = false; break }
+      }
+      o[vis(i, j)] = hit ? 1 : 0
+    }
+  }
+  return o
+}
+function bouquetOf(photo) {
+  const mask = photo.mask('limbo')
+  const hand = photo.mask('limbo', 'hand')
+  const skyOf = photo.mask('limbo', 'sky')
+  const rosyOf = photo.mask('limbo', 'rosy')
+  const g = photo.grid('limbo')
+  const raw = new Uint8Array(VW * VH)
+  const isHand = new Uint8Array(VW * VH)
+  const rosy = new Float32Array(VW * VH)
+  const luma = new Float32Array(VW * VH)
+  const toned = new Float32Array(VW * VH)
+  const sky = new Float32Array(VW * VH)
+  const inPic = new Uint8Array(VW * VH)
