+    his: 100, run: [80, 120], burst: 120, n51: 120,
+  },
+  // 2 · the long table, tue 1:12 am. Owen's line arrives and the thread
+  // scrolls on a spring; she reads; she clears her draft, a letter, a pause,
+  // five letters, then whole words; the backlight dies and the ghost stays
+  // (his line comes half a beat early, at 180, so it has eighty frames on
+  // the screen before her draft starts going)
+  chat: {
+    from: 160, to: 400, arrive: 180, read: [180, 260],
+    dels: [260, 290, 296, 302, 308, 314], words: [322, 330, 338],
+    // the caret blinks on its period, and is solid while the key is held
+    // and a moment after its last press (the last word's frame and 12)
+    caret: 32, solid: [260, 350], dark: 360,
+  },
+  // 3 · 1:41. Two frames of black, the backlight's ramp, its light six
+  // frames behind; the send's light leaks into the panel; the side button,
+  // and the crystal relaxes: held four frames, then out, its hue turning
+  sent: {
+    from: 400, to: 560, black: [400, 402], ramp: [402, 424], glow: [408, 430], leak: [424, 500],
+    relax: 520, relaxHold: 4, relaxTau: 110, relaxGone: 552,
+  },
