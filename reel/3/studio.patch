+    return out
+  }
+  for (const group of [rectCells(G), rectCells(LAYOUT.keep.hers.glass), cellsOf('nine.names'), cellsOf('nine.from')]) {
+    let last = 0
+    for (const [i, j] of group) if (i >= 0 && i < VW && j >= 0 && j < VH) last = Math.max(last, TURN[vis(i, j)])
+    for (const [i, j] of group) if (i >= 0 && i < VW && j >= 0 && j < VH) LINE_TURN[vis(i, j)] = last
+  }
+  // the keepsake, at full, for the wash to bring on where it has turned
+  KEEP = new CellBuf()
+  ui.keepsake(KEEP, T.uiOut - 1)
+  NEAR = new Uint8Array(VW * VH)
+}
+
+// The develop's map, once the photographs are in: the print, and the frame
+// each cell of it comes up on
+function ringOf(photo) {
+  ready()
+  if (REACH_OF === photo) return
+  BOUQUET = bouquetOf(photo)
+  REACH = new Int16Array(VW * VH)
+  let last = T.ring
+  for (let j = 0; j < VH; j++) {
+    for (let i = 0; i < VW; i++) {
+      const n = vis(i, j)
+      REACH[n] = reachOf(n, i, j)
+      if (BOUQUET.inPic[n] && REACH[n] > last) last = REACH[n]
+    }
+  }
+  // the overdrive is over once the last cell up has settled
+  RING_END = last + 2 * T.ringStep
