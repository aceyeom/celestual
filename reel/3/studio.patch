+const SKY = [0.34, 0.22]
+const SKY_ROW = 150
+const skyAt = (j) => SKY[0] + (SKY[1] - SKY[0]) * clamp(j / SKY_ROW)
+const HEAD = [0.15, 0.22]
+const DARK = 0.03
