@@ -0,0 +1,153 @@
+// ── reel 3 · wed ────────────────────────────────────────────────────────────
+//
+// 4a and 4b · wednesday (560 to 800): her lock screen, the day after. No
+// photograph on it, no day, no date: its wallpaper is the panel's own night,
+// with the lilac the send leaked on tuesday still drifting in it
+// (reel3-TREATMENT.md shots 4a and 4b, reel3-CONTRACT.md 11.6).
+//
+//   560   always on and dim (the clock at 0.25 of chalk), the battery empty
+//         and blinking, as a phone at 4% does: on sixteen frames, off
+//         fourteen, so it turns on even frames and the mix down to thirty
+//         never halves it
+//   600   plugged in. The screen wakes to full in one step of two frames
+//         (a wake, not the power-on: that was tuesday's), the bolt lights
+//         beside the 4% in his white, the one bright thing, and the battery
+//         takes its first bar and stops blinking. What the bolt throws on the
+//         dark spreads from it as ink does, and a puff of his white goes
+//         into the panel's flow beside her lilac, turning as it goes. Two
+//         lights in one dark; they never meet
+//   600   `he lent me / his charger.` comes on with the wake, `nothing told
+//         him` at 620 and `about tuesday.` at 640, and the jump cut at 720
+//         takes all four (the captions are reel3.jsx's, from TEXT).
+//         While it charges the bolt keeps putting a little of his white into
+//         the dark beside it (FLOW.feed.wed)
+//   720   later. A jump cut on the same object: 10:58, 31%, no bolt, and the
+//         cut lands with Bee's notification already rising from forty rows
+//         under its place, on motion-dom's spring (SPRINGS.notification, let
+//         go two frames before the cut): past by 2.9 rows at 730, settled by
+//         739, drawn as light leaning, its leading rows coming on over the
+//         cut's first four frames. Its light rises in the dark with it. No
+//         caption: the screen says it (`lost you two`)
+
+import { SCENES, S, LAYOUT, FLOW, COL, fr, ms, cellX, cellY, midX, midY } from '../reel3-time.js'
+import { lin, on } from '../reel3-cells.js'
+import { springOf } from '../reel3-motion.js'
+import * as ui from '../reel3-ui.js'
+import { carry } from './sent.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.wed
+
+const W = S.wed
+const LATER = S.later
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+// how far a drop of ink has spread `dt` seconds after it fell: quickly, then
+// slower and slower, never stopping (reel-aura.js `drop`, which a scene may
+// not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+
+// The bolt on the frame (px): the middle of its 5 × 9 cells, LAYOUT.lock.bolt
+const BOLT = LAYOUT.lock.bolt
+const BOLT_PX = { x: (cellX(BOLT[0]) + cellX(BOLT[2]) + 6) / 2, y: (cellY(BOLT[1]) + cellY(BOLT[3]) + 6) / 2 }
+// the notification card's middle (px) at rest; its spring carries it `dy`
+// rows lower
+const CARD = LAYOUT.lock.card
+const CARD_PX = { x: midX((CARD[0] + CARD[2]) / 2), y: midY((CARD[1] + CARD[3]) / 2) }
+const CARD_ROWS = CARD[3] - CARD[1] + 1
+
+// The empty battery's blink in the always-on dim: a 30 frame period from the
+// cut, lit for its first sixteen (S.wed.blinkOn) and dark for fourteen, so
+// both of its turns fall on even frames (576 off, 590 on); from the charger
+// on it holds
+const batOn = (f) => f >= W.wake || (f - W.from) % W.blink < W.blinkOn
+
+// The screen's level: always on at 0.6, then the wake, to full over two
+// frames (linear, a phone's backlight stepping up, not the power-on's curve)
+const wakeK = (f) => 0.6 + 0.4 * clamp((f - W.wake) / W.wakeStep)
+
+// What the bolt throws on the dark (reel3-CONTRACT.md 11.6: R 120, a 0.5,
+// his white glow): not switched on at its full reach, but spreading out to
+// it from the bolt as light does in this panel, most of the way in a sixth
+// of a second, the rest slower
+const BOLT_GLOW = { R0: 18, R: 102, tau: 0.16, a: 0.5, crest: 0.12, body: 1, flow: 0.25, turn: 0.05, seed: 6.1 }
+
+// The puff of his white into the flow at the bolt (FLOW.wedBolt): over the
+// wake's first steps, with four pushes round it turning the same way, so it
+// opens in the panel's own spirals and lights the stars by the bolt, then
+// drifts off on the currents with what is left of her lilac
+const PUFF = FLOW.wedBolt
+
+// The card's own light on the dark (11.6: R 300, a 0.22), at the card's
+// middle wherever its spring has it, coming up as its rows do. In the
+// night's grey and not his white: it is Bee's, and white is Owen's in this
+// film
+const CARD_GLOW = { R: 300, a: 0.22, crest: 0.2, body: 1, flow: 0.08, turn: -0.02, seed: 8.3 }
+
+// once, before the first frame: the notification's spring built, so the
+// first frame asked for costs what every other does
+export function prime() {
+  springOf('notification', LATER.from)
+}
+
+// The frame. 4a: the lock screen at its level, the battery blinking until
+// the charger goes in, then the bolt and the first bar. 4b: the same lock
+// screen later, awake, and Bee's card on its spring over it
+export function paint(t, buf) {
+  const f = fr(t)
+  if (f < LATER.from) {
+    const plugged = f >= W.wake
+    ui.lock(buf, f, { k: wakeK(f), batOn: batOn(f), bolt: plugged ? 1 : 0, fill: plugged })
+    return
+  }
+  ui.lock(buf, f, { later: true })
+  ui.card(buf, f, {
+    dy: springOf('notification', f),
+    // its leading rows first: row r of the card comes on over a frame from
+    // r/30 of the way through the cut's first four
+    rowK: (r) => on(f, LATER.from + (r * LATER.rowsIn) / CARD_ROWS, 1),
+  })
+}
+
+// The flow: the puff of his white at the bolt, over the wake's first steps,
+// and from the wake to the cut a little of it every step
+export function flow(fl, t) {
+  const f = Math.round(fr(t))
+  const F = FLOW.feed.wed
+  if (f >= F.from && f < F.to) fl.ink(BOLT_PX.x, BOLT_PX.y, lin(COL[F.tint].glow).map((c) => c * F.a), F.r)
+  if (f < W.wake || f >= W.wake + PUFF.steps) return
+  const col = lin(COL[PUFF.tint].glow).map((c) => c * PUFF.a)
+  fl.ink(BOLT_PX.x, BOLT_PX.y, col, PUFF.r)
+  // four pushes round it, each along the circle (the same way round), so
+  // what goes in turns rather than rises
+  for (let q = 0; q < 4; q++) {
+    const th = (q * Math.PI) / 2 + 0.4
+    const c = Math.cos(th)
+    const s = Math.sin(th)
+    fl.push(BOLT_PX.x + PUFF.ring * c, BOLT_PX.y + PUFF.ring * s, -PUFF.swirl * s, PUFF.swirl * c, PUFF.pushR)
+  }
+}
+
+// The light placed: tuesday's lilac going over the cut; from the charger
+// on, what the bolt throws; later, the card's light, rising with the card
+export function light(t, L) {
+  const f = fr(t)
+  const s = t / 1000
+  // tuesday's lilac let go over the cut, round the 9:37 (sent.js)
+  carry(t, L)
+  if (f < LATER.from) {
+    if (f < W.wake) return
+    const dt = (t - ms(W.wake)) / 1000
+    const G = BOLT_GLOW
+    L.source({
+      x: BOLT_PX.x, y: BOLT_PX.y, R: G.R0 + G.R * drop(dt, G.tau), a: G.a, col: lin(COL.white.glow),
+      seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+    })
+    return
+  }
+  const G = CARD_GLOW
+  const dy = springOf('notification', f)
+  L.source({
+    x: CARD_PX.x, y: CARD_PX.y + 7 * dy, R: G.R, a: G.a * on(f, LATER.from, LATER.rowsIn), col: lin(COL.night.glow),
+    seed: G.seed, crest: G.crest, body: G.body, flow: G.flow * s, turn: G.turn * s, time: s,
+  })
+}
