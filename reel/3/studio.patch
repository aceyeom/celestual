+  }
+  // the live wallpaper, kicked by each footfall
+  {
+    for (const [name, e] of [['parallaxX', SPRINGS.parallaxX.expect], ['parallaxY', SPRINGS.parallaxY.expect]]) {
+      const a0 = SPRINGS[name].at[0]
+      const [f, v] = peakOf(run(name, a0, a0 + 30))
+      ok(near(v, e.peak, 0.001) && f - a0 === e.peakF, `${name} peaks ${e.peak} at +${e.peakF} f`, `${v.toFixed(4)} at +${f - a0}`)
+    }
