+      R: BLOOM.R0 + BLOOM.R * drop(dt, BLOOM.tau),
+      a: BLOOM.a * (1 - clamp(dt / BLOOM.life)) ** 1.2,
+      col: lin(COL.white.glow), seed: BLOOM.seed, crest: BLOOM.crest, body: BLOOM.body,
