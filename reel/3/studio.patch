+let REACH = null
+let STRIP_D = null
+let MUTUAL_D = null
+let MUTUAL_CELLS = null
+let KEEP_HALO = null
+let DIGITS_MID = null
+let TURN = null
+let LINE_TURN = null
+let FRONTS = null
+let KEEP = null
+let NEAR = null
+let MUTUAL_MID = null
+let MUTUAL_TURN = 0
+let GLASS_TURN = 0
+let RING_END = 0
