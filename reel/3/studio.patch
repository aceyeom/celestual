+// ── a note's band ───────────────────────────────────────────────────────────
+// The status band of a note's glass, one row of it here where the product
+// has two (screen.jsx 627-668): the pen (`icon: 'pen'`), the line beside it,
+// and the battery its writer left it on at the far end, all in the skin's
+// `lit`. On the done sheet the line is the greeting (`dear Owen`, Ping.jsx
+// 1151-1153); in the vault it is the day it was placed (`stamp`, You.jsx
+// 663-670), since `dear Owen` is said once in the film
+function noteBand(buf, f, tint, { pen, line, bat, k, a }) {
+  const lit = lin(skin(tint).lit)
+  if (pen) glyph(buf, 'pen', pen.i, pen.j, lit, { k, a })
+  if (line) say(buf, line, f, { k: TEXT[line].k * k, a })
+  if (bat) battery(buf, bat.n, bat.right, bat.j, lit, k, a, 'right')
+}
+
+// ── 1:41, the note sheet's done state (shot 3) ──────────────────────────────
+// Ping.jsx 1172-1173 the heading, `sent privately.`; 1202-1221 her note's
+// screen once it is out: the pen and `dear Owen` on its band with the
+// battery she left it on (`bat: faceNow.bat`), no keys (`keys={done ? {} :
+// …}`), and on its body a ScreenNote, the check and `till this saturday`
+// (`endsWords`, sent on a tuesday). The note's line under it (`if they send
+// you one by then…`), the stamp and the rule are left out (the treatment's
+// stylisations): what she wrote is not on this screen
+export function noteDone(buf, f, { k = 1 } = {}) {
+  if (!(k > 0)) return
+  const a = clamp(k)
+  const L = LAYOUT.sent
+  status(buf, f, 'sent.status', { bat: null, k })
+  say(buf, 'sent.heading', f, { k: TEXT['sent.heading'].k * k, a })
+  // (the soft keys' band the product keeps on the glass with nothing on it,
+  // `keys={done ? {} : …}`, screen.jsx 671-675, is left out: at C and empty
+  // it read as an unfinished slab under her words, LAYOUT.sent)
+  glass(buf, L.glass, 'lilac', { back: 0.5, band: L.band, lift: 0.45, k })
+  noteBand(buf, f, 'lilac', { pen: L.pen, line: 'sent.dear', bat: { n: 2, ...L.bat }, k, a })
+  glyph(buf, 'check', L.check.i, L.check.j, lin('lilac.ink'), { k, a })
+  say(buf, 'sent.till', f, { k: TEXT['sent.till'].k * k, a })
+  say(buf, 'sent.saturday', f, { k: TEXT['sent.saturday'].k * k, a })
+}
+
+// ── the lock screen (shot 4) ────────────────────────────────────────────────
+// Anybody's phone, locked: the clock at 3C, the battery and its figure under
+// it, and once it is plugged in the bolt beside them. No wallpaper but the
+// panel's own night, no date. `k` is the always-on level (0.6 dim, 1
+// awake); the bolt is lit by `bolt` alone, in his white, the one bright
+// thing when the charger goes in. `batOn` false is the empty battery's blink
+// in its off half
+export function lock(buf, f, { later = false, k = 1, batOn = true, bolt = 0, fill = false } = {}) {
+  if (!(k > 0)) return
+  const a = clamp(k)
+  const L = LAYOUT.lock
+  const night = lin('night.lit')
+  const clock = later ? 'later.clock' : 'wed.clock'
+  const pct = later ? 'later.pct' : 'wed.pct'
+  say(buf, clock, f, { k: TEXT[clock].k * k, a })
+  say(buf, pct, f, { k: TEXT[pct].k * k, a })
+  if (batOn) {
+    const at = later ? L.batLater : L.bat
+    battery(buf, later ? 2 : fill ? 1 : 0, at.i, at.j, night, DIM * k, a)
+  }
+  if (bolt > 0 && !later) glyph(buf, 'bolt', L.bolt[0], L.bolt[1], lin('white.lit'), { k: 0.9 * bolt, a: clamp(bolt) })
+}
+
+// The notification over it: Bee's name and her line in an outline with its
+// corners clipped, over a card of dark glass that hides most of the stars
+// behind it, as a phone's notification is a plate over the lock screen. All
+// of it `dy` rows lower (its spring), and each of its own 30 rows at
+// `rowK(r)`, so its leading rows can come on first
+export function card(buf, f, { dy = 0, k = 1, rowK = () => 1 } = {}) {
+  if (!(k > 0)) return
+  const R = LAYOUT.lock.card
+  const [i0, j0, i1, j1] = R
+  const row = (j) => clamp(rowK(j - j0), 0, 1.15)
+  // the plate: dark glass, blocking the dark behind it to 0.7
+  const plate = []
+  for (let j = j0; j <= j1; j++) for (let i = i0; i <= i1; i++) if (!((i === i0 || i === i1) && (j === j0 || j === j1))) plate.push([i, j, row(j)])
+  lean(buf, plate, 0, dy, [0, 0, 0], { k: 1, a: 0.7 * clamp(k) })
+  // its edge, ash at 0.35, the corners left out
+  const edge = []
+  for (let i = i0 + 1; i < i1; i++) { edge.push([i, j0, row(j0)]); edge.push([i, j1, row(j1)]) }
+  for (let j = j0 + 1; j < j1; j++) { edge.push([i0, j, row(j)]); edge.push([i1, j, row(j)]) }
+  lean(buf, edge, 0, dy, lin('ash'), { k: 0.35 * k, a: clamp(k) })
+  for (const key of ['later.from', 'later.body']) {
+    const x = TEXT[key]
+    const lay = typeLayout(x.s, x.i, x.j, { size: x.size, align: x.align })
+    lean(buf, lay.cells.map(([i, j]) => [i, j, row(j)]), 0, dy, lin(hexOf(x.col)), { k: x.k * k, a: clamp(k) })
+  }
+}
+
+// ── her note in the vault (shot 5) ──────────────────────────────────────────
+// You.jsx 643-692, `NoteScreen`, two of its pages on one glass:
+//
+//   note   the band (663-670): the pen, the day it was placed (`stamp`) and
+//          the battery she left it on (`bat: p.bat`); the body her words
+//          (`ScreenText text={p.line}`, 713-714), the one time they are
+//          read; the keys `options` and `back` (716-725)
+//   ask    the band as the note's; `ScreenNote`'s title, `let it go?`, and
+//          its line under it (687-689), from the row her words began on, its
+//          first sentence left out (the treatment's stylisation); the keys
+//          `let it go` and `keep it` (690-693)
+//
+// The film goes from the note straight to the ask (the menu between them,
+// 673-684, is cut). A page a press opens comes on as an LCD's rows do,
+// where they are, over four frames (`rows`, the scene's level for the
+// page's words and key labels); the glass, its band and the keys' plates
+// hold still
+//
+// The keys here are drawn as plates, an outline round each label, so a
+// press has a shape to fill (the product's keys are words on the band,
+// screen.css 264-275). `press = {key: 'l' | 'r', depth, edge}`: the key
+// inverted from its foot up over its 15 rows by `depth` (cells.invert, the
+// product's press, light leaning for the row the fill has reached), its
+// outline lit `edge` over its rest
+const KEY_EDGE = 0.35
+const KEY_LIGHT = 0.5
+export function noteFace(buf, f, { page = 'note', press = null, k = 1, rows = 1 } = {}) {
+  if (!(k > 0)) return
+  const a = clamp(k)
+  const L = LAYOUT.fri
+  const sk = skin('lilac')
+  const keysBand = [L.keys.l[1] - 2, L.glass[3]]
+  glass(buf, L.glass, 'lilac', { back: 0.5, band: L.band, keys: keysBand, k })
+  const keyWords = page === 'ask' ? ['fri.keyLet', 'fri.keyKeep'] : ['fri.keyOptions', 'fri.keyBack']
+  noteBand(buf, f, 'lilac', { pen: L.pen, line: 'fri.stamp', bat: { n: 2, ...L.bat }, k, a })
+  const body = page === 'ask' ? ['fri.askTitle', 'fri.ask1', 'fri.ask2'] : ['fri.note1', 'fri.note2']
+  const rk = clamp(rows) * k
+  if (rk > 0) for (const key of body) say(buf, key, f, { k: TEXT[key].k * rk, a: clamp(rk) })
+  const lit = lin(sk.lit)
+  for (const [side, word] of [['l', keyWords[0]], ['r', keyWords[1]]]) {
+    const R = L.keys[side]
+    const pressed = press && press.key === side
+    if (rk > 0) say(buf, word, f, { k: TEXT[word].k * rk, a: clamp(rk) })
+    outline(buf, R, lit, { k: KEY_EDGE * k, a })
+    if (!pressed) continue
+    invert(buf, R, { depth: press.depth, light: times(lit, KEY_LIGHT * k), ink: lin(sk.ink), rows: L.pressRows })
+    // the plate's edge stays lit over the fill, and pressure lights it more
+    outline(buf, R, lit, { k: (KEY_EDGE + (press.edge || 0)) * k, a })
+  }
+}
+
+// ── the reveal strip (shots 6 and 7) ────────────────────────────────────────
+// You.jsx 296-331, `RevealStrip`, as the whole frame: `reveals in`, the
+// count (`countdown`, on the last day the phone's clock with its seconds,
+// 309), and `sat · 9pm pt` (325). Its Seal is left out (an envelope). The
+// count changes by the LCD's redraw (reel3-cells.js `redraw`) on COUNT's
+// frames, rolling over at nine to `6d 23h`; from the re-read (F1440) all of
+// it goes out in the product's three steps. Answers the count's rect now
+export function strip(buf, f, { k = 1 } = {}) {
+  const out = stepsOut(f, S.nine.stripOut)
+  const kk = k * out
+  const C = LAYOUT.strip.count
+  const x = TEXT['strip.count']
+  if (!(kk > 0)) return { digits: stripDigits(countText(f)) }
+  const a = clamp(kk)
+  say(buf, 'strip.label', f, { k: TEXT['strip.label'].k * kk, a })
+  const d = redraw(buf, f, x.sched, { i: C.i, j: C.j, size: C.size, rgb: lin(hexOf(x.col)), k: x.k * kk })
+  say(buf, 'strip.when', f, { k: TEXT['strip.when'].k * kk, a })
+  return { digits: d.rect || stripDigits(countText(f)) }
+}
+const countText = (f) => { const s = TEXT['strip.count'].sched; let t = s[0][1]; for (const [g, v] of s) if (f >= g) t = v; return t }
+// the count's rect for a text, painting nothing (nine's ring goes out from
+// the digits of `6d 23h`)
+export function stripDigits(text) {
+  const C = LAYOUT.strip.count
+  const { cells } = typeLayout(text, C.i, C.j, { size: C.size })
+  if (!cells.length) return [C.i, C.j, C.i, C.j + 10 * C.size - 1]
+  let r = [Infinity, Infinity, -Infinity, -Infinity]
+  for (const [i, j] of cells) r = [Math.min(r[0], i), Math.min(r[1], j), Math.max(r[2], i), Math.max(r[3], j)]
+  return r
+}
+
+// ── the slot (shot 7) ───────────────────────────────────────────────────────
+// Slot.jsx 386-426 and profile.css 333-426, the mutual's small phone, as it
+// lands on the night it was told (`landing`). Not yet opened, it is the
+// night's glass (145-147, `NIGHT`) with the rose letter's edge light round
+// it (`--s-edge`), the one trace of what it is. Its band (398-405): the
+// aerial searching, and at the far end `searching…`, where the night's date
+// will stand (`.wl-slot-when`, the two in one place, 401-404, profile.css
+// 357-359 and 424-425). Its panel (406-425) lands dark (profile.css 419);
+// from F1460 its backlight catches in steps (the treatment's 1, .62, .85,
+// .45, .38, `S.nine.flicker`, profile.css 423 `wl-slot-wake` read as
+// levels), and at F1490, the flicker's last step, the band takes the
+// night's words on one frame: the date in `searching…`'s place, and the @
+// after the aerial. The product shows the @ from the start; at C the band
+// has no room for it beside `searching…`, so it lands with the date (the
+// treatment's beat). The @ is stored only salted and hashed (pings.js) and
+// is drawn as nine cells of that hash, never read. Its press
+// (F1500-1506) is the phone's inversion
+// (407-411): the panel in its ink, its edge in its light, the backlight on.
+// The face and the two sealed notes are left out (nothing in this film
+// travels toward anything).
+//
+// The panel's glass, under its veil (.38, 396-397), is lit only a tenth and
+// in the rose (reel3-CONTRACT.md 10): dark glass with a breath of rose, as
+// the light that matters is the wash that grows out of it (nine). The band
+// is the night's two dark glasses. Nothing of it is lit before F1440
+const veilOf = () => 1 - LAYOUT.slot.veil
+function flickerAt(f) {
+  const F = S.nine.flicker
+  if (f < F[0][0]) return 0
+  let v = F[0][1]
+  for (const [g, x] of F) if (f >= g) v = x
+  return v
+}
+export function slot(buf, f, { k = 1 } = {}) {
+  if (f < S.nine.slot || !(k > 0)) return
+  const a = clamp(k)
+  const L = LAYOUT.slot
+  const rose = skin('rose')
+  const night = skin('night')
+  const [i0, j0, i1, j1] = L.rect
+  const pressed = f >= S.nine.press[0] && f < S.nine.press[1]
+  // the band: the night's two dark glasses, asleep at 0.3 so it stays under
+  // the rose edge, and lit as a band is (0.5) while the press holds the
+  // backlight on
+  const band = [L.band[0] + 1, L.band[1]]
+  for (let j = band[0]; j <= band[1]; j++) {
+    const c = mixHex(night.top, night.top2, (j - band[0]) / (band[1] - band[0]))
+    for (let i = i0 + 1; i <= i1 - 1; i++) buf.set(i, j, c, (pressed ? 0.5 : 0.3) * k, a)
+  }
+  // the panel, asleep under its veil, its backlight as the flicker has it;
+  // or under the press, in its ink
+  const panel = [i0 + 1, L.panel[0], i1 - 1, L.panel[1]]
+  if (pressed) fillRect(buf, panel, lin(rose.ink), { k, a })
+  else fillRect(buf, panel, lin(rose.mid), { k: veilOf() * 0.1 * flickerAt(f) * k, a })
+  // the edge light round all of it, a cell wide, its corners clipped
+  outline(buf, [i0, j0, i1, j1], pressed ? lin(rose.lit) : lin(rose.mid), { k: (pressed ? 0.8 : L.edge) * k, a })
+  // the band's words, rose's lit at DIM: the aerial a cell clear of the @
+  // (the band's gap, profile.css 344, drawn in from its place if the @
+  // stands close), the @ and its hash, and at the far end what the night is
+  const words = lin(rose.lit)
+  const dim = DIM * k
+  const ant = rowsOf('ant')[0].length
+  glyph(buf, 'ant', Math.min(L.ant.i, L.handle.i - ant - 1), L.ant.j, words, { k: dim, a })
+  if (f < S.nine.handle) {
+    say(buf, 'nine.seek', f, { k: TEXT['nine.seek'].k * k, a })
+    return
+  }
+  const at = type(buf, '@', L.handle.i, L.handle.j, words, { k: dim, a })
+  const date = say(buf, 'nine.slotDate', f, { k: TEXT['nine.slotDate'].k * k, a })
+  // (a word's gap, six cells, kept clear before the date: at one the
+  // band read as one token, its date's first figure in the hash)
+  hashed(buf, at.i1 + 2, L.handle.j, L.handle.hashed, words, dim, a, date.i0 - 6)
+}
+// The salted handle: `n` narrow cells of the face's x-height, two columns
+// and a gap each (a letter's room at the band's size, so the run is as long
+// as a short handle), each lit where the panel's own hash says, the same
+// cells every frame: plainly a word, and plainly not one anybody can read.
+// Narrower if it would come within a gap of `until`, and a room that would
+// still reach past `until` is left off, so the gap before the date is kept
+// whatever the room. Every cell at the one level: a cell named twice (a
+// room's middle column, put in where it was nearly empty) is lit once, not
+// doubled into a bright one that read as a glitch
+function hashed(buf, i, j, n, rgb, k, a, until = Infinity) {
+  const w = Math.max(1, Math.min(2, Math.floor((until - i + 1) / n) - 1))
+  const cells = new Map()
+  for (let c = 0; c < n; c++) {
+    const x0 = i + c * (w + 1)
+    if (x0 + w - 1 > until) break
+    let lit = 0
+    for (let y = 3; y <= 9; y++) {
+      for (let x = 0; x < w; x++) {
+        if (hash(x0 + x + 31, j + y + 17) < 0.5) { cells.set(`${x0 + x},${j + y}`, [x0 + x, j + y]); lit++ }
+      }
+    }
+    // never a hole: an empty room gets its middle column
+    if (lit < 3) for (let y = 4; y <= 9; y++) cells.set(`${x0 + (w >> 1)},${j + y}`, [x0 + (w >> 1), j + y])
+  }
+  lean(buf, [...cells.values()], 0, 0, rgb, { k, a })
+}
+
+// ── the keepsake, as it comes out (shot 7) ──────────────────────────────────
+// Keepsake.jsx 944-983, scrolled to the notes, theirs first: the two of
+// them as one line (`wl-keep-pair`, 976-980), his note (`Note`, 228-252) on
+// his white glass with `dear Nadia` across its strip and his words in its
+// ink, `from Owen` under it as its figcaption (240-241). Her note below his
+// begins at the frame's foot (LAYOUT.keep.hers): only its band's edge, in
+// the frame's last rows, its cells round points of her lilac at the band's
+// dim `back` letting the page round it show (HERS_HIDE), its pen and its
+// battery at DIM, none of her words and no body of glass on the frame, so
+// his white and her lilac share the frame as the two notes share the
+// keepsake. The rose page under it all is the wash's (nine), not drawn here
+const HERS_HIDE = 0.3
+export function keepsake(buf, f, { k = 1 } = {}) {
+  if (!(k > 0)) return
+  const a = clamp(k)
+  const K = LAYOUT.keep
+  say(buf, 'nine.names', f, { k: TEXT['nine.names'].k * k, a })
+  // his glass, the one bright thing: lit over the page at 0.65 (the rest of
+  // the film's glasses are at 0.5) with a cell of its own light round its
+  // edge, so it out-shines the rose round it and the bloom gives it the
+  // halation the first reel's letters had
+  glass(buf, K.glass, 'white', { back: 0.65, band: K.band, k })
+  outline(buf, K.glass, lin('white.lit'), { k: 0.9 * k, a })
+  say(buf, 'nine.dear', f, { k: TEXT['nine.dear'].k * k, a })
+  for (const key of ['nine.his1', 'nine.his2', 'nine.his3']) say(buf, key, f, { k: TEXT[key].k * k, a })
+  say(buf, 'nine.from', f, { k: TEXT['nine.from'].k * k, a })
+  const H = K.hers
+  for (const [i, j, c] of glassCells(H.glass, 'lilac', H.band, null)) {
+    if (j < H.band[0] || j > H.band[1]) continue
+    buf.set(i, j, c, H.back * k, HERS_HIDE * a)
+    buf.setShape(i, j, 4)
+  }
+  noteBand(buf, f, 'lilac', { pen: H.pen, bat: { n: 2, ...H.bat }, k: DIM * k, a })
+}
+
+// ── the player (shot 8) ─────────────────────────────────────────────────────
+// Anybody's music player, the playlist's last seconds: the counter at the
+// top right, the play glyph beside it (the stop square from 51:00), and the
+// scrubber under the art, which is the hook's bar come back, his white
+// filled to within a sliver of its end and her walker at the end of it.
+// The counter changes plainly, each new time on over four frames (the
+// countdown's redraw, with its overshoot and its ring, is the strip's
+// alone): the cells the old time and the new share stay lit, and the
+// figures that change cross over as the crystal turns, the old one's own
+// cells going as the new one's come, so `50:5` never blinks out and no
+// frame shows half a figure. Everything in the night's light at DIM but
+// the bar's own colours (`fillK` his white's in the scrubber); `51:00` too
+// stays at DIM (at the night's lit it read with the caption on its row as
+// one line). At 51:00 the player stops as a player does when its queue
+// ends: it clears its scrubber, his white going out from her walker back
+// toward the bar's start a block of CLEAR_CELLS at a time, one block a
+// delivered frame, each by the product's three steps (`clearAt`), until
+// only the pin at 19 and her walker are lit, her lilac at its full from
+// the stop and swelling as she arrives (`swellOf`, the coda's light swells
+// with it), as she leaned on the pin at the hook's 80. The art is
+// reel3-photo.js's
+const secOf = (s) => { const [m, x] = String(s).split(':').map(Number); return m * 60 + x }
+const CLEAR_CELLS = 11
+// what is left of his white in bar cell `c` (of `cells`) at frame `f`: the
+// block it is in starts its three steps a delivered frame after the block
+// nearer her walker
+function clearAt(f, c, cells) {
+  const b = Math.floor((cells - 1 - c) / CLEAR_CELLS)
+  return stepsOut(f, S.coda.stop + 2 * b)
+}
+// her swell at frame `f`, 0..1: up over four frames from S.coda.end's last,
+// down over the rest of S.coda.swell
+export function swellOf(f) {
+  const t0 = S.coda.end[1]
+  if (f < t0) return 0
+  return on(f, t0, 4) * (1 - on(f, t0 + 4, S.coda.swell - 4))
+}
+export function player(buf, f, { k = 1, fillK = 0.5, lean: walkerLean = 0 } = {}) {
+  const sched = TEXT['coda.counter'].sched
+  if (!(k > 0) || f < sched[0][0]) return
+  const a = clamp(k)
+  const P = LAYOUT.player
+  let c = 0
+  for (let n = 0; n < sched.length; n++) if (f >= sched[n][0]) c = n
+  const now = c === 0 ? 1 : on(f, sched[c][0], 4)
+  const x = TEXT['coda.counter']
+  const ck = x.k
+  if (now >= 1) say(buf, 'coda.counter', f, { text: sched[c][1], k: ck * k, a })
+  else {
+    const at = (t) => typeLayout(t, x.i, x.j, { size: x.size, align: x.align }).cells
+    const old = at(sched[c - 1][1])
+    const cur = at(sched[c][1])
+    const key = ([i, j]) => `${i},${j}`
+    const was = new Set(old.map(key))
+    const is = new Set(cur.map(key))
+    const cells = [...cur.map(([i, j]) => [i, j, was.has(`${i},${j}`) ? 1 : now]), ...old.filter((q) => !is.has(key(q))).map(([i, j]) => [i, j, 1 - now])]
+    lean(buf, cells, 0, 0, lin(hexOf(x.col)), { k: ck * k, a })
+  }
+  const stopped = f >= S.coda.stop
+  glyph(buf, stopped ? 'stop' : 'play', P.glyph.i, P.glyph.j, lin('night.lit'), { k: DIM * k, a })
+  const end = secOf(sched[sched.length - 1][1])
+  const sw = swellOf(f)
+  bar(buf, f, {
+    bar: P.bar, cells: P.barCells, fill: (P.barCells * secOf(sched[c][1])) / end, head: 0, pin: P.pin,
+    fillAt: stopped ? (cc) => fillK * clearAt(f, cc, P.barCells) : null,
+    walker: { x: P.walker.i + walkerLean, rows: P.walker.rows, size: P.walker.size, k: stopped ? 1 + 0.25 * sw : DIM }, fillK, k,
+  })
+}
+
+// ── the lockup (shot 9) ─────────────────────────────────────────────────────
+// brand.js `LOCKUP`: the mark (MARK) and, `LOCKUP.word.x` cells on, the
+// drawn word (`wordCells`), on one grid, at C, its top left at
+// LAYOUT.name.lock. In chalk, the star's cells (MARK's `#`) in the warm
+// white; the star's middle cell is the art's sun's. Painted into the title
+// buffer, by the name scene
+export function lockup(buf, { k = 1 } = {}) {
+  if (!(k > 0)) return
+  const a = clamp(k)
+  const { i, j } = LAYOUT.name.lock
+  const star = []
+  const ring = []
+  MARK.forEach((row, y) => { for (let x = 0; x < row.length; x++) if (row[x] === '#') star.push([i + x, j + y]); else if (row[x] !== '.') ring.push([i + x, j + y]) })
+  const word = wordCells().cells.map(([x, y]) => [i + LOCKUP.word.x + x, j + y])
+  lean(buf, [...ring, ...word], 0, 0, lin('chalk'), { k, a })
+  lean(buf, star, 0, 0, lin('warm'), { k, a })
+}
+
+// ── the bench (reel3-CONTRACT.md 4.9) ───────────────────────────────────────
+// Frames 3100 to 3199, which no cut reaches: every screen at full, one a
+// frame, at the frame of the film it is drawn for, for stills
+// (`--stills 51666.67,…`, ms = frame·50/3). Each card says what it is in the
+// captions' chalk at the top. Never called by the film
+const CARDS = []
+const label = (titles, s) => type(titles, s, 11, 8, lin('chalk'), { k: 0.9 })
+// 0: the hook's bar at F70 (her light still walking, his white under her)
+// and at F120 (his white run on alone, the glow under it), and the player's
+// scrubber at its end
+CARDS.push((buf, titles) => {
+  label(titles, 'bar')
+  const H = LAYOUT.hook
+  const at = (f, dj) => {
+    const B = { ...H.bar, j0: H.bar.j0 + dj, j1: H.bar.j1 + dj }
+    const fill = hookHead(f) + 1
+    bar(buf, f, {
+      bar: B, cells: 120, fill, head: 4,
+      pin: { i: H.pin.i, above: H.pin.above.map((j) => j + dj), below: H.pin.below.map((j) => j + dj) },
+      walker: { x: f < 80 ? 16 + Math.floor(f / 2) : 56.6, rows: H.walker.rows.map((j) => j + dj), size: 3, k: 1 },
+      glowRow: f >= 80 ? H.glowRow + dj : null, glowFrom: fill - 17,
+    })
+  }
+  at(70, -100)
+  at(110, -40)
+  player(buf, S.coda.end[0] + 2, { k: 1 })
+})
+// 1: the chat at F230, the thread settled, her field (the cover's place
+// outlined, which reel3-photo.js fills)
+CARDS.push((buf, titles, f = 230) => {
+  label(titles, 'chat')
+  status(buf, f, 'chat.status', { bat: 2 })
+  say(buf, 'chat.header', f)
+  const { cover } = thread(buf, f, { dy: 0 })
+  outline(buf, [cover[0], cover[1], cover[0] + 21, cover[1] + 21], lin('white.lit'), { k: 0.15, corners: false })
+  field(buf, f)
+  say(buf, 'chat.draft1', f)
+  say(buf, 'chat.draft2', f)
+})
+// 2: the chat at F206, mid scroll: his line rising into the viewport
+CARDS.push((buf, titles, f = 206) => {
+  label(titles, 'chat scroll')
+  status(buf, f, 'chat.status', { bat: 2 })
+  say(buf, 'chat.header', f)
+  thread(buf, f, { dy: 9.4 })
+  field(buf, f)
+})
+// 3: 1:41, the done state
+CARDS.push((buf, titles) => { label(titles, 'note done'); noteDone(buf, 470) })
+// 4 to 6: the lock screen dim, awake on the charger, and later with Bee's
+// notification settling
+CARDS.push((buf, titles) => { label(titles, 'lock dim'); lock(buf, 580, { k: 0.6 }) })
+CARDS.push((buf, titles) => { label(titles, 'lock awake'); lock(buf, 610, { k: 1, bolt: 1, fill: true }) })
+CARDS.push((buf, titles) => { label(titles, 'later'); lock(buf, 740, { later: true }); card(buf, 740, { dy: 0 }) })
+// 7: the card mid rise, its leading rows coming on
+CARDS.push((buf, titles) => { label(titles, 'card rising'); lock(buf, 721, { later: true }); card(buf, 721, { dy: 17.3, rowK: (r) => on(721, 720 + (r * 4) / 30, 1) }) })
+// 8 to 14: her note, options pressed, the ask's rows coming on, the ask,
+// the half press, keep it
+CARDS.push((buf, titles) => { label(titles, 'note'); noteFace(buf, 830, { page: 'note' }) })
+CARDS.push((buf, titles) => { label(titles, 'options pressed'); noteFace(buf, 865, { page: 'note', press: { key: 'l', depth: 1, edge: 0 } }) })
+CARDS.push((buf, titles) => { label(titles, 'ask rows on'); noteFace(buf, 870, { page: 'ask', rows: 0.5 }) })
+CARDS.push((buf, titles) => { label(titles, 'ask'); noteFace(buf, 900, { page: 'ask' }) })
+CARDS.push((buf, titles) => { label(titles, 'half press'); noteFace(buf, 960, { page: 'ask', press: { key: 'l', depth: 0.561, edge: 0.3 } }) })
+CARDS.push((buf, titles) => { label(titles, 'keep it'); noteFace(buf, 1035, { page: 'ask', press: { key: 'r', depth: 1, edge: 0 } }) })
+CARDS.push(() => {})
+// 15 to 17: the strip at its first count, a frame into the roll over, and
+// a step into its going out
+CARDS.push((buf, titles) => { label(titles, 'strip'); strip(buf, S.sat.from + 10) })
+CARDS.push((buf, titles) => { label(titles, 'strip roll'); strip(buf, S.nine.roll + 1) })
+CARDS.push((buf, titles) => { label(titles, 'strip out'); strip(buf, S.nine.stripOut + 7) })
+// 18 to 21: the slot landing dark, mid flicker, the handle, the press
+CARDS.push((buf, titles) => { label(titles, 'slot seek'); slot(buf, S.nine.slot + 10) })
+CARDS.push((buf, titles) => { label(titles, 'slot flicker'); slot(buf, S.nine.flicker[3][0]) })
+CARDS.push((buf, titles) => { label(titles, 'slot handle'); slot(buf, S.nine.handle + 5) })
+CARDS.push((buf, titles) => { label(titles, 'slot press'); slot(buf, S.nine.press[0] + 2) })
+// 22: the keepsake, at full, over the rose page the wash will lay
+CARDS.push((buf, titles) => {
+  label(titles, 'keepsake')
+  fillRect(buf, [0, 0, 153, 273], lin(hexOf('rose.mid')), { k: LAYOUT.wash.page })
+  keepsake(buf, S.nine.uiOut - 1)
+})
+// 23 and 24: the player as it comes on, and at its stop
+CARDS.push((buf, titles) => { label(titles, 'player'); player(buf, S.coda.player) })
+CARDS.push((buf, titles) => { label(titles, 'player run in'); player(buf, S.coda.end[0] + 4) })
+CARDS.push((buf, titles) => { label(titles, 'player stop'); player(buf, S.coda.end[1] + 4) })
+// 25: the lockup, in the title buffer as the name scene paints it
+CARDS.push((buf, titles) => { lockup(titles) })
+export function debug(k, buf, titles) {
+  const card = CARDS[Math.round(k)]
+  if (card) card(buf, titles)
+}
