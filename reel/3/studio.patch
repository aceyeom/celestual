+
+// The photograph's cell under a visible cell, or -1
+const uvOf = (photo, i, j) => photo.cellOf('limbo', i, j)
+
+// The frame each cell of the limbo comes up on, by its level in the print
+// and not by where it is (a print developing in a tray): the darkest
+// first at S.nine.ring, the sky's lightest last by S.nine.ringBy, a
+// delivered frame a step, each cell's own hash putting it up to two steps
+// on, so a tone comes up as the cells of a panel switch and never as one
+// sheet. Out of the picture, never
+function reachOf(n, i, j) {
+  const lv = BOUQUET.lv[n]
+  const k = clamp(lv / skyAt(j))
+  return T.ring + T.ringStep * Math.min(DEVELOP, Math.floor((DEVELOP - 2) * k + 2 * hash(i + 31, j + 17)))
+}
+
+// The frame each visible cell's block turns on (reel3-wash.js), and for
+// each step of the wash a few of the blocks turning on it, spread round the
+// front, where the rose is spilled
+function washOf() {
+  const BW = Math.ceil(VW / BLOCK)
+  const BH = Math.ceil(VH / BLOCK)
+  const N = T.washSteps
+  const by = Array.from({ length: N }, () => [])
+  for (let bj = 0; bj < BH; bj++) {
+    for (let bi = 0; bi < BW; bi++) {
+      const n = turnStep(bi * BLOCK, bj * BLOCK)
+      if (n < N) by[n].push(bj * BW + bi)
+    }
+  }
+  const turn = new Int16Array(VW * VH)
+  for (let j = 0; j < VH; j++) {
+    for (let i = 0; i < VW; i++) turn[vis(i, j)] = T.wash[0] + T.washStep * turnStep(i, j)
+  }
+  // the spill: of each step's blocks, SPILL.n taken evenly round the slot's
+  // middle by their angle from it, so the rose goes out all round the front
+  const { x: cx, y: cy } = LAYOUT.keep.ink
+  const spills = by.map((ks) => {
+    const pts = ks.map((k) => {
+      const x = midX((k % BW) * BLOCK + 0.5)
+      const y = midY(Math.floor(k / BW) * BLOCK + 0.5)
+      return { x, y, a: Math.atan2(y - cy, x - cx), h: hash3(k, 7, 11) }
+    }).sort((p, q) => p.a - q.a)
