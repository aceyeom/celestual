+// (px), and which way it is going (a unit vector along its way round)
+function orbitAt(f) {
+  const R = FLOW.nineRose
+  const { x: gx, y: gy } = LAYOUT.keep.glow
+  const th = R.glassTurn * (f - T.wash[1])
+  const c = Math.cos(th)
+  const s = Math.sin(th)
+  const tx = -R.glass[0] * s
+  const ty = R.glass[1] * c
+  const tl = Math.hypot(tx, ty) || 1
