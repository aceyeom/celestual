+    ok(all.every(([, x]) => Math.abs(x) <= SPRINGS.parallaxX.expect.max), `parallaxX within ±${SPRINGS.parallaxX.expect.max} cells over the coda`, Math.max(...all.map(([, x]) => Math.abs(x))).toFixed(3))
