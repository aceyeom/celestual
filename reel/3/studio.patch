+// out on the feed's encode, reel3-TREATMENT.md F4)
+export const RETAIN = 0.18
+
+// ── every moment, in frames ─────────────────────────────────────────────────
+// Each shot's `from` and `to` are its frames, [from, to). Lists of moments
+// are in order. A moment named here and not on the twenty frame grid is in
+// `S.inAction` below, with the reason it may be.
+export const S = {
