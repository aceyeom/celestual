+  const bot = lin(hexOf('lilac.bot'))
+  ;[0, 0.25, 0.55, 1].forEach((depth, n) => {
+    const j = 30 + n * 24
+    const key = [20, j, 75, j + 15]
+    rect(buf, key, bot)
+    outline(buf, key, lit, { k: 0.8 })
+    type(buf, 'let it go', 47.5, j + 2, lit, { align: 'center' })
+    invert(buf, key, { depth, light: lit, ink: lin(hexOf('lilac.ink')), rows: 15 })
+    type(titles, String(depth), 84, j + 2, lin('chalk'), { k: 0.9 })
+  })
+})
+// 4: the redraw, at every frame of a change, the frame before to four after
+CARDS.push((buf, titles) => {
+  label(titles, 'redraw 02 to 01', 11, 8)
+  const sched = [[0, '00:00:02'], [10, '00:00:01']]
+  for (let n = 0; n < 6; n++) {
+    const f = 9 + n
+    redraw(buf, f, sched, { i: 11, j: 26 + n * 30, size: 2, rgb: lin('night.lit'), k: 0.9 })
+    type(titles, `f ${f - 10}`, 120, 30 + n * 30, lin('chalk'), { k: 0.6 })
+  }
+})
+// 5: the ring out from a rect, three steps in: the overshoot at its front,
+// the dip just past it
+CARDS.push((buf, titles) => {
+  label(titles, 'ring and dip', 11, 8)
+  const digits = [11, 97, 100, 116]
+  const ring = ringAt(1305, 1300, digits)
+  for (let j = 30; j <= 200; j++) {
+    for (let i = 0; i <= 153; i++) {
+      const r = ring(i, j)
+      if (r.reached) buf.set(i, j, lin('night.lit'), 0.2 * r.k)
+      else if (r.dip) dip(buf, i, j, r.dip)
+    }
+  }
+  type(buf, '6d 23h', 11, 97, lin('night.lit'), { size: 2, k: 0.9 })
+})
+// 6: the curves: retention, relaxation, on, stepsOut, as bars a frame a
+// column
+CARDS.push((buf, titles) => {
+  label(titles, 'retain relax on out', 11, 8)
+  const rows = [
+    [(f) => retention(f, 0), 'lilac.lit'],
+    [(f) => relax(f, 0), 'lilac.lit'],
+    [(f) => on(f, 0, 4), 'white.lit'],
+    [(f) => stepsOut(f, 0), 'white.lit'],
+  ]
+  rows.forEach(([fn, col], n) => {
+    for (let f = -2; f < 40; f++) {
+      const h = Math.round(30 * fn(f))
+      rect(buf, [20 + 3 * (f + 2), 30 + n * 40 + 30 - h, 21 + 3 * (f + 2), 30 + n * 40 + 30], lin(col), { k: 0.6 })
+    }
+  })
+})
+// 7: the relaxation's hue, a glass at each of nine frames after the button
+CARDS.push((buf, titles) => {
+  label(titles, 'relaxbuf from 520', 11, 8)
+  for (let n = 0; n < 9; n++) {
+    const f = 520 + n * 4
+    const r = [11 + (n % 3) * 44, 30 + Math.floor(n / 3) * 60, 50 + (n % 3) * 44, 80 + Math.floor(n / 3) * 60]
+    rect(buf, r, lin('lilac.mid'), { k: 0.5 })
+    type(buf, 'till this', r[0] + 3, r[1] + 5, lin('lilac.ink'))
+    relaxBuf(buf, f, 520, r)
+    type(titles, String(f), r[0] + 3, r[3] - 12, lin('chalk'), { k: 0.5 })
+  }
+})
+// 8: where the stars are: cells whose need is under a little light
+CARDS.push((buf, titles) => {
+  label(titles, 'stars under 0.1', 11, 8)
+  for (let j = 30; j < 220; j++) for (let i = 0; i < 154; i++) if (starNeed(i, j) < 0.1) buf.set(i, j, lin('white.lit'), 0.4, 0)
+})
+export function debug(k, buf, titles) {
+  const card = CARDS[Math.round(k)]
+  if (card) card(buf, titles)
+}
diff --git a/app/src/studio/parts/reel3-motion.js b/app/src/studio/parts/reel3-motion.js
