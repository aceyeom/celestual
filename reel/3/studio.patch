+    { x: x1, y: my, dir: 0, seed: 22.9, spin: -1 },
+    { x: mx, y: y1, dir: Math.PI / 2, seed: 24.1, spin: 1 },
+    { x: x0, y: my, dir: Math.PI, seed: 25.7, spin: -1 },
+  ]
+})()
+
+// ── the flow ────────────────────────────────────────────────────────────────
+// The rose into the panel round the slot's middle (FLOW.nineRose), from a
+// point going round it, wound by a push round it turned a little each step
+// (11.9), from the press's end for as long as the wash goes, tapering over
+// its last steps. And from the front as it goes
+// (FLOW.nineSpill): on each step of the wash, rose spilled at a few of the
+// blocks turning on it, with a small push on outward, so the flow carries it
+// on ahead of the page. And at the press, the bouquet's rose poured into
+// the panel's light from the heads' middle (FLOW.nineBouquet)
+const SWIRL = FLOW.nineRose.swirl
