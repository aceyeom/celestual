+  }
+  const gaps = (fs, what) => { for (let n = 1; n < fs.length; n++) ok(fs[n] - fs[n - 1] >= 4, `${what} F${fs[n - 1]} to F${fs[n]} four frames or more apart`) }
+  gaps([...S.chat.dels, ...S.chat.words], 'the deletes')
+  gaps(S.nine.flicker.map(([f]) => f), 'the flicker')
+  gaps(S.coda.steps, 'the footfalls')
+  // stepped motion moves only on even frames: the 30 fps cut's delivered
+  // frame is (2k, 2k + 1), so what moves in whole cells moves on 2k
+  const evenOnly = (fn, from, to, what) => {
+    let bad = []
+    for (let f = from + 1; f <= to; f += 2) if (JSON.stringify(fn(f)) !== JSON.stringify(fn(f - 1))) bad.push(f)
+    ok(bad.length === 0, `${what} changes only on even frames`, bad.slice(0, 6).join(', '))
+  }
+  evenOnly(T.hookWalker, 0, 200, 'her walker')
+  evenOnly(T.hookHead, 0, 200, 'his fill\'s head')
+  evenOnly((f) => T.washAt(f)?.step ?? -1, S.nine.wash[0] - 16, S.nine.wash[1] + 18, 'the wash front')
+  evenOnly(T.ringR, S.nine.ring - 10, S.nine.reread, 'the overdrive ring')
+  evenOnly(T.countAt, S.sat.from - 20, S.nine.roll + 20, 'the countdown')
+  evenOnly(T.counterAt, S.coda.from - 20, S.coda.latch, 'the counter')
+  ok(T.hookWalker(0) === S.hook.walkFrom && T.hookWalker(S.hook.walk[1]) === S.hook.walkTo, 'her walker goes from i 16 to the pin', `${T.hookWalker(0)} to ${T.hookWalker(80)}`)
+  ok(T.hookWalker(79) + 1 === S.hook.walkTo || T.hookWalker(79) === S.hook.walkTo - 1, 'she reaches the pin a cell every two frames')
+  ok(T.hookHead(S.hook.burst) === LAYOUT.hook.barCells - 1, 'his fill reaches the bar\'s last cell at F140', String(T.hookHead(140)))
+  ok(LAYOUT.hook.pin.i === LAYOUT.hook.bar.i0 + LAYOUT.hook.pin.cell && LAYOUT.hook.pin.cell === Math.round((120 * 19) / 51), 'the pin is 19/51 of the bar')
+  ok(HOOKS.b.offset % 80 === 0, 'hook B is a whole number of half bars ahead', String(HOOKS.b.offset))
+  ok(near(T.MS, ms(T.F_END), 1e-9) && T.F_END === 13 * T.BAR_F, 'the film is thirteen bars')
+}
+
+// ── springs (F6) ────────────────────────────────────────────────────────────
+begin('springs')
+{
+  const run = (name, from, to) => { const v = []; for (let f = from; f <= to; f++) v.push([f, MO.springOf(name, f)]); return v }
+  const peakOf = (vs, sign = 1) => vs.reduce((b, x) => (sign * x[1] > sign * b[1] ? x : b))
+  const at = (name) => SPRINGS[name].at
+  // her light leans past the pin and back
+  {
+    const e = SPRINGS.walkerLean.expect
+    const [f, v] = peakOf(run('walkerLean', at('walkerLean'), at('walkerLean') + 40))
+    ok(near(v, e.peak, 0.001) && f - at('walkerLean') === e.peakF, `walkerLean peaks ${e.peak} at +${e.peakF} f`, `${v.toFixed(4)} at +${f - at('walkerLean')}`)
+    ok(near(MO.springOf('walkerLean', 79), 0, 1e-12), 'walkerLean is still before F80')
+  }
+  // the thread's scroll
+  {
+    const o = SPRINGS.chatScroll
+    const vs = run('chatScroll', o.at, o.at + 90)
+    const [f, v] = peakOf(vs, -1)
+    ok(near(v, o.expect.under, 0.001) && f - o.at === o.expect.underF, `chatScroll overshoots to ${o.expect.under} at +${o.expect.underF} f`, `${v.toFixed(4)} at +${f - o.at}`)
+    const late = vs.filter(([g]) => g - o.at >= o.expect.settledF)
+    ok(late.every(([, x]) => Math.abs(x - o.to) <= o.expect.within), `chatScroll within ${o.expect.within} row from +${o.expect.settledF} f`)
+    ok(MO.springOf('chatScroll', o.at - 1) === o.from, 'chatScroll holds 30 rows down before Owen\'s line')
+  }
+  // the notification, started two frames before the cut it lands in
+  {
+    const o = SPRINGS.notification
+    const [f, v] = peakOf(run('notification', o.at, o.at + 80), -1)
+    ok(near(v, o.expect.under, 0.001) && f - o.at === o.expect.underF, `notification overshoots to ${o.expect.under} at +${o.expect.underF} f`, `${v.toFixed(4)} at +${f - o.at} (F${f})`)
