+++ b/app/src/studio/parts/reel3/hook.js
@@ -0,0 +1,216 @@
+// ── reel 3 · hook ───────────────────────────────────────────────────────────
+//
+// 1 · the walk (frames 0 to 160): the film's title space, before any phone.
+// No app, no chrome: the night panel, its stars, and one channel of cells
+// across it, the bar, which is the street. 120 cells of it are his playlist's
+// 51 minutes, and the pin at its 45th is where 19 of them end, which is the
+// walk home (reel3-TREATMENT.md shot 1, reel3-CONTRACT.md 11.3).
+//
+//   0-80     her light, a lilac block, walks the bar from i 16 to the pin, a
+//            whole cell every delivered frame (two of the sixty), so the mix
+//            down to thirty never blends it; his white fills the bar behind
+//            her as they go, the playlist playing while they walk, as a
+//            phosphor does: each cell as bright as the head when it passed,
+//            and going down to a floor over the half second after. Her light
+//            is the picture: a wide pool of the light pass's points round
+//            her, and her lilac put into the flow where she is every step,
+//            so the street she has walked stays lit, its stars still
+//            catching behind her
+//   80       she is home. She stops on the pin and her light leans on past it
+//            and back (motion-dom's spring, drawn as light leaning: her
+//            block's light split between the columns it falls between)
+//   80-120   his white comes away from her and runs on alone, its head whole
+//            cells a delivered frame, slow and then quicker (`hookHead`),
+//            a low glow running under it and a small cool light of his own
+//            riding ahead of it, away from hers; his ink streams out ahead
+//            of it into the flow as a current
+//   120      it reaches the bar's end, 51 minutes, and blooms there in the
+//            panel's spiral veins, never a ring, a white bloom round `51 min`
+//            as it lands; the head that brought it settles as its light goes
+//            into the bloom, and `51 min` holds lit to the cut
+//
+// The words (`the walk home is 19 min` / `his playlist for it is 51 min`) are
+// the captions', drawn by reel3.jsx from TEXT. Nothing goes out: the cut at
+// 160 takes it. Hook B opens on the ghost before this (chat.js, the owner of
+// retention, reel3-CONTRACT.md 12.9); its frame 80 is this scene's frame 0.
+import { SCENES, S, LAYOUT, FLOW, COL, fr, ms, midX, midY, hookWalker, hookHead } from '../reel3-time.js'
+import { lin, on } from '../reel3-cells.js'
+import { springOf } from '../reel3-motion.js'
+import * as ui from '../reel3-ui.js'
+
+// the frames this scene draws, [from, to), in the film's own frames
+export const range = SCENES.hook
+
+const H = LAYOUT.hook
+const B = H.bar
+// how far the glow under his running head trails it, in cells, and how long
+// it takes to go once the run is over (gone by F130)
+const GLOW_TRAIL = 16
+const GLOW_IN = 4
+const GLOW_OUT = 10
+// how quickly the head's phosphor settles once the run has stopped on the
+// bar's end (frames, a time constant): its light goes into the bloom
+const SETTLE = 6
+// her light in the panel (reel3-CONTRACT.md 11.3): lilac glow round her
+// block, a pool of points the light pass winds in its spirals, as the first
+// reel's notes' light is (reel-aura.js: a crest of 0.3 to 0.8, a body of
+// 0.8 or 0.9, at 0.35 or under): bright at its crest and thinning out
+// through its veins into the stars it lights round its edge. (With a full
+// body over 1 and no crest it flooded its middle to one level, a flat
+// disc with black holes where the veins were not)
+// (at 380 and 0.5: at 240 and 0.35 it was a small swirl round a block,
+// and by the bar's end a haze; the light is the hook's image)
+const HER = { R: 380, a: 0.5, crest: 0.55, body: 0.85, flow: 0.1, turn: 0.04, seed: 2.3 }
+// his fill as phosphor: a cell the head has passed at PHOS[0] of his white
+// going down to PHOS[1] on a time constant of PHOS_TAU frames, the head's
+// four cells at the hook's 0.5 ×HEAD. The floor is next to nothing, so
+// once his head has passed the street is the channel's own dark again and
+// the bar is lit only where his head and her walker are now: drawn with
+// light, not a progress bar's solid fill (at a floor of 0.2 the run left a
+// grey track with a knob on it, the brightest line on the frame after the
+// words). His playlist's length is in the flow, his white streaming on
+// ahead (FLOW.hookRun)
+const PHOS = [0.5, 0.05]
+const PHOS_TAU = 16
+// the pin's ticks, so the 19 of 51 still reads on the darker street
+const PIN_K = 0.6
+const HEAD_K = [1.6, 1.35, 1.15, 1.05]
+// the frame the head first reached each cell of the bar (the first few,
+// filled from the start, long ago)
+const PASSED = (() => {
+  const out = new Array(LAYOUT.hook.barCells).fill(-Infinity)
+  let reached = hookHead(0)
+  for (let f = 2; f <= S.hook.run[1]; f += 2) {
+    const h = hookHead(f)
+    for (let c = reached + 1; c <= h && c < out.length; c++) out[c] = f
+    reached = Math.max(reached, h)
+  }
+  return out
+})()
+// his own light, a white light racing ahead of his head while it runs on
+// alone: what of the playlist streams on into the dark ahead of it. It
+// comes up as the head leaves her, over its first two cells away from the
+// pin (the head is slow to start, so this is from F86 to F90), and goes
+// into the bloom on the bar's end. It only ever goes away from her light,
+// never toward it. (At R 84 and 0.2 it was dim enough for the eye's grey
+// for dim light: grey glitter, and the type was the picture; at R 220 and
+// 0.55 it is white light, and the light is the event)
+const HIS = { R: 220, a: 0.55, lead: 30, crest: 0.15, body: 1, flow: 0.4, turn: -0.06, seed: 4.4, away: 2 }
+// the bloom at the bar's end (11.3): how far it goes and how quickly, how
+// strong it is at first and for how long, its body full and its front low so
+// it opens in veins and never as a ring; at full and 700 px, white veins
+// over the eye's knee, the brightest thing on the frame from 120 to 160
+// (the treatment's B2: the ink bloom at the bar's end)
+const BLOOM = { R0: 30, R: 700, tau: 0.5, a: 1, life: 1.4, body: 0.7, crest: 0.15, flow: 0.35, seed: 5.9 }
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+// how far a drop of ink has spread `dt` seconds after it fell: quickly, then
+// slower and slower, never stopping (reel-aura.js `drop`, which a scene may
+// not import; the same line)
+const drop = (dt, tau) => (dt <= 0 ? 0 : (1 - Math.exp(-dt / tau)) ** 0.8)
+// a tint's glow as the flow takes it, ×k (FLOW's amounts are of a glow)
+const glowOf = (tint, k) => lin(COL[tint].glow).map((x) => x * k)
+
+// Where everything is at frame `f`. Positions are whole cells and change
+// only on delivered frames (`fe`); her lean past the pin is a spring and is
+// read at the frame itself, continuous
+function where(f) {
+  const fe = 2 * Math.floor(f / 2)
+  const lean = f >= S.hook.lean ? springOf('walkerLean', f) : 0
+  return { fe, head: hookHead(fe), col: hookWalker(fe) + lean }
+}
+
+// once, before the first frame: her lean's spring built, so the first frame
+// asked for costs what every other does
+export function prime() {
+  springOf('walkerLean', S.hook.lean + 1)
+}
+
+// The frame: the bar, its fill to his head with its phosphor head, the pin,
+// her block on it, and from her arrival the glow under his run
+export function paint(t, buf) {
+  const f = fr(t)
+  const { head, col } = where(f)
+  const glow = f >= S.hook.arrive ? on(f, S.hook.arrive, GLOW_IN) * (1 - on(f, S.hook.burst, GLOW_OUT)) : 0
+  const glowFrom = head - GLOW_TRAIL
+  const fe = 2 * Math.floor(f / 2)
+  // once the run has stopped on the bar's end, its head settles to the
+  // phosphor's own: the light that brought it is in the bloom now
+  const headK = f > S.hook.burst ? Math.exp(-(f - S.hook.burst) / SETTLE) : 1
+  const fillAt = (c, back) => {
+    const p = PHOS[1] + (PHOS[0] - PHOS[1]) * Math.exp(-(fe - PASSED[c]) / PHOS_TAU)
+    return back < H.head ? p + (PHOS[0] * HEAD_K[back] - p) * headK : p
+  }
+  ui.bar(buf, f, {
+    bar: B,
+    cells: H.barCells,
+    fill: head + 1,
+    head: H.head,
+    fillAt,
+    pin: { i: H.pin.i, above: H.pin.above, below: H.pin.below },
+    pinK: PIN_K,
+    walker: { x: col, rows: H.walker.rows, size: H.walker.size, k: 1 },
+    glowRow: glow > 0 ? H.glowRow : null,
+    glowFrom,
+  })
+  // the glow comes in with his run and goes as it ends (the bar paints it
+  // whole; its level is the scene's). The pin's tick in that row is the
+  // pin's, and stays
+  if (glow > 0 && glow < 1) {
+    for (let c = Math.max(0, Math.floor(glowFrom)); c <= head; c++) {
+      const i = B.i0 + c
+      if (i !== H.pin.i) buf.scale(i, H.glowRow, glow)
+    }
+  }
+}
+
+// The flow: her lilac where she is, every step (FLOW.hookHer); from her
+// arrival his ink streams from the head of his run with a push ahead of it,
+// a current; at the bar's end, a drop of it over a few steps (FLOW)
+export function flow(fl, t) {
+  const f = Math.round(fr(t))
+  if (f >= S.hook.from && f < S.hook.to) {
+    const E = FLOW.hookHer
+    fl.ink(midX(where(f).col), midY(B.j0 + 1), glowOf(E.tint, E.a), E.r)
+  }
+  const [a, b] = S.hook.run
+  if (f >= a && f < b) {
+    const R = FLOW.hookRun
+    const x = midX(B.i0 + hookHead(f))
+    fl.ink(x, H.flowY, glowOf(R.tint, R.a), R.r)
+    fl.push(x, H.flowY, R.push[0] * R.pushStep, R.push[1] * R.pushStep, R.pushR)
+  }
+  const D = FLOW.hookBurst
+  if (f >= S.hook.burst && f < S.hook.burst + D.steps) fl.ink(H.burst.x, H.burst.y, glowOf(D.tint, D.a), D.r)
+}
+
+// The light placed: hers, round her block wherever it is (her lean too), a
+// pool of the light pass's points going with her; his, small, on ahead of
+// his head as it runs on without her; and from the run's end the bloom at
+// the bar's end, opening fast and then slower, fading as it goes
+export function light(t, L) {
+  const f = fr(t)
+  const s = t / 1000
