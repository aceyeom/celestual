+}
+// the battery glyph, its left edge or (`right`) its last column on `i`
+function battery(buf, n, i, j, rgb, k, a, align = 'left') {
+  const name = `bata${clamp(Math.round(n), 0, 4)}`
+  const w = rowsOf(name)[0].length
+  return glyph(buf, name, align === 'right' ? i + 1 - w : i, j, rgb, { k, a })
+}
+
+// ── the chat (shot 2) ───────────────────────────────────────────────────────
+// A plain dark group chat, nobody's app: who wrote over each message, the
+// message in an outline with its corners clipped (the product's chamfer,
+// screen.css's keys and bubbles), and her field at the foot. Inside each,
+// dim backlit glass in its writer's colour (`fill`, ×`fillK`), hiding the
+// dark behind it, so a bubble is a lit plate on the screen and never a
+// wireframe; its words are laid on it after
+export function bubble(buf, r, rgb, { k = 1, clip, dy = 0, fill = null, fillK = 0 } = {}) {
+  if (!(k > 0)) return
+  if (fill && fillK > 0) plate(buf, r, fill, fillK * k, { clip, dy })
+  outline(buf, r, rgb, { k, a: clamp(k), clip, dy })
