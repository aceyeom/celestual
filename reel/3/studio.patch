+// ── the third reel's clock ──────────────────────────────────────────────────
+//
+// `on purpose`: thirteen bars at 90 beats a minute, 2080 frames at sixty a
+// second, a week of one person's phone. Everything the film does is written
+// here as a frame of the sixty, because that is what the cuts, the steps of
+// a screen and the mix down to thirty are counted in: a beat is 40 frames, a
+// half beat 20, a bar 160, and a cut is only ever on a multiple of 80. The
+// picture (reel3.jsx and parts/reel3/), the sounds (scripts/reel3-sounds.mjs)
+// and the checks (scripts/reel3-check.mjs) all read this file, so it is
+// plain script with nothing imported, and node reads it as the page does.
+//
+// What is in it, and what reads it:
+//
+//   S        every moment of the film, shot by shot, in frames. `S.inAction`
+//            lists the few that are allowed off the twenty frame grid, and why
+//   SCENES   which frames each of the nine scene modules draws
+//   TEXT     every word on the screen: the captions (`title`, chalk, drawn by
+//            reel3.jsx from this table alone) and the phone's own words
+//            (`screen`, drawn by their scene in their screen's colour)
+//   LAYOUT   every rect, glyph and anchor, in the panel's cells
+//   PHOTOS   the three photographs, where each is cut, and where it goes
+//   SPRINGS  the motion-dom springs, with the numbers the treatment asserts
+//   EASES    the CustomEase curves; ROUTE the rose's way across the art
+//   FLOW     how much light each moment puts in the panel's flow
+//   CUES     every sound, for the sound script
+//   HOOKS    the two openings; URL the address
+//
+// A cell (i, j) is the panel's: its top left corner on the frame at
+// x = 3 + 7i, y = 5 + 7j, its lit square the six pixels from there, and its
+// middle at (6.5 + 7i, 8.5 + 7j). i runs 0 to 153 across the frame and j 0
+// to 273 down it; the panel keeps six more cells all round, off the frame
+// (reel3-CONTRACT.md has the rest of the conventions). A word's `j` is the
+// row its capitals' tops are on, and its `i` its left edge, or with `align`
+// its middle (`center`) or its last column (`right`).
+
+// ── the beat ────────────────────────────────────────────────────────────────
+export const BPM = 90
+export const FPS = 60
+export const BEAT_F = 40
+export const HALF_F = 20
+export const BAR_F = 160
+export const F_END = 2080
+// a frame in ms, and the film's frame at a moment: whole frames come back
+// whole, with the float's crumbs taken off
+export const ms = (f) => (f * 50) / 3
+export const fr = (t) => Math.round(t * 0.06 * 1e4) / 1e4
+export const MS = ms(F_END)
+// whether the moment `t` (ms) is in [a, b) (frames)
+export const within = (t, [a, b]) => { const f = fr(t); return f >= a && f < b }
+// a scene's frames, any of its runs
+export const active = (runs, t) => runs.some((r) => within(t, r))
+
+// ── the grid (reel 1's) ─────────────────────────────────────────────────────
+export const GRID = {
+  C: 7, GX: 3, GY: 5,
+  // the cells on the frame, and the panel's margin of them past its edges
+  VIS_W: 154, VIS_H: 274, MARGIN: 6, CW: 166, CH: 286,
+  // the words' margins, and the reading rows (capitals' tops)
+  X0: 80, RIGHT: 1000, I0: 11, I_RIGHT: 141, MID: 77,
+  rows: { Y0: 33, Y1: 49, Y2: 65, Y3: 81, Y4: 97, Y5: 113, Y6: 129, Y7: 145, Y8: 161, Y9: 177, Y10: 193 },
+  // nothing readable below this row's foot (y 1540), and below j 150
+  // (y 1050) nothing readable right of i 135 (x 953)
+  FOOT_J: 218, LOW_J: 150, LOW_I: 135,
+}
+export const cellX = (i) => 3 + 7 * i
+export const cellY = (j) => 5 + 7 * j
+export const midX = (i) => 6.5 + 7 * i
+export const midY = (j) => 8.5 + 7 * j
+
+// ── the colours (sRGB hex; painters take them to linear light) ──────────────
+// The skins are looks.js `skinOf` worked out (reel3-STYLE.md 3); a screen's
+// glass is drawn from `skinOf` itself, these are for the words and the checks
+export const COL = {
+  chalk: '#F4F1EA', ash: '#9C978E', warm: '#FFF4E4', unlit: '#15171B',
+  // `from Owen` under his note, half way from ash to the rose
+  ashRose: '#BE959F',
+  night: { glow: '#9D9D9D', mid: '#9D9D9D', lit: '#EFEFEF', ink: '#131313', hi: '#BABABA', lo: '#6E6E6E', top: '#4F4F4F', bot: '#101010' },
