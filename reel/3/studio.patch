+// A rect's edge, one cell wide; with `corners`, its four corners left
+// unlit, the product's chamfer (screen.css's bubbles and keys). A
+// fractional `dy` carries the whole edge that many rows, leaning
+export function outline(buf, r, rgb, { k = 1, a = 1, corners = true, clip, dy = 0 } = {}) {
+  const [i0, j0, i1, j1] = r.map(Math.round)
+  const cells = []
+  const corner = (i, j) => corners && (i === i0 || i === i1) && (j === j0 || j === j1)
+  for (let i = i0; i <= i1; i++) {
+    if (!corner(i, j0)) cells.push([i, j0])
+    if (j1 !== j0 && !corner(i, j1)) cells.push([i, j1])
+  }
+  for (let j = j0 + 1; j < j1; j++) {
+    cells.push([i0, j])
