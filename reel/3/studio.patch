+//         the cut (the colour-held beat that stood here read as a dropout to
+//         smoke and was taken out: S.nine.held is the cut)
+
+import { SCENES, S, TEXT, LAYOUT, FLOW, LIGHTS, COL, GRID, fr, ms, cellX, cellY, midX, midY, countAt, stepsOut, roseHeld } from '../reel3-time.js'
