+// ── reel 3 · the photographs, in cells ──────────────────────────────────────
+//
+// Three photographs come into the film, and each only as the panel's own
+// cells: a cell lit at one of eight levels in a print's tone, its six
+// pixels square and its seventh row and column dark, as every other thing
+// on this screen is. Nothing of a photograph is ever smooth, scaled, panned
+// or slid. Each is cut once (reel3-time.js PHOTOS, `crop`), brought down to
+// four samples a cell each way, and from then on moves only as cells move:
+// sampled again where a scroll has put it, its levels stepped by the cell's
+// own hash, coming on and going out by the scene's behaviours.
+//
+//   cover   dance.jpg, 26 cells a side, Owen's playlist card in the chat;
+//           sampled again every frame as the thread's spring carries it
+//           (a fractional `at`), so its dither crawls the way a moving
+//           picture's does on a real LCD and its frame steps whole cells
+//   art     the same square of dance.jpg at 125 cells, the player's
+//           now-playing art in the last shot (its sun between the raised
+//           hands is the coda's, squares of the warm white); the phone's
+//           live wallpaper leans the dark figures a cell or so against the
+//           sky with each footfall (a luminance as depth: the dark near,
+//           the sky far)
+//   limbo   roses.jpg on the panel at nine, printed as the first reel
+//           printed its photographs: its sky the panel's windows onto its
+//           own blue light and stars, the reaching hand, the stems and the
+//           wall dark glass against it, and the roses held out the one
+//           light of the picture's own, in the night's greys, toned with
+//           the first reel's night blue (its sea at night, [0.80, 0.92,
+//           1.10]) and no colour; the bouquet's cells are the film's first
+//           rose
+//
+// (sea.jpg, the couple in the water, is not in the film: after the reveal
+// the only couple on the screen is the playlist's own art, which is his)
+//
+// What a cell is made of (reel3-CONTRACT.md 7, and the first reel's photo
+// in panel-fluid.js FRAG.display, there per frame pixel and here per cell):
+// its level from the window of the photograph under it, `q`, eight steps
+// keyed by the panel cell's own star hash (irregular, so it never moirés
+// on the feed, and never a Bayer); its colour from the print's tone; how
+// much of the dark behind it it hides, `1 - 0.85·smoothstep(.02, .45, L)`,
+// so the dark figures stay dark glass and the light parts let the panel's
+// sky through; and its brightest cells drawn as the stars are, a point or
+// a cross.
+//
+// Where this differs from the contract's letter (reel3-CONTRACT.md 7.3),
+// it is because the letter, tried on the panel, made the picture worse:
+//
+//   - the star shapes go to a photograph's own highlights (the sun, the
+//     sea's glint), measured on its light before the levels are stretched:
+//     by `L > starNeed` alone every sky cell a star could be became one,
+//     and a star drawn in a lit sky is a hole in it, so the sky went to
+//     salt and pepper
+//   - the eight steps are laid on the light as the eye has it (the sRGB
+//     curve of `L`, and a power, `curve`), which is what the print's OKLCH
+//     ramp is even in; and the dance is printed at 0.3, not 0.5: at 0.5 a
+//     sky is most of the art and all of it near the top step, a grey wall
+//     brighter than anything else in the shot
+//   - a star's own light is a star's, the print's top at up to three or so
+//     (a cross lights a tenth of what a square does, and at the print's
+//     own level it reads as a hole in the picture)
+//   - the roses' grey lifts their red (`lift`), the bouquet is found by red
+//     over green alone (`ROSY`), and a cell turning rose keeps its own light
+//   - the roses are printed as a red filter prints them: the blue sky taken
+//     down to a third before the levels (`sky`), and the levels stretched
+//     on the subject (the skin and the bouquet, `subject`), not on the
+//     frame, pulled hard off the background (`pull`), so the hand and the
+//     heads stand pale on a dark sky. Printed as the frame was, the sky was
+//     the lightest thing in it and the skin matched it: a grey slab
+//   - the eight steps are laid with a little headroom (7.5 and the cell's
+//     hash), so a light that is the top all over (a sky) dithers between the
+//     top two steps and is never one flat wall; and the dance's levels are
+//     stretched to the 99.5th centile, not the 98th, so its sky keeps its
+//     gradient toward the sun
+//   - the roses' windows are its sky (the `sky` share), not its light: a
+//     red filter's print has the skin pale and the sky dark, and it is the
+//     sky the panel's light comes through, the hand dark against it
+
+import { PHOTOS, SS } from './reel3-time.js'
+import { hash, starNeed, lin, type as typeIn, outline as outlineIn } from './reel3-cells.js'
+import { printTone, roseRamp } from './reel3-motion.js'
+
+const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v))
+const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t) }
+// the sRGB curve, both ways (as panel-fluid.js `linear`)
+const toLin = (x) => (x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4)
+const toEye = (x) => (x <= 0.0031308 ? x * 12.92 : 1.055 * x ** (1 / 2.4) - 0.055)
+const lum = (c) => 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
+
+// The files, as the page's own assets (Vite takes a `new URL` of a module's
+// neighbour as one, and node reads it as a plain file URL without loading
+// anything, so this module can be imported by a script)
+const SRC = {
+  dance: new URL('../assets/reel3/dance.jpg', import.meta.url).href,
+  roses: new URL('../assets/reel3/roses.jpg', import.meta.url).href,
+}
+
+// Every use of every photograph, from PHOTOS: its cells, where it goes,
+// and its sun's cell if it has one
+const USES = {}
+for (const [name, p] of Object.entries(PHOTOS)) {
+  for (const [use, u] of Object.entries(p.uses)) {
+    USES[use] = { use, name, cw: u.cells[0], ch: u.cells[1], at: u.at, sun: u.sunCell || null }
+  }
+}
+
+// ── how each use is printed ─────────────────────────────────────────────────
+// `skin` and `k` the print (his white, kept dim, for the dance; the night's
+// greys for the roses; the rose page's own rose, at the page's own, for the
+// sea); `curve` how the light is laid on the eight steps, a power on the
+// eye's light (over 1, the light parts brought down to the middle steps, so
+// a whole sky is not all one top step and its dither shows); `star` how
+// bright a star's own light is at the most; `pass` how much of the panel's
+// light a light cell lets through it (the art's sky, the sea); and for the
+// roses `lift`, how much a pixel's red over its green lifts its grey, as a
+// red filter on the film would: the roses' heads come up pale against the
+// sky, the dark leaves stay dark, and there is still no colour in it
+// (`hi` the centile the levels' top is taken at; `sky` how much of the blue
+// is kept before the levels, `subject` the levels taken on the skin and the
+// bouquet alone, `pull` how hard the picture is pulled off its background;
+// `tone` how far up the skin's ramp the top step goes; `tint` the print's
+// toning, ×r g b, as the first reel toned its night photograph: printed in
+// the night's plain greys the limbo was a newspaper's halftone, not the
+// panel's night)
+export const LOOK = {
+  cover: { skin: 'white', k: 0.45, curve: 1.2, star: 1.4, hi: 0.995 },
+  // (the art toned to a rose dusk, as the first reel toned its reveal's
+  // print warm: in his plain white, dim, the eye's grey for dim light took
+  // the art's sky to a neutral grey on the cut out of the rose page)
+  // (his white is a cool white, its blue over its red: toned at [1.08, 0.9,
+  // 0.98] the sky's own light was still as blue as red, so it is toned
+  // past that, its red over its blue as a dusk's is)
+  art: { skin: 'white', k: 0.3, curve: 2.2, star: 3.2, pass: 0.2, hi: 0.995, tint: [1.14, 0.88, 0.9] },
+  // (the roses pulled off their background against a sixth of the picture
+  // round them, not an eighth: each head's round edge cut against the next,
+  // which nine shades its heads by)
+  limbo: { skin: 'night', k: 0.14, bouquetK: 0.6, curve: 0.9, lift: 2.0, sky: 0.75, subject: true, pull: 0.6, pullR: 6, star: 0.5, pass: 2.4, tint: [0.8, 0.92, 1.1] },
+}
+// the first reel's night blue, for a use's print (reel.jsx `photoAt`)
+export const NIGHT_TINT = [0.8, 0.92, 1.1]
+// a highlight is light past half way from the photograph's 98th centile to
+// its brightest, and never under this: a photograph with no light source in
+// it (the roses) has no stars
+const KNEE = 0.66
+// the bouquet: a pixel of it is a pixel PHOTOS.roses.bouquet.pink says is
+// rose, its red well over its green (this photograph's roses are red 75 to
+// 122, so no floor on the red): the 2097 cells of the flowers' heads, in
+// the contract's own i 2-85, j 31-89
+
+// ── the pipeline (reel3-CONTRACT.md 7.2), pure: pixels in, grids out ────────
+
+// One axis of an exact area average from `nIn` pixels to `nOut` samples:
+// each sample is the mean of the pixels it covers, weighted by how much of
+// each it covers (what repeated halving with smoothing comes near to, done
+// exactly). Where a sample is smaller than a pixel (the roses, 538 pixels
+// for 616 samples), the pixels are read bilinearly at its middle instead
+function axisOf(nIn, nOut) {
+  const s = nIn / nOut
+  const taps = []
+  for (let o = 0; o < nOut; o++) {
+    const t = []
+    if (s < 1) {
+      const x = (o + 0.5) * s - 0.5
+      const x0 = Math.floor(x)
+      const f = x - x0
+      t.push([clamp(x0, 0, nIn - 1), 1 - f], [clamp(x0 + 1, 0, nIn - 1), f])
+    } else {
+      const a = o * s
+      const b = (o + 1) * s
+      for (let i = Math.floor(a); i < Math.min(nIn, Math.ceil(b)); i++) {
+        const w = Math.min(b, i + 1) - Math.max(a, i)
+        if (w > 1e-9) t.push([i, w / s])
+      }
+    }
+    taps.push(t)
+  }
+  return taps
+}
+// a plane of `w0 × h0` brought to `W × H`, across then down
+function resample(src, w0, h0, W, H) {
+  const ax = axisOf(w0, W)
+  const ay = axisOf(h0, H)
+  const mid = new Float32Array(W * h0)
+  for (let y = 0; y < h0; y++) {
+    const row = y * w0
+    for (let x = 0; x < W; x++) {
+      let v = 0
+      for (const [i, w] of ax[x]) v += src[row + i] * w
+      mid[y * W + x] = v
+    }
+  }
+  const out = new Float32Array(W * H)
+  for (let y = 0; y < H; y++) {
+    for (const [i, w] of ay[y]) {
+      const from = i * W
+      const to = y * W
+      for (let x = 0; x < W; x++) out[to + x] += mid[from + x] * w
+    }
+  }
+  return out
+}
+// a box blur of radius `r`, across then down, its edges held (the
+// product's `blurBox`, screen.jsx, as running sums so a wide one is cheap)
+function box(src, W, H, r) {
+  const k = 1 / (2 * r + 1)
+  const a = new Float32Array(src.length)
+  const b = new Float32Array(src.length)
+  for (let y = 0; y < H; y++) {
+    const row = y * W
+    let t = 0
+    for (let d = -r; d <= r; d++) t += src[row + clamp(d, 0, W - 1)]
+    for (let x = 0; x < W; x++) {
+      a[row + x] = t * k
+      t += src[row + Math.min(W - 1, x + r + 1)] - src[row + Math.max(0, x - r)]
+    }
+  }
+  for (let x = 0; x < W; x++) {
+    let t = 0
+    for (let d = -r; d <= r; d++) t += a[clamp(d, 0, H - 1) * W + x]
+    for (let y = 0; y < H; y++) {
+      b[y * W + x] = t * k
+      t += a[Math.min(H - 1, y + r + 1) * W + x] - a[Math.max(0, y - r) * W + x]
+    }
+  }
+  return b
+}
+const centile = (sorted, p) => sorted[Math.min(sorted.length - 1, Math.floor(sorted.length * p))]
+
+// A summed-area table of a plane: S(x, y) the sum of the samples left of x
+// and above y, so the mean of any window, fractional corners and all, is
+// four reads of it; read bilinearly, which for samples that are each a flat
+// square of light is exact
+function satOf(src, W, H) {
+  const S = new Float64Array((W + 1) * (H + 1))
+  for (let y = 0; y < H; y++) {
+    let row = 0
+    for (let x = 0; x < W; x++) {
+      row += src[y * W + x]
+      S[(y + 1) * (W + 1) + x + 1] = S[y * (W + 1) + x + 1] + row
+    }
+  }
+  return S
+}
+function satAt(S, W, H, x, y) {
+  const xi = Math.min(Math.floor(x), W - 1)
+  const yi = Math.min(Math.floor(y), H - 1)
+  const tx = x - xi
+  const ty = y - yi
+  const w = W + 1
+  const o = yi * w + xi
+  return (S[o] * (1 - tx) + S[o + 1] * tx) * (1 - ty) + (S[o + w] * (1 - tx) + S[o + w + 1] * tx) * ty
+}
+// the mean of a cell's window, the cell (u, v) of a grid with its window's
+// corner at (u, v) cells (fractional is fine); a window off the grid's edge
+// is held at the edge, as the edge's own cell
+function windowAt(S, W, H, u, v) {
+  const x0 = clamp(u * SS, 0, W - SS)
+  const y0 = clamp(v * SS, 0, H - SS)
+  const x1 = x0 + SS
+  const y1 = y0 + SS
+  // (a sum of sums takes a crumb off now and then: light is never under none)
+  return Math.max(0, (satAt(S, W, H, x1, y1) - satAt(S, W, H, x0, y1) - satAt(S, W, H, x1, y0) + satAt(S, W, H, x0, y0)) / (SS * SS))
+}
+
+// A use's grid from its photograph's pixels (`data` RGBA or RGB, `width`
+// pixels a row): the crop, its light (the eye's luma, with the use's
+// `lift`), brought to four samples a cell, and toned as the product's
+// `pixelate` tones a picture (screen.jsx `toneOf`): stretched from its 2nd
+// to its 98th centile, pulled off its background (+0.35 of it against the
+// eighth of the picture round it), sharpened (+0.5 against the cell round
+// it), a gamma of 0.9, and taken to linear light. Beside it the highlight
+// plane (`X`), from the light before any of that, and for the roses the
+// bouquet
+export function gridOf(img, use) {
+  const U = USES[use]
+  const P = PHOTOS[U.name]
+  const look = LOOK[use]
+  const [cx, cy, cw0, ch0] = P.crop
+  const { data, width } = img
+  const ch = img.channels || 4
+  const W = U.cw * SS
+  const H = U.ch * SS
+  const T = new Float32Array(cw0 * ch0)
+  const R = new Float32Array(cw0 * ch0)
+  const lift = look.lift || 0
+  const skyK = look.sky ?? 1
+  // the subject, for the levels: the skin and the bouquet's pink
+  const sub = look.subject ? new Float32Array(cw0 * ch0) : null
+  for (let y = 0; y < ch0; y++) {
+    for (let x = 0; x < cw0; x++) {
+      const o = ((cy + y) * width + cx + x) * ch
+      const r = data[o] / 255
+      const g = data[o + 1] / 255
+      const b = data[o + 2] / 255
+      const y0 = 0.2126 * r + 0.7152 * g + 0.0722 * b
+      R[y * cw0 + x] = y0
+      // (the background is what is not warm: the sky, the pale wall, the
+      // olive of the building; a warm pixel, skin or petal, is kept whole)
+      const warm = smooth(8 / 255, 24 / 255, r - b)
+      T[y * cw0 + x] = y0 * (skyK + (1 - skyK) * warm) + lift * Math.max(0, r - g)
+      if (sub) sub[y * cw0 + x] = isSubject(P, data[o], data[o + 1], data[o + 2]) ? 1 : 0
+    }
+  }
+  const G = resample(T, cw0, ch0, W, H)
+  const n = W * H
+  // the levels, on the subject's samples if the use says so (a sample is
+  // the subject's if most of the pixels under it are)
+  let pool = G
+  if (sub) {
+    const S = resample(sub, cw0, ch0, W, H)
+    const on = []
+    for (let i = 0; i < n; i++) if (S[i] >= 0.5) on.push(G[i])
+    if (on.length > n / 50) pool = Float32Array.from(on)
+  }
+  const sorted = Float32Array.from(pool).sort()
+  const lo = centile(sorted, 0.02)
+  const span = Math.max(0.08, centile(sorted, look.hi ?? 0.98) - lo)
+  let L = new Float32Array(n)
+  for (let i = 0; i < n; i++) L[i] = clamp((G[i] - lo) / span)
+  // pulled off the background, then sharpened at the cell
+  const r = Math.max(1, Math.round(Math.min(U.cw, U.ch) / (look.pullR ?? 8))) * SS
+  const wide = box(box(L, W, H, r), W, H, r)
+  const pull = look.pull ?? 0.35
+  for (let i = 0; i < n; i++) L[i] += pull * (L[i] - wide[i])
+  const near = box(L, W, H, SS)
+  const out = new Float32Array(n)
+  for (let i = 0; i < n; i++) out[i] = toLin(clamp(L[i] + 0.5 * (L[i] - near[i])) ** 0.9)
+  L = out
+  // the highlights, on the light as it was
+  const raw = resample(R, cw0, ch0, W, H)
+  const rs = Float32Array.from(raw).sort()
+  const top = rs[n - 1]
+  const knee = Math.max(KNEE, centile(rs, 0.98) + 0.5 * (top - centile(rs, 0.98)))
+  const X = new Float32Array(n)
+  if (top > knee) for (let i = 0; i < n; i++) X[i] = clamp((raw[i] - knee) / (top - knee))
+  const satL = satOf(L, W, H)
+  const satX = satOf(X, W, H)
+  const satR = satOf(raw, W, H)
+  // each cell's own window, kept: what a cell at a whole place reads, and
+  // its light as the photograph has it (the eye's luma, before any tone)
+  const Lc = new Float32Array(U.cw * U.ch)
+  const Xc = new Float32Array(U.cw * U.ch)
+  const Rc = new Float32Array(U.cw * U.ch)
+  for (let v = 0; v < U.ch; v++) {
+    for (let u = 0; u < U.cw; u++) {
+      Lc[v * U.cw + u] = windowAt(satL, W, H, u, v)
+      Xc[v * U.cw + u] = windowAt(satX, W, H, u, v)
+      Rc[v * U.cw + u] = windowAt(satR, W, H, u, v)
+    }
+  }
+  // the bouquet: a cell is the bouquet's if `share` of the crop's pixels
+  // under it are rose (an exact area share, as the light is); and the hand
+  // reaching for it, a cell of skin left of the photograph's `handX`; and
+  // how much of each cell is sky (blue over red, and light)
+  let mask = null
+  let hand = null
+  let sky = null
+  let rosy = null
+  if (P.bouquet) {
+    const pink = new Float32Array(cw0 * ch0)
+    const rg = new Float32Array(cw0 * ch0)
+    const skin = new Float32Array(cw0 * ch0)
+    const blue = new Float32Array(cw0 * ch0)
+    for (let y = 0; y < ch0; y++) {
+      for (let x = 0; x < cw0; x++) {
+        const o = ((cy + y) * width + cx + x) * ch
+        const [rr, gg, bb] = [data[o], data[o + 1], data[o + 2]]
+        pink[y * cw0 + x] = P.bouquet.pink(rr, gg) ? 1 : 0
+        rg[y * cw0 + x] = Math.max(0, rr - gg) / 255
+        const px = cx + x
+        const py = cy + y
+        const inHand = P.skin && P.skin.hand.some(([hx0, hy0, hx1, hy1]) => px >= hx0 && px <= hx1 && py >= hy0 && py <= hy1)
+        skin[y * cw0 + x] = inHand && P.skin.warm(rr, gg, bb) ? 1 : 0
+        blue[y * cw0 + x] = bb >= rr && R[y * cw0 + x] > 0.25 ? 1 : 0
+      }
+    }
+    const share = resample(pink, cw0, ch0, U.cw, U.ch)
+    mask = new Uint8Array(U.cw * U.ch)
+    for (let i = 0; i < mask.length; i++) mask[i] = share[i] >= P.bouquet.share ? 1 : 0
+    const hs = resample(skin, cw0, ch0, U.cw, U.ch)
+    hand = new Uint8Array(U.cw * U.ch)
+    for (let i = 0; i < hand.length; i++) hand[i] = hs[i] >= P.skin.share && !mask[i] ? 1 : 0
+    sky = resample(blue, cw0, ch0, U.cw, U.ch)
+    // and how pink each cell is, its red over its green (an exact area
+    // mean, 0..1): the middle of a rose's head is its pinkest, the folds and
+    // the leaves between the heads are not, so the bouquet shaded by it is
+    // round heads and not one lobed shape
+    rosy = resample(rg, cw0, ch0, U.cw, U.ch)
+  }
+  return { cw: U.cw, ch: U.ch, w: W, h: H, L, X, satL, satX, Lc, Xc, Rc, mask, hand, sky, rosy }
+}
+// a pixel of a photograph's subject (the roses': its skin, or its bouquet)
+function isSubject(P, r, g, b) {
+  return (P.bouquet && P.bouquet.pink(r, g)) || (P.skin && P.skin.warm(r, g, b))
+}
+
+// ── painting ────────────────────────────────────────────────────────────────
+// The print's eight steps (and the ninth, the top), worked out once a skin,
+// as far up the skin's ramp as `tone` goes (the sea's top is the rose's mid)
+const STEPS = new Map()
+function stepsOf(skin, tone = 1, tint = null) {
+  const key = `${skin}|${tone}|${tint}`
+  let s = STEPS.get(key)
+  if (!s) {
+    s = Array.from({ length: 9 }, (_, q) => printTone((tone * q) / 8, skin).map((v, c) => v * (tint ? tint[c] : 1)))
+    STEPS.set(key, s)
+  }
+  return s
+}
+// a use's eight steps and its top, as it prints them (nine lays the
+// bouquet's grey from these)
+export const printSteps = (use) => stepsOf(LOOK[use].skin, LOOK[use].tone ?? 1, LOOK[use].tint || null)
+// how near a cell's light is, for the live wallpaper: the dark near (1),
+// the sky far (0), as the passthrough has them
+const depthOf = (L) => 1 - smooth(0.02, 0.45, L)
+
+// A clip as painters take it: a rect, or {i0, j0, i1, j1} with sides open
+function clipOf(c) {
+  if (!c) return null
+  if (Array.isArray(c)) return { i0: c[0], j0: c[1], i1: c[2], j1: c[3] }
+  return { i0: c.i0 ?? -Infinity, j0: c.j0 ?? -Infinity, i1: c.i1 ?? Infinity, j1: c.j1 ?? Infinity }
+}
+
+export class Photos {
+  constructor(grids) {
+    this.grids = grids
+  }
+
+  // the supersampled light of a use, linear, after its tone
+  grid(use) {
+    const g = this.grids[use]
+    return { cw: g.cw, ch: g.ch, w: g.w, h: g.h, L: g.L }
+  }
+
+  // a use cell's mean light, its window moved (dx, dy) cells
+  L(use, u, v, dx = 0, dy = 0) {
+    const g = this.grids[use]
+    if (!dx && !dy && Number.isInteger(u) && Number.isInteger(v) && u >= 0 && v >= 0 && u < g.cw && v < g.ch) return g.Lc[v * g.cw + u]
+    return windowAt(g.satL, g.w, g.h, u + dx, v + dy)
+  }
+
+  // a use cell's light as the photograph has it, untoned (the eye's luma,
+  // 0..1): what tells the sea's two from the water round them, which the
+  // print's levels take down to the same black
+  raw(use, u, v) {
+    const g = this.grids[use]
+    if (!(u >= 0 && v >= 0 && u < g.cw && v < g.ch)) return 1
+    return g.Rc[Math.floor(v) * g.cw + Math.floor(u)]
+  }
+
+  // the bouquet's cells, 1 a cell, row by row in the use's own cells
+  // (limbo only); with `'hand'` the reaching hand's, with `'sky'` how much
+  // of each cell is sky, 0..1, with `'rosy'` how pink it is, 0..1
+  mask(use, which = 'bouquet') {
+    const g = this.grids[use]
+    if (!g) return null
+    return (which === 'hand' ? g.hand : which === 'sky' ? g.sky : which === 'rosy' ? g.rosy : g.mask) || null
+  }
+
+  // where a use's cell (u, v) is on the panel, and the use's cell under a
+  // panel cell (i, j), or null off it
+  at(use) {
+    const U = USES[use]
+    return U ? [U.at[0], U.at[1]] : null
+  }
+  cellOf(use, i, j) {
+    const U = USES[use]
+    const u = i - U.at[0]
+    const v = j - U.at[1]
+    return u >= 0 && v >= 0 && u < U.cw && v < U.ch ? v * U.cw + u : -1
+  }
+
+  // the sun's cell in a use of the dance
+  sun(use) {
+    const U = USES[use]
+    return U && U.sun ? [U.sun[0], U.sun[1]] : null
+  }
+
+  // A use painted into `buf` at frame `f` (reel3-CONTRACT.md 7.1, 7.3). Its
+  // cell (u, v) lands on the panel's (at[0] + u, at[1] + v); a fractional
+  // `at` moves the picture under its cells and never the cells: each cell
+  // samples the photograph's window where the picture now is, and the
+  // picture's frame steps whole cells (it is where the picture is nearest)
+  paint(buf, use, f, opts = {}) {
+    const g = this.grids[use]
+    const U = USES[use]
+    if (!g || !U) throw new Error(`reel3-photo: no use ${use}`)
+    const look = LOOK[use]
+    const { cw, ch, w: W, h: H } = g
+    const at = opts.at || U.at
+    const kAll = opts.k ?? 1
+    const level = opts.level || null
+    const rose = use === 'limbo' ? opts.rose || null : null
+    const off = use === 'art' && opts.offset ? opts.offset : null
+    const lean = off && (Math.abs(off[0]) > 1e-4 || Math.abs(off[1]) > 1e-4)
+    const ib = Math.round(at[0])
+    const jb = Math.round(at[1])
+    const whole = ib === at[0] && jb === at[1]
+    const clip = clipOf(opts.clip) || { i0: ib, j0: jb, i1: ib + cw - 1, j1: jb + ch - 1 }
+    const steps = stepsOf(look.skin, look.tone ?? 1, look.tint || null)
+    const sun = U.sun
+    const { rgba, shape, pass } = buf
+    // a rose a cell has turned to keeps its cell's light (OKLCH, through
+    // roseRamp from the night's grey), so the bouquet takes the colour with
+    // its shading whole: a pure turn of hue where the roses were
+    const roses = new Map()
+    const roseOf = (k) => {
+      let c = roses.get(k)
+      if (!c) { c = roseRamp(k); c = [c, lum(c)]; roses.set(k, c) }
+      return c
+    }
+    for (let vv = 0; vv < ch; vv++) {
+      const j = jb + vv
+      if (j < clip.j0 || j > clip.j1) continue
+      for (let uu = 0; uu < cw; uu++) {
+        const i = ib + uu
+        if (i < clip.i0 || i > clip.i1) continue
+        const n = buf.index(i, j)
+        if (n < 0) continue
+        const lv = (level ? level(uu, vv, i, j) : 1) * kAll
+        if (!(lv > 0)) continue
+        // the window under the cell
+        let L
+        let X
+        if (lean) {
+          // The live wallpaper: light at depth d is carried off·d, so the
+          // cell shows the nearest light that lands on it. Looking back
+          // along the offset from the cell, the first place whose own depth
+          // carries it here (d(s) = s, from the near end)
+          const u = i - at[0]
+          const v = j - at[1]
+          let s = 0
+          let gPrev = 0
+          for (let m = 0; m <= 6; m++) {
+            const sm = 1 - m / 6
+            const gm = depthOf(windowAt(g.satL, W, H, u - off[0] * sm, v - off[1] * sm)) - sm
+            if (gm >= 0) {
+              s = m === 0 ? 1 : sm + (1 / 6) * (gm / (gm - gPrev))
+              break
+            }
+            gPrev = gm
+          }
+          L = windowAt(g.satL, W, H, u - off[0] * s, v - off[1] * s)
+          X = windowAt(g.satX, W, H, u - off[0] * s, v - off[1] * s)
+        } else if (whole) {
+          L = g.Lc[vv * cw + uu]
+          X = g.Xc[vv * cw + uu]
+        } else {
+          L = windowAt(g.satL, W, H, i - at[0], j - at[1])
+          X = windowAt(g.satX, W, H, i - at[0], j - at[1])
+        }
+        const s = smooth(0.02, 0.45, L)
+        // its shape: the highlights the stars' need lights (a point; a
+        // cross when well over it), and on the cover the sun's cell a
+        // sparkle (the art's sun is the coda's own: squares of the warm
+        // white where the photograph's sun is, coda.js `passArt`)
+        // (none on the art: its sun is the coda's, and the rest of its
+        // highlights, the sky round the sun, went to a grain of points)
+        const need = use === 'art' ? Infinity : starNeed(i, j)
+        let sh = X > need ? ((X - need) / (0.1 + need) > 1 ? 2 : 1) : 0
+        if (sun && use === 'cover' && uu === sun[0] && vv === sun[1]) sh = 3
+        // eight steps of the print, on the light as the eye has it, with a
+        // little headroom so the top all over still dithers
+        const q = Math.min(8, Math.floor(7.5 * toEye(L) ** look.curve + hash(i, j)))
+        let c = steps[q]
+        let k = look.k
+        // (the roses held out keep a light of their own in the limbo, over
+        // the dark hand and the sky's windows; unless the caller paints the
+        // bouquet itself, `ownBouquet`, and the mask's ragged rim is the
+        // picture's)
+        if (look.bouquetK && !opts.ownBouquet && g.mask && g.mask[vv * cw + uu]) k = look.bouquetK
+        // a star's own light is a star's: the print's top, brighter the
+        // further over its highlight it is
+        if (sh) { c = steps[8]; k = look.star * (0.55 + 0.6 * X) }
+        let r = c[0] * k
+        let gg = c[1] * k
+        let b = c[2] * k
+        const rk = rose ? rose(uu, vv, i, j) : 0
+        if (rk > 0) {
+          const [rc, rl] = roseOf(Math.min(1, rk))
+          const m = (0.2126 * r + 0.7152 * gg + 0.0722 * b) / Math.max(1e-6, rl)
+          r = rc[0] * m
+          gg = rc[1] * m
+          b = rc[2] * m
+        }
+        const o = n * 4
+        rgba[o] = r * lv
+        rgba[o + 1] = gg * lv
+        rgba[o + 2] = b * lv
+        // the panel's own light through it: the art's sky a little (the
+        // rose put under it); the roses' sky,
+        // by how much of the cell is sky (its print is a red filter's, the
+        // sky dark in it and the skin pale, so its own light would make the
+        // hand the window: it is the sky that is). Every use lets the dark
+        // through where it is light (the first reel's passthrough): its
+        // light parts are windows
+        const win = use === 'limbo' ? (g.sky ? g.sky[vv * cw + uu] : 0) : s
+        const p = use === 'art' ? (sh ? 1 : look.pass * s) : use === 'limbo' ? look.pass * win : 0
+        rgba[o + 3] = (1 - 0.85 * win) * Math.min(1, lv)
+        shape[n] = sh
+        pass[n] = p * lv
+      }
+    }
+  }
+}
+
+// ── loading ─────────────────────────────────────────────────────────────────
+// Every use's grid from pixels already read: `{dance, roses, sea}`, each
+// `{data, width, height, channels}` (for a script, which reads its pixels
+// its own way)
+export function photosFrom(images) {
+  const grids = {}
+  for (const [use, U] of Object.entries(USES)) grids[use] = gridOf(images[U.name], use)
+  return new Photos(grids)
+}
+// a photograph's pixels, whole, as the page decodes it (a canvas drawn at
+// its own size: nothing resampled, so every browser reads the same pixels)
+async function pixelsOf(src, size) {
+  const img = new Image()
+  img.decoding = 'sync'
+  img.src = src
+  await img.decode()
+  const [w, h] = [img.naturalWidth || size[0], img.naturalHeight || size[1]]
+  const cv = document.createElement('canvas')
+  cv.width = w
+  cv.height = h
+  const g = cv.getContext('2d', { willReadFrequently: true })
+  g.drawImage(img, 0, 0)
+  return { data: g.getImageData(0, 0, w, h).data, width: w, height: h, channels: 4 }
+}
+// The three photographs decoded and every use's grid built, once
+let LOADING = null
+export function loadPhotos() {
+  if (!LOADING) {
+    LOADING = (async () => {
+      const images = {}
+      for (const [name, p] of Object.entries(PHOTOS)) images[name] = await pixelsOf(SRC[name], p.size)
+      return photosFrom(images)
+    })()
+  }
+  return LOADING
+}
+
+// ── the bench (reel3-CONTRACT.md 4.9) ───────────────────────────────────────
+// Frames 3000 to 3099, which no cut reaches: each use at level 1 with no
+// behaviour, a card a frame, for stills (`--stills 50000,50016.67,…`). The
+// flow is at rest there and the sky as at the first frame, so the sea, which
+// has only the panel's light, is as dim as it will ever be. Never called by
+// the film
+const CHALK = '#F4F1EA'
+const label = (titles, s, j = 8) => typeIn(titles, s, 11, j, lin(CHALK), { k: 0.9 })
+const CARDS = [
+  // 0: the cover at its place, and beside it three more at a quarter, a
+  // half and three quarters of a row on, as the scroll carries it
+  (buf, titles, ph) => {
+    label(titles, 'cover, 26 cells, 0 .25 .5 .75 of a row')
+    ;[0, 0.25, 0.5, 0.75].forEach((d, k) => {
+      const at = [16 + k * 32, 77 + d]
+      ph.paint(buf, 'cover', 0, { at, clip: [at[0], 70, at[0] + 25, 110] })
+    })
+  },
+  // 1: the art at its place
+  (buf, titles, ph) => { label(titles, 'art, 125 cells'); ph.paint(buf, 'art', 0) },
+  // 2: the art at the wallpaper's kick, a cell and a half across
+  (buf, titles, ph) => { label(titles, 'art, offset 1.48 .74'); ph.paint(buf, 'art', 0, { offset: [1.476, 0.738] }) },
+  // 3: the roses, the bouquet's edge marked
+  (buf, titles, ph) => {
+    label(titles, 'limbo, bouquet marked')
+    ph.paint(buf, 'limbo', 0)
+    const m = ph.mask('limbo')
+    const cw = USES.limbo.cw
+    const at = (u, v) => u >= 0 && v >= 0 && u < cw && m[v * cw + u]
+    for (let v = 0; v < USES.limbo.ch; v++) {
+      for (let u = 0; u < cw; u++) {
+        if (at(u, v) && !(at(u - 1, v) && at(u + 1, v) && at(u, v - 1) && at(u, v + 1))) buf.set(u, v, lin('#A28CE0'), 0.6, 1)
+      }
+    }
+  },
+  // 4: the roses as nine leaves them: the rest gone, the bouquet held at
+  // its floor and turned
+  (buf, titles, ph) => {
+    label(titles, 'limbo, bouquet at .15, rose')
+    const m = ph.mask('limbo')
+    const cw = USES.limbo.cw
+    ph.paint(buf, 'limbo', 0, { level: (u, v) => (m[v * cw + u] ? 0.15 : 0), rose: (u, v) => (m[v * cw + u] ? 1 : 0) })
+  },
+  // 5: the roses whole, the bouquet turned
+  (buf, titles, ph) => {
+    label(titles, 'limbo, bouquet rose')
+    const m = ph.mask('limbo')
+    const cw = USES.limbo.cw
+    ph.paint(buf, 'limbo', 0, { rose: (u, v) => (m[v * cw + u] ? 1 : 0) })
+  },
+  // 6: (was the sea)
+  () => {},
+  // 7: the cover and the art side by side with their suns marked
+  (buf, titles, ph) => {
+    label(titles, 'suns')
+    ph.paint(buf, 'art', 0)
+    const [su, sv] = ph.sun('art')
+    const [ai, aj] = USES.art.at
+    outlineIn(buf, [ai + su - 4, aj + sv - 4, ai + su + 4, aj + sv + 4], lin('#A28CE0'), { k: 0.6, corners: false })
+    label(titles, `sun ${ai + su} ${aj + sv}`, 220)
+  },
+]
+export function debug(k, buf, titles, photo) {
+  const card = CARDS[Math.round(k)]
+  if (card && photo) card(buf, titles, photo)
+}
