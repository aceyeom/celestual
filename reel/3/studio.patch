+  }
+}
+
+// ── the status row ──────────────────────────────────────────────────────────
+// A phone's top line: the time, and the battery at the right edge of the
+// words' column (looks.js PIX `bata0`…`bata4`, the battery as the phone drew
+// it, its cells draining from the nub's end), both in the line's colour. A
+// battery of null is a row with none (the 1:41 sheet: its note carries the
+// charge, Ping.jsx 1150-1153)
+export function status(buf, f, key, { bat = 4, k = 1 } = {}) {
+  if (!(k > 0)) return null
+  const x = TEXT[key]
+  const a = clamp(k)
+  const at = say(buf, key, f, { k: x.k * k, a })
+  if (bat != null) battery(buf, bat, LAYOUT.chat.bat.right, LAYOUT.chat.bat.j, lin(hexOf(x.col)), x.k * k, a, 'right')
