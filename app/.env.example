# CELESTUAL — frontend environment (Vite). Copy to .env.local for local dev, and
# set the same two vars in Vercel → Project → Settings → Environment Variables.
#
# CELESTUAL's Supabase project uses the `celestual_*` tables.
# Find these in Supabase → Project Settings → Data API / API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── Feature flags (all OFF by default → dev-friendly, nothing gated/broken) ──
# Each flag turns a scaffolded integration from its safe local fallback into the
# real, server-backed behavior. Set to 1 only once the matching backend is live.

# Instagram DM handle verification (NO Facebook OAuth). When 1, people prove the @
# they type is really theirs by DMing a one-time code to your Instagram account —
# verified by Meta's official Messaging webhook. Requires migration 0004 + the
# celestual-ig-webhook edge function (see docs/DEBUG-IG-WEBHOOK.md). When 0, the
# app uses a local stub so the flow stays testable. /demo runs the same overlay
# but auto-verifies locally (its stand-in until real verification is wired there).
VITE_IG_VERIFY_ENABLED=0

# Your Instagram username (no @) — the account people DM the code to. ig.me/m/<this>
# deep-links straight into a DM thread with it.
VITE_IG_USERNAME=celestual.us

# Instagram @ search typeahead: requires the celestual-search edge function + a
# provider source. When 0, manual entry + validation only (no suggestions).
VITE_HANDLE_SEARCH=0

# Instagram handle RESOLVER (a different thing from the typeahead above, and
# they are independent). With this at 1, every field in the product where an @
# is typed shows that account's display name, its badge and its picture under
# the line, so a person confirms against a face instead of against their own
# spelling. It never blocks: an account we cannot find is still placeable, and
# the app says so once and lets it through. Requires migrations 0030 and 0031,
# the celestual-resolve edge function deployed with APIFY_TOKEN set, the public
# `avatars` Storage bucket, and the /api/resolve rewrite in vercel.json (see
# docs/HANDLE-RESOLVER.md). At 0 nothing renders and every flow is untouched.
VITE_HANDLE_RESOLVE=0

# Where the resolver lives, as the browser sees it. Leave this unset in
# production: the default /api/resolve is the Vercel rewrite, which is what
# makes the resolver's device cookie first party rather than a cookie on
# *.supabase.co that Safari and Chrome drop. Set it to the full function URL
# only on a preview deployment that is not behind the rewrite, and accept that
# the device cap will fall through to the IP cap there.
# VITE_RESOLVE_ENDPOINT=

# School (.edu) email verification for community membership. When 1, joining a
# curated school requires proving you're there: a 6-digit code is emailed to an
# address at that school's domain and entered back to confirm. Requires migration
# 0007 + the celestual-edu-verify edge function + a Resend sender (see
# docs/EDU-VERIFICATION.md). When 0 (or without Supabase configured), the join
# sheet uses a local stub that auto-confirms, so the flow stays testable in dev.
# /demo always uses the stub regardless of this flag.
VITE_EDU_VERIFY_ENABLED=0

# ── monetization (OFF by default, and dormant until deliberately woken) ──────
# The core product is free forever: placing, matching, the reveal, renewing,
# letting one go, the opt-out, erasure, verification, communities. The limit is
# the slot rule (two standing pings free; retiring frees the slot) and the
# sixty-day lapse, both enforced server-side in celestual_submit (migrations
# 0006 → 0021).
#
# With this at 0 (the default) Screen 9 shows ONE door, "let one go", and
# nothing in production mentions money. At 1 a second door appears under it: one
# more standing ping for $2.99, once. It needs migration 0021 + the
# celestual-stripe and celestual-stripe-webhook functions live, with their
# secrets set. Full runbook: docs/STRIPE-SETUP.md. Prices live in
# app/src/i18n/strings.js (paywall.price / paywall.subPrice) and must match the
# Stripe prices exactly.
VITE_STRIPE_ENABLED=0

# The monthly plan ($12.99: ten standing pings, each held six months) is a
# SEPARATE decision from the one-time slot, so it has its own flag. At 0 the
# paid door offers the one-time slot only, even with Stripe on. Needs
# STRIPE_PRICE_STEADY set on the function side too.
VITE_STRIPE_PLAN=0
