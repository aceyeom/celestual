{
  "name": "celestual",
  "private": true,
  "version": "1.0.0",
  "description": "CELESTUAL — the double-blind mutual-reveal site. Place a ping; you both find out only if it's mutual. A Vite + React SPA on Supabase.",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app install && npm --prefix app run build",
    "lint": "npm --prefix app run lint",
    "lint:voice": "node scripts/voice-lint.mjs",
    "check:moderation": "node --no-warnings scripts/check-moderation.mjs",
    "shots": "node scripts/shots.mjs",
    "mark": "node scripts/export-mark.mjs",
    "faces": "node scripts/fetch-faces.mjs",
    "screens": "node scripts/screens.mjs",
    "shots:composer": "node scripts/shots-composer.mjs"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "playwright": "^1.62.1"
  }
}
